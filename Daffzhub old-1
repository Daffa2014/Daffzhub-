local function SBFetchScriptblox(query)
    ok, result = pcall(function()
        url = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query) .. "&page=1"
        local response = game:HttpGet(url)
        return HttpService:JSONDecode(response)
    end)
    if not ok or not result or not result.result then return {} end
    local scripts = result.result.scripts or {}
    local out = {}
    for _, s in ipairs(scripts) do
        table.insert(out, {
            id = "sb_" .. (s._id or tostring(math.random(99999))),
            source = "sb",
            title = s.title or "Untitled",
            game = s.game and s.game.name or "Universal",
            views = s.views or 0,
            likes = s.likeCount or 0,
            verified = s.verified or false,
            key = s.isUniversal == false or false,
            patched = s.isPatched or false,
            script = s.script or "",
            rawUrl = s.slug and ("https://scriptblox.com/raw/" .. s.slug) or ""
        })
    end
    return out
end

local function SBFetchRawScripts(query)
    local ok, result = pcall(function()
        local url = "https://rawscripts.net/api/scripts?search=" .. HttpService:UrlEncode(query)
        local response = game:HttpGet(url)
        return HttpService:JSONDecode(response)
    end)
    if not ok or not result then return {} end
    local scripts = type(result) == "table" and result or {}
    local out = {}
    for _, s in ipairs(scripts) do
        table.insert(out, {
            id = "rs_" .. (s.id or tostring(math.random(99999))),
            source = "rs",
            title = s.title or "Untitled",
            game = s.game or "Universal",
            views = s.views or 0,
            likes = s.likes or 0,
            verified = false,
            key = s.key or false,
            patched = false,
            script = s.script or s.url or "",
            rawUrl = s.url or ""
        })
    end
    return out
end

