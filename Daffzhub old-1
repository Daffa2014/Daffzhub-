    for _, child in ipairs(ScriptList:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    files = {}
    if isfolder(SCRIPTS_FOLDER) then
        for _, file in ipairs(listfiles(SCRIPTS_FOLDER)) do
            if file:match("%.txt$") then
                name = file:gsub(SCRIPTS_FOLDER .. "/", ""):gsub("%.txt$", "")
                table.insert(files, name)
