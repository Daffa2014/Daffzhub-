local function disableFreecam()
    if not freecamEnabled then return end
    CurrentSens = savedSensitivity
    freecamEnabled = false
    if fcPanel and fcPanel.Parent then fcPanel:Destroy() end
    fcPanel = nil

    local cam = workspace.CurrentCamera
    cam.CameraType = originalCameraType or Enum.CameraType.Custom
    cam.CameraSubject = originalCameraSubject or (Player.Character and Player.Character:FindFirstChildOfClass("Humanoid"))

    fcEnableMovement()

    if freecamConnection then freecamConnection:Disconnect() freecamConnection = nil end
    for _, c in pairs(fcMovementConnections) do c:Disconnect() end
    fcMovementConnections = {}

    if isMobile then
        local touchGui = Player.PlayerGui:FindFirstChild("TouchGui")
        if touchGui then
            local frame = touchGui:FindFirstChild("TouchControlFrame")
            if frame then
                local thumb = frame:FindFirstChild("DynamicThumbstickFrame")
                if thumb then thumb.Visible = true end
            end
            -- Kembalikan jump button dengan setting yang tersimpan
            local jumpButton = touchGui:FindFirstChild("JumpButton", true)
            if jumpButton then
                jumpButton.Visible = true
                local jumpSize = getJumpAttr("JumpSize", 75)
                local posX = getJumpAttr("JumpPosX", 28)
                local posY = getJumpAttr("JumpPosY", 22)
                local scale = jumpSize / 100
                jumpButton.Size = UDim2.new(0, 100 * scale, 0, 100 * scale)
                jumpButton.Position = UDim2.new(1, -120 + posX, 1, -120 + posY)
            end
        end
        if fcDpadLeft then fcDpadLeft:Destroy() fcDpadLeft = nil end
        if fcDpadLeft then fcDpadLeft:Destroy() fcDpadLeft = nil end
        fcDpadPressLeft = {up=false,down=false,left=false,right=false}
        if fcDpadRight then fcDpadRight:Destroy() fcDpadRight = nil end
        fcDpadPressRight = {up=false,down=false}
        fcDpadPressLeft = {up=false,down=false,left=false,right=false}
    else
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        fcKeys = {W=false,A=false,S=false,D=false}
    end

    fcMoveVector = Vector3.new(0,0,0)
    fcCurrentVelocity = Vector3.new(0,0,0)
    fcLookVector = Vector2.new(0,0)
    fcZoomLevel = 0
    fcRollAngle = 0

    FreecamBtn.Text = "Freecam | OFF"
    FreecamBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
end

