local function fcUpdateFreecam()
    local inputMove = Vector3.new(0,0,0)

    if isMobile then
        if fcDpadPressLeft.up then inputMove = inputMove + Vector3.new(0,0,-1) end
        if fcDpadPressLeft.down then inputMove = inputMove + Vector3.new(0,0,1) end
        if fcDpadPressLeft.left then inputMove = inputMove + Vector3.new(-1,0,0) end
        if fcDpadPressLeft.right then inputMove = inputMove + Vector3.new(1,0,0) end
        if fcDpadPressRight and fcDpadPressRight.up then inputMove = inputMove + Vector3.new(0,1,0) end
        if fcDpadPressRight and fcDpadPressRight.down then inputMove = inputMove + Vector3.new(0,-1,0) end
    else
        if fcKeys.W then inputMove = inputMove + Vector3.new(0,0,-1) end
        if fcKeys.S then inputMove = inputMove + Vector3.new(0,0,1) end
        if fcKeys.A then inputMove = inputMove + Vector3.new(-1,0,0) end
        if fcKeys.D then inputMove = inputMove + Vector3.new(1,0,0) end
    end

    local targetVelocity = Vector3.new(0,0,0)
    if inputMove.Magnitude > 0 then
        targetVelocity = inputMove.Unit * fcSpeed
    end

    if not isMobile then
        if UIS:IsKeyDown(Enum.KeyCode.E) then targetVelocity = targetVelocity + Vector3.new(0, fcSpeed, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) then targetVelocity = targetVelocity + Vector3.new(0, -fcSpeed, 0) end
    end

    -- Reset velocity kalau arah berlawanan
    if targetVelocity.Magnitude > 0 and fcCurrentVelocity.Magnitude > 0 then
        if fcCurrentVelocity:Dot(targetVelocity) < 0 then
            fcCurrentVelocity = Vector3.new(0,0,0)
        end
    end
    fcCurrentVelocity = fcCurrentVelocity:Lerp(targetVelocity, inputMove.Magnitude > 0 and 0.8 or fcDampingFactor)

    local cam = workspace.CurrentCamera
    local yaw = CFrame.Angles(0, math.rad(-fcLookVector.X), 0)
    local pitch = CFrame.Angles(math.rad(-fcLookVector.Y), 0, 0)
    local roll = CFrame.Angles(0, 0, math.rad(fcRollAngle))
    local rot = yaw * pitch * roll

    local pos = cam.CFrame.Position
    -- Gerak pakai yaw saja (horizontal), tidak ikut pitch
    local moveRot = CFrame.new(pos) * yaw

    local newPos = pos
    if fcCurrentVelocity.Magnitude > 0.01 then
        local dt = RunService.Heartbeat:Wait()
        newPos = pos + moveRot:VectorToWorldSpace(fcCurrentVelocity * dt)
    end

    local zoomOffset = rot.LookVector * fcZoomLevel
    cam.CFrame = cam.CFrame:Lerp(CFrame.new(newPos + zoomOffset) * rot, 0.3)
end

