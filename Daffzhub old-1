            CurrentSound:Stop()
            CurrentSound:Destroy()
        end
        CurrentSound = Instance.new("Sound")
        CurrentSound.SoundId = "rbxassetid://" .. id
        CurrentSound.Volume = currentVolume / 5
        CurrentSound.Looped = true
        CurrentSound.Parent = workspace
        CurrentSound:Play()
    end
end)

