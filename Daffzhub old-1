-- FORCE PART FUNCTION
local function ForcePart(v)
    if forcedParts[v] then return end
    
    if Player.Character and v:IsDescendantOf(Player.Character) then
        return
    end
    
    if v:IsA("BasePart") and not v.Anchored and 
       not v.Parent:FindFirstChildOfClass("Humanoid") and 
       not v.Parent:FindFirstChild("Head") and 
       v.Name ~= "Handle" and 
       not v.Parent:IsA("Tool") then
        
        for _, x in ipairs(v:GetChildren()) do
            if x:IsA("BodyMover") or x:IsA("RocketPropulsion") then
                x:Destroy()
            end
        end
        
        v.CanCollide = false
        local Torque = Instance.new("Torque", v)
        Torque.Torque = Vector3.new(100000, 100000, 100000)
        local AlignPosition = Instance.new("AlignPosition", v)
        local Attachment2 = Instance.new("Attachment", v)
        Torque.Attachment0 = Attachment2
        AlignPosition.MaxForce = math.huge
        AlignPosition.MaxVelocity = math.huge
        AlignPosition.Responsiveness = 200
        AlignPosition.Attachment0 = Attachment2
        AlignPosition.Attachment1 = Attachment1
        
        forcedParts[v] = true
    end
end

-- TOGGLE BRING PARTS
local function ToggleBringParts()
    blackHoleActive = not blackHoleActive
    BringBtn.BackgroundColor3 = blackHoleActive and Color3.fromRGB(30,180,30) or Color3.fromRGB(180,30,30)
    BringBtn.Text = "Bring Parts " .. (blackHoleActive and "ON" or "OFF")

    if blackHoleActive then
        for _, v in ipairs(workspace:GetDescendants()) do
            ForcePart(v)
        end
        
        DescendantAddedConnection = workspace.DescendantAdded:Connect(ForcePart)
        
        RenderConnection = RunService.RenderStepped:Connect(function()
            if not blackHoleActive then return end
            if targetPart and targetPart.Parent then
                Attachment1.WorldCFrame = targetPart.CFrame
            end
            for _, v in ipairs(workspace:GetDescendants()) do
                ForcePart(v)
            end
        end)
    else
        if DescendantAddedConnection then
            DescendantAddedConnection:Disconnect()
            DescendantAddedConnection = nil
        end
        if RenderConnection then
            RenderConnection:Disconnect()
            RenderConnection = nil
        end
        forcedParts = {}
    end
end

