        local rotationConnection = nil
        
        local function rotateCamera(direction)
            if not isViewingWaypoint then return end
            
            if rotationConnection then
                rotationConnection:Disconnect()
            end
            
            rotationConnection = RunService.RenderStepped:Connect(function()
                if not isViewingWaypoint then
                    if rotationConnection then
                        rotationConnection:Disconnect()
                        rotationConnection = nil
                    end
                    return
                end
                
                local rotationSpeed = 0.05
                
                if direction == "up" then
                    currentWaypointRotation = currentWaypointRotation * CFrame.Angles(-rotationSpeed, 0, 0)
                elseif direction == "down" then
                    currentWaypointRotation = currentWaypointRotation * CFrame.Angles(rotationSpeed, 0, 0)
                elseif direction == "left" then
                    currentWaypointRotation = currentWaypointRotation * CFrame.Angles(0, rotationSpeed, 0)
                elseif direction == "right" then
                    currentWaypointRotation = currentWaypointRotation * CFrame.Angles(0, -rotationSpeed, 0)
                end
                
                Camera.CFrame = currentWaypointRotation
            end)
        end
        
        local function stopRotation()
            if rotationConnection then
                rotationConnection:Disconnect()
                rotationConnection = nil
            end
        end
        
        -- Connect arrow buttons
        UpBtn.MouseButton1Down:Connect(function() rotateCamera("up") end)
        UpBtn.MouseButton1Up:Connect(stopRotation)
        UpBtn.MouseLeave:Connect(stopRotation)
        
        DownBtn.MouseButton1Down:Connect(function() rotateCamera("down") end)
        DownBtn.MouseButton1Up:Connect(stopRotation)
        DownBtn.MouseLeave:Connect(stopRotation)
        
        LeftBtn.MouseButton1Down:Connect(function() rotateCamera("left") end)
        LeftBtn.MouseButton1Up:Connect(stopRotation)
        LeftBtn.MouseLeave:Connect(stopRotation)
        
        RightBtn.MouseButton1Down:Connect(function() rotateCamera("right") end)
        RightBtn.MouseButton1Up:Connect(stopRotation)
        RightBtn.MouseLeave:Connect(stopRotation)
        
