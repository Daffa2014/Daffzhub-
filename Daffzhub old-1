local function stopCamMode()
    if camLockConnection then
        camLockConnection:Disconnect()
        camLockConnection = nil
    end
    camLocked = false
    -- Kembalikan humanoid offset
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.CameraOffset = Vector3.new(0,0,0) end
end

local function setCamMode(mode)
    stopCamMode()
    camMode = mode
    local cam = workspace.CurrentCamera
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if mode == "fps" then
        cam.CameraType = Enum.CameraType.Custom
        camLocked = true
        camLockConnection = RunService.RenderStepped:Connect(function()
            local c = Player.Character
            if not c then return end
            local head = c:FindFirstChild("Head")
            if not head then return end
            
            -- Ambil arah kamera dari Roblox (biar bisa diarahin bebas)
            local camDir = cam.CFrame - cam.CFrame.Position
            -- Override posisi ke mata, tapi arah tetap dari Roblox
            local eyePos = head.CFrame:PointToWorldSpace(Vector3.new(0, 0.1, -0.5))
            cam.CFrame = CFrame.new(eyePos) * camDir
            
            -- Sembunyikan kepala
            pcall(function()
                for _, part in pairs(c:GetDescendants()) do
                    if part.Name == "Head" and part:IsA("BasePart") then
                        part.LocalTransparencyModifier = 1
                    end
                end
            end)
        end)

    elseif mode == "tpback" then
        cam.CameraType = Enum.CameraType.Scriptable
        camLocked = true
        local zoomDist = 6
        camLockConnection = RunService.RenderStepped:Connect(function()
            local c = Player.Character
            if not c then return end
            local r = c:FindFirstChild("HumanoidRootPart")
            if not r then return end
            local targetPos = r.Position + Vector3.new(0, 2, 0)
            local camPos = r.CFrame * CFrame.new(0, 2, zoomDist)
            cam.CFrame = CFrame.new(camPos.Position, targetPos)
        end)

    elseif mode == "tpfront" then
        cam.CameraType = Enum.CameraType.Scriptable
        camLocked = true
        local zoomDist = 6
        camLockConnection = RunService.RenderStepped:Connect(function()
            local c = Player.Character
            if not c then return end
            local r = c:FindFirstChild("HumanoidRootPart")
            if not r then return end
            local targetPos = r.Position + Vector3.new(0, 2, 0)
            local camPos = r.CFrame * CFrame.new(0, 2, -zoomDist)
            cam.CFrame = CFrame.new(camPos.Position, targetPos)
        end)

    elseif mode == "tpfree" then
        -- Kamera bebas putar, zoom bebas
        cam.CameraType = Enum.CameraType.Custom
        if hum then hum.CameraOffset = Vector3.new(0, 0, 0) end

    elseif mode == "lock" then
        -- Lock di posisi & arah kamera sekarang
        cam.CameraType = Enum.CameraType.Scriptable
        local lockedCF = cam.CFrame
        camLocked = true
        camLockConnection = RunService.RenderStepped:Connect(function()
            cam.CFrame = lockedCF
        end)

    elseif mode == "default" then
        cam.CameraType = Enum.CameraType.Custom
        if hum then hum.CameraOffset = Vector3.new(0, 0, 0) end
        -- Kembalikan kepala visible
        local c = Player.Character
        if c then
            local head = c:FindFirstChild("Head")
            if head then
                pcall(function() head.LocalTransparencyModifier = 0 end)
            end
        end
    end
end

