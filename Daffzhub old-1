local function getNextWaypointNumber()
    local maxNum = 0
    for name, _ in pairs(WaypointsData) do
        local num = tonumber(name:match("Waypoint (%d+)"))
        if num and num > maxNum then
            maxNum = num
        end
    end
    return maxNum + 1
end

