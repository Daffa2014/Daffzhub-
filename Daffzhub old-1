    local val = tonumber(VolumeValue.Text:gsub("%%", ""))
    if val then
        currentVolume = math.clamp(math.floor(val / 10), 1, 20)
        VolumeValue.Text = tostring(currentVolume * 10) .. "%"
        if CurrentSound and CurrentSound.IsPlaying then
            CurrentSound.Volume = currentVolume / 10
        end
    else
        VolumeValue.Text = tostring(currentVolume * 10) .. "%"
    end
end)

