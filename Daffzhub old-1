        ResetFOVBtn.MouseButton1Click:Connect(function()
            currentZoom = 70
            Camera.FieldOfView = currentZoom
            Camera.CFrame = cframe
            currentWaypointRotation = cframe
            local local_percent = (currentZoom - 30) / 70
            ZoomSliderFill.Size = UDim2.new(local_percent, 0, 1, 0)
            ZoomLabel.Text = "Zoom: 70"
        end)
        
        -- EXIT BUTTON (CLEANUP SEMUA CONNECTIONS)
        ExitBtn.MouseButton1Click:Connect(function()
            Camera.CameraType = OriginalCameraType or Enum.CameraType.Custom
            Camera.CameraSubject = OriginalCameraSubject
            isViewingWaypoint = false
            
            -- Disconnect semua connections
            if cameraConnection then
                cameraConnection:Disconnect()
                cameraConnection = nil
            end
            if sliderConnection then
                sliderConnection:Disconnect()
                sliderConnection = nil
            end
            if rotationConnection then
                rotationConnection:Disconnect()
                rotationConnection = nil
            end
            
            if ControlPanel then
                ControlPanel:Destroy()
                ControlPanel = nil
            end
        end)
        
        -- Camera movement dengan WASD + Mouse Right Click
        cameraConnection = RunService.RenderStepped:Connect(function()
            if not isViewingWaypoint then 
                cameraConnection:Disconnect()
                return 
            end
            
            -- Right click to rotate dengan GetMouseDelta
            if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                delta = UIS:GetMouseDelta()
                rotationX = -delta.Y * 0.003
                rotationY = -delta.X * 0.003
                
                currentWaypointRotation = currentWaypointRotation * CFrame.Angles(rotationX, rotationY, 0)
                Camera.CFrame = currentWaypointRotation
            end
            
            -- WASD movement
            moveVector = Vector3.new(0, 0, 0)
            moveSpeed = 0.5
            
            if UIS:IsKeyDown(Enum.KeyCode.W) then
                moveVector = moveVector + (Camera.CFrame.LookVector * moveSpeed)
            end
            if UIS:IsKeyDown(Enum.KeyCode.S) then
                moveVector = moveVector - (Camera.CFrame.LookVector * moveSpeed)
            end
            if UIS:IsKeyDown(Enum.KeyCode.A) then
                moveVector = moveVector - (Camera.CFrame.RightVector * moveSpeed)
            end
            if UIS:IsKeyDown(Enum.KeyCode.D) then
                moveVector = moveVector + (Camera.CFrame.RightVector * moveSpeed)
            end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then
                moveVector = moveVector + Vector3.new(0, moveSpeed, 0)
            end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
                moveVector = moveVector - Vector3.new(0, moveSpeed, 0)
            end
            
            if moveVector.Magnitude > 0 then
                currentWaypointRotation = currentWaypointRotation + moveVector
                Camera.CFrame = currentWaypointRotation
            end
        end)
        
        -- ESC key untuk exit
        escConnection = UIS.InputBegan:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.Escape and isViewingWaypoint then
                Camera.CameraType = OriginalCameraType or Enum.CameraType.Custom
                Camera.CameraSubject = OriginalCameraSubject
                isViewingWaypoint = false
                
                -- Cleanup semua connections
                if cameraConnection then
                    cameraConnection:Disconnect()
                    cameraConnection = nil
                end
                if sliderConnection then
                    sliderConnection:Disconnect()
                    sliderConnection = nil
                end
                if rotationConnection then
                    rotationConnection:Disconnect()
                    rotationConnection = nil
                end
                if escConnection then
                    escConnection:Disconnect()
                end
                
                if ControlPanel then
                    ControlPanel:Destroy()
                    ControlPanel = nil
                end
            end
        end)
        
    else
        -- Exit view jika sudah aktif
        Camera.CameraType = OriginalCameraType or Enum.CameraType.Custom
        Camera.CameraSubject = OriginalCameraSubject
        isViewingWaypoint = false
        
        if cameraConnection then
            cameraConnection:Disconnect()
            cameraConnection = nil
        end
        
        if ControlPanel then
            ControlPanel:Destroy()
            ControlPanel = nil
        end
    end
end

