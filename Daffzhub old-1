    if errorPopupThread then return end

    errorPopupThread = task.spawn(function()
        while loadingHalted do
            ShowConfirmPopup(
                "DaffzHub encountered an error!\nDelete GUI now?",
                Color3.fromRGB(200, 40, 40),
                function()
                    ScreenGui:Destroy()
                end
            )
            task.wait(3)
        end
        errorPopupThread = nil
    end)
end

