StopBtn.MouseButton1Click:Connect(function()
    if CurrentSound then
        CurrentSound:Stop()
    end
end)

-- Save button
SaveMusicBtn.MouseButton1Click:Connect(function()
    local id = MusicBox.Text:gsub("%s", "")
    if id ~= "" and tonumber(id) then
        local exists = false
        for _, v in ipairs(savedMusic) do
            local existingId = type(v) == "table" and v.id or tostring(v)
            if existingId == id then
                exists = true
                break
            end
        end

        if not exists then
            table.insert(savedMusic, {name = "Music " .. (#savedMusic + 1), id = id})
            saveMusic()
            updateMusicList(MusicSearch.Text)
            MusicBox.Text = ""
        end
    end
end)

