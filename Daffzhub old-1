-- Fungsi untuk mengubah semua ProximityPrompt
local function setPromptInstant(state)
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and not processedPrompts[obj] then
                originalHoldDurations[obj] = obj.HoldDuration
                processedPrompts[obj] = true
                obj.HoldDuration = 0.001
            end
        end
    else
        isRestoring = true
        for obj, duration in pairs(originalHoldDurations) do
            if obj and obj.Parent then
                obj.HoldDuration = duration
                -- Paksa reset state visual prompt (fix bug bar visual gak sinkron)
                local wasEnabled = obj.Enabled
                obj.Enabled = false
                task.defer(function()
                    if obj and obj.Parent then
                        obj.Enabled = wasEnabled
                    end
                end)
            end
        end
        originalHoldDurations = {}
        processedPrompts = {}
        isRestoring = false
    end
end

