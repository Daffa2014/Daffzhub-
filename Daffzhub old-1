-- FUNGSI GET TARGET BLOCK
local function GetTargetBlock()
    local ray = Camera:ScreenPointToRay(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {Player.Character}
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    
    if result and result.Instance:IsA("BasePart") and not result.Instance.Anchored then
        return result.Instance
    end
    return nil
end

-- FUNGSI RELEASE BLOCK
local function ReleaseBlock()
    if mBodyVelocity then
        mBodyVelocity:Destroy()
        mBodyVelocity = nil
    end
    if mBodyGyro then
        mBodyGyro:Destroy()
        mBodyGyro = nil
    end
    heldBlock = nil
    MagnetStatus.Text = "Status: Idle"
end

-- FUNGSI TOGGLE MAGNET
local function ToggleMagnet()
    magnetEnabled = not magnetEnabled
    
    if magnetEnabled then
        MagnetBtn.Text = "Move | ON"
        MagnetBtn.BackgroundColor3 = Color3.fromRGB(30,180,30)
        MagnetStatus.Text = "Status: Looking for block..."
        
        magnetConnection = RunService.RenderStepped:Connect(function()
            if not magnetEnabled then
                if magnetConnection then
                    magnetConnection:Disconnect()
                    magnetConnection = nil
                end
                return
            end
            
            if not heldBlock then
                local block = GetTargetBlock()
                if block then
                    heldBlock = block
                    
                    pcall(function()
                        if heldBlock:CanSetNetworkOwnership() then
                            heldBlock:SetNetworkOwner(Player)
                        end
                    end)
                    
                    mBodyVelocity = Instance.new("BodyVelocity")
                    mBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    mBodyVelocity.Velocity = Vector3.new(0,0,0)
                    mBodyVelocity.P = 10000
                    mBodyVelocity.Parent = heldBlock
                    
                    mBodyGyro = Instance.new("BodyGyro")
                    mBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    mBodyGyro.D = 2500
                    mBodyGyro.P = 50000
                    mBodyGyro.CFrame = heldBlock.CFrame
                    mBodyGyro.Parent = heldBlock
                    
                    MagnetStatus.Text = "Status: Holding block"
                end
            end
            
            if heldBlock and heldBlock.Parent and mBodyVelocity then
                pcall(function()
                    if heldBlock:CanSetNetworkOwnership() then
                        heldBlock:SetNetworkOwner(Player)
                    end
                end)
                
                local targetPos = Camera.CFrame.Position + (Camera.CFrame.LookVector * holdDistance)
                local direction = (targetPos - heldBlock.Position)
                local speed = math.clamp(direction.Magnitude * 5, 0, 200)
                mBodyVelocity.Velocity = direction.Unit * speed
                
            elseif heldBlock and (not heldBlock.Parent or heldBlock.Anchored) then
                ReleaseBlock()
                MagnetStatus.Text = "Status: Block lost"
            end
        end)
    else
        MagnetBtn.Text = "Move | OFF"
        MagnetBtn.BackgroundColor3 = Color3.fromRGB(180,30,30)
        ReleaseBlock()
        MagnetStatus.Text = "Status: Idle"
        
        if magnetConnection then
            magnetConnection:Disconnect()
            magnetConnection = nil
        end
    end
end

-- FUNGSI FREEZE BLOCK
local function FreezeBlock()
    if heldBlock and heldBlock.Parent and mBodyVelocity then
        local currentPos = heldBlock.Position
        local currentCF = heldBlock.CFrame
        
        if mBodyVelocity then
            mBodyVelocity:Destroy()
            mBodyVelocity = nil
        end
        if mBodyGyro then
            mBodyGyro:Destroy()
            mBodyGyro = nil
        end
        
        local freezePos = Instance.new("BodyPosition")
        freezePos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        freezePos.D = 5000
        freezePos.P = 100000
        freezePos.Position = currentPos
        freezePos.Parent = heldBlock
        
        local freezeGyro = Instance.new("BodyGyro")
        freezeGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        freezeGyro.D = 2500
        freezeGyro.P = 50000
        freezeGyro.CFrame = currentCF
        freezeGyro.Parent = heldBlock
        
        heldBlock = nil
        
        magnetEnabled = false
        MagnetBtn.Text = "Move | OFF"
        MagnetBtn.BackgroundColor3 = Color3.fromRGB(180,30,30)
        MagnetStatus.Text = "Status: Frozen"
        
        if magnetConnection then
            magnetConnection:Disconnect()
            magnetConnection = nil
        end
    end
end

