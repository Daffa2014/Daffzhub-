local SB_SAVED_FILE = "Daffzhub_file/search_saved.json"
local SBSavedScripts = {}

local function SBLoadSaved()
    if isfile(SB_SAVED_FILE) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(SB_SAVED_FILE))
        end)
        if ok and data then
            -- Auto-update script dari rawUrl
            task.spawn(function()
                for _, s in ipairs(data) do
                    if s.rawUrl and s.rawUrl ~= "" then
                        local fetchOk, newScript = pcall(function()
                            return game:HttpGet(s.rawUrl)
                        end)
                        if fetchOk and newScript and #newScript > 10 then
                            s.script = newScript
                        end
                    end
                end
                SBSavedScripts = data
                SBSaveSaved()
            end)
        end
        if ok and type(data) == "table" then
            SBSavedScripts = data
        end
    end
end


local function SBIsSaved(id)
    for _, s in ipairs(SBSavedScripts) do
        if s.id == id then return true end
    end
    return false
end

local function SBToggleSave(scriptData)
    if SBIsSaved(scriptData.id) then
        for i, s in ipairs(SBSavedScripts) do
            if s.id == scriptData.id then
                table.remove(SBSavedScripts, i)
                break
            end
        end
    else
        table.insert(SBSavedScripts, 1, scriptData)
    end
    SBSaveSaved()
end

