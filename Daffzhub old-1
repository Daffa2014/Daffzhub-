        if isDaffzHubError and not loadingHalted then
            loadingHalted = true
            ShowErrorIndicator()
        end
    end
end)

-- Fungsi cek sebelum lanjut checkpoint loading
function CheckLoadingHalt()
    if loadingHalted then
        -- Loading berhenti di sini, tidak lanjut ke checkpoint berikutnya
        while loadingHalted do
            task.wait(0.5)
        end
    end
end

CurrentLoadPct = 0

-- Warna gradasi: 1-20% Merah, 21-70% Kuning, 71-100% Hijau (transisi mulus)
local function GetLoadColor(pct)
    local red = Color3.fromRGB(200, 45, 45)
    local yellow = Color3.fromRGB(230, 190, 30)
    local green = Color3.fromRGB(25, 190, 90)

    if pct <= 20 then
        return red:Lerp(yellow, pct / 20)
    elseif pct <= 70 then
        return yellow:Lerp(green, (pct - 20) / 50)
    else
        return green
    end
end

function SetLoadProgress(pct)
    pct = math.clamp(pct, 0, 100)
    LoadFill.Visible = true
    LoadFill.BackgroundTransparency = 0

    for i = CurrentLoadPct + 1, pct do
        CurrentLoadPct = i
        LoadFill.Size = UDim2.new(i / 100, 0, 1, 0)
        LoadFill.BackgroundColor3 = GetLoadColor(i)
        LoadLabel.Text = i .. "%"
        task.wait(0.015)
    end
end

function FinishLoading()
    LoadLabel.Text = "DaffzHub"
    local fadeTween = TweenService:Create(LoadFill, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 1
    })
    fadeTween:Play()
    fadeTween.Completed:Connect(function()
        LoadFill.Visible = false
    end)
    ShowBtn.Active = true
    ShowBtn.AutoButtonColor = true
end

