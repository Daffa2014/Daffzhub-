-- Fungsi AddToConsole (hanya untuk output script)
function AddToConsole(text)
    local line = Instance.new("TextLabel")
    line.Size = UDim2.new(1, -10, 0, 18)
    line.BackgroundTransparency = 1
    line.Text = tostring(text)
    line.Font = Enum.Font.Code
    line.TextSize = 12
    line.TextColor3 = Color3.new(1,1,1)
    line.TextXAlignment = Enum.TextXAlignment.Left
    line.Parent = ConsoleOutput
    
    task.wait()
    ConsoleOutput.CanvasPosition = Vector2.new(0, ConsoleOutput.CanvasSize.Y.Offset)
end

-- Hook ke print
local oldPrint = print
print = function(...)
    local args = {...}
    local text = ""
    for i, v in ipairs(args) do
        text = text .. tostring(v)
        if i < #args then text = text .. " " end
    end
    AddToConsole(text)
    oldPrint(...)
end

