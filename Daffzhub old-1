local safeZoneActive = false
local safeZonePlatform = nil
local safeZoneReturnCF = nil
local SAFEZONE_POSITION = Vector3.new(0, 10000, 0)

TPSafeZoneBtn.MouseButton1Click:Connect(function()
    local char = Player.Character
    if not char then return end

    if not safeZoneActive then
        -- SIMPAN posisi asal sebelum TP
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        safeZoneReturnCF = root.CFrame

        -- BUAT PLATFORM hijau neon
        safeZonePlatform = Instance.new("Part")
        safeZonePlatform.Name = "DaffzHub_SafeZonePlatform"
        safeZonePlatform.Size = Vector3.new(20, 2, 20)
        safeZonePlatform.Position = SAFEZONE_POSITION - Vector3.new(0, 3, 0)
        safeZonePlatform.Anchored = true
        safeZonePlatform.CanCollide = true
        safeZonePlatform.Material = Enum.Material.Neon
        safeZonePlatform.Color = Color3.fromRGB(40, 255, 120)
        safeZonePlatform.Parent = workspace

        local platLight = Instance.new("PointLight", safeZonePlatform)
        platLight.Color = Color3.fromRGB(40, 255, 120)
        platLight.Range = 25
        platLight.Brightness = 2

        -- Maksa area target di-load dulu
        pcall(function()
            Player:RequestStreamAroundAsync(SAFEZONE_POSITION, 5)
        end)

        -- Retry loop biar gak ketarik balik (anti race-condition)
        for i = 1, 8 do
            pcall(function()
                char:PivotTo(CFrame.new(SAFEZONE_POSITION))
            end)
            task.wait(0.15)

            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (root.Position - SAFEZONE_POSITION).Magnitude
                if dist < 10 then
                    break -- udah nempel, berhenti retry
                end
            end
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Landed)
            pcall(function() hum.PlatformStand = false end)
        end

        safeZoneActive = true
        TPSafeZoneBtn.Text = "Teleport Back"
        TPSafeZoneBtn.BackgroundColor3 = Color3.fromRGB(230, 140, 30)
    else
        -- TELEPORT BACK ke posisi asal
        if safeZoneReturnCF then
            pcall(function()
                Player:RequestStreamAroundAsync(safeZoneReturnCF.Position, 5)
            end)

            for i = 1, 8 do
                pcall(function()
                    char:PivotTo(safeZoneReturnCF)
                end)
                task.wait(0.15)

                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local dist = (root.Position - safeZoneReturnCF.Position).Magnitude
                    if dist < 10 then
                        break
                    end
                end
            end

            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Landed)
            end
        end

        -- HAPUS platform
        if safeZonePlatform and safeZonePlatform.Parent then
            safeZonePlatform:Destroy()
        end
        safeZonePlatform = nil
        safeZoneReturnCF = nil

        safeZoneActive = false
        TPSafeZoneBtn.Text = "Tp To SafeZone"
        TPSafeZoneBtn.BackgroundColor3 = Color3.fromRGB(40, 170, 80)
    end
end)

