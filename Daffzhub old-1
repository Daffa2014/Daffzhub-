function ESearchCatalog(keyword)
    local params = CatalogSearchParams.new()
    params.SearchKeyword = keyword or ""
    params.CategoryFilter = Enum.CatalogCategoryFilter.None
    params.SalesTypeFilter = Enum.SalesTypeFilter.All
    params.AssetTypes = {Enum.AvatarAssetType.EmoteAnimation}
    params.IncludeOffSale = true
    params.SortType = ESortTypes[ECurrentSort][1]
    params.Limit = 10
    local ok, result = pcall(function()
        return AvatarEditorService:SearchCatalog(params)
    end)
    if not ok then return nil end
    return result
end

-- Update tombol pagination: halaman 1 cuma ">", halaman terakhir cuma "<"
function EUpdatePagerButtons(pageObj)
    EPrevBtn.Visible = ECurrentPageNum > 1
    ENextBtn.Visible = not (pageObj and pageObj.IsFinished)
    EPageLabel.Text = "Page " .. tostring(ECurrentPageNum)
end

function ELoadCatalogPage(pageObj)
    for _, child in ipairs(ECatalogScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    EEmptyLabel.Visible = false

    local ok, items = pcall(function()
        return pageObj:GetCurrentPage()
    end)
    if not ok or not items or #items == 0 then
        EEmptyLabel.Visible = true
        EPrevBtn.Visible = ECurrentPageNum > 1
        ENextBtn.Visible = false
        return
    end

    for _, item in ipairs(items) do
        EBuildCatalogCard(item)
    end

    ECatalogScroll.CanvasSize = UDim2.new(0,0,0,ECatalogGrid.AbsoluteContentSize.Y+8)
    EUpdatePagerButtons(pageObj)
end

function EDoSearch(keyword)
    EPageLabel.Text = "Loading..."
    for _, child in ipairs(ECatalogScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    ECurrentPageNum = 1
    task.spawn(function()
        ECurrentPage = ESearchCatalog(keyword)
        if ECurrentPage then
            ELoadCatalogPage(ECurrentPage)
        else
            EEmptyLabel.Visible = true
            EPageLabel.Text = "Error"
            EPrevBtn.Visible = false
            ENextBtn.Visible = false
        end
    end)
end

ERefreshBtn.MouseButton1Click:Connect(function()
    EDoSearch(ECatalogSearch.Text)
end)

ECatalogSearch.FocusLost:Connect(function(enter)
    if enter then EDoSearch(ECatalogSearch.Text) end
end)

ENextBtn.MouseButton1Click:Connect(function()
    if not ECurrentPage or ECurrentPage.IsFinished then return end
    local ok = pcall(function() ECurrentPage:AdvanceToNextPageAsync() end)
    if ok then
        ECurrentPageNum = ECurrentPageNum + 1
        ELoadCatalogPage(ECurrentPage)
    end
end)

EPrevBtn.MouseButton1Click:Connect(function()
    if not ECurrentPage or ECurrentPageNum <= 1 then return end
    local ok = pcall(function() ECurrentPage:AdvanceToPreviousPageAsync() end)
    if ok then
        ECurrentPageNum = math.max(1, ECurrentPageNum - 1)
        ELoadCatalogPage(ECurrentPage)
    end
end)

