                        if isfile(oldFile) and not isfile(newFile) then
                            local content = readfile(oldFile)
                            writefile(newFile, content)
                            delfile(oldFile)
                            refreshScriptList(ScriptSearch.Text)
                        end
                    end
                    Pop:Destroy()
                end)
            end)

            nameBox.FocusLost:Connect(function(enterPressed)
                nameBox.TextEditable = false
                if enterPressed then
                    local newName = nameBox.Text:match("^%s*(.-)%s*$")
                    if newName ~= "" and newName ~= name then
                        local oldFile = SCRIPTS_FOLDER .. "/" .. name .. ".txt"
                        local newFile = SCRIPTS_FOLDER .. "/" .. newName .. ".txt"
                        if isfile(oldFile) and not isfile(newFile) then
                            local content = readfile(oldFile)
                            writefile(newFile, content)
                            delfile(oldFile)
                            refreshScriptList(ScriptSearch.Text)
                        else
                            nameBox.Text = name
                        end
                    else
                        nameBox.Text = name
                    end
                else
                    nameBox.Text = name
                end
            end)

            delBtn.MouseButton1Click:Connect(function()
                ShowConfirmPopup("Delete this Script?", Color3.fromRGB(180, 40, 40), function()
                    local file = SCRIPTS_FOLDER .. "/" .. name .. ".txt"
                    if isfile(file) then
                        delfile(file)
                        refreshScriptList(ScriptSearch.Text)
                    end
                end)
            end)
        end
    end
end

