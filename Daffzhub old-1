local function loadUserScripts()
    if isfile(USER_SCRIPTS_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(USER_SCRIPTS_FILE))
        end)
        if success and type(data) == "table" then
            userScripts = data
        else
            userScripts = {}
        end
    else
        userScripts = {}
    end
end

local function saveUserScripts()
    pcall(function()
        writefile(USER_SCRIPTS_FILE, HttpService:JSONEncode(userScripts))
    end)
end

local function addUserScript(name, scriptContent)
    if name == "" or scriptContent == "" then return false end
    local newScript = {
        id = tostring(os.time()) .. tostring(math.random(1000, 9999)),
        name = name,
        content = scriptContent,
        added = os.date("%Y-%m-%d %H:%M:%S")
    }
    table.insert(userScripts, newScript)
    saveUserScripts()
    return true
end

local function deleteUserScript(id)
    for i, script in ipairs(userScripts) do
        if script.id == id then
            table.remove(userScripts, i)
            saveUserScripts()
            return true
        end
    end
    return false
end

local function editUserScriptName(id, newName)
    for i, script in ipairs(userScripts) do
        if script.id == id then
            script.name = newName
            saveUserScripts()
            return true
        end
    end
    return false
end

