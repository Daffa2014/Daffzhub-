local function PopulateBringPlayerList(list, search)
    -- Hapus isi lama
    for _, child in pairs(list:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    search = search and search:lower() or ""
    
    -- Loop semua player
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player then
            local pName = player.Name:lower()
            local dName = player.DisplayName:lower()
            
            -- Filter berdasarkan search
            if search == "" or pName:find(search) or dName:find(search) then
                -- BUAT FRAME PLAYER
