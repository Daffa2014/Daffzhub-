-- Logika Toggle Desync
DesyncToggle.MouseButton1Click:Connect(function()
    local char = Player.Character
    if not char then DesyncStatus.Text = "❌ No character!" return end

    if not desyncActive then
        local root = desyncGetRoot(char)
        local torso = desyncGetTorso(char)
        if not root or not torso then DesyncStatus.Text = "❌ Missing body parts!" return end

        local savedCF = root.CFrame
        desyncSpawnCF = savedCF
        desyncHiddenPos = Vector3.new(root.Position.X, root.Position.Y + 50000, root.Position.Z)
        char:MoveTo(desyncHiddenPos)
        task.wait()

        desyncSeat = Instance.new("Seat")
        desyncSeat.Anchored = false
        desyncSeat.CanCollide = false
        desyncSeat.Transparency = 1
        desyncSeat.Size = Vector3.new(2, 1, 1)
        desyncSeat.Position = desyncHiddenPos
        desyncSeat.Parent = workspace

        desyncWeld = Instance.new("Weld")
        desyncWeld.Part0 = desyncSeat
        desyncWeld.Part1 = torso
        desyncWeld.Parent = desyncSeat

        task.wait()
        desyncSeat.CFrame = savedCF

        desyncActive = true
        DesyncToggle.Text = "Desync | ON"
        DesyncToggle.BackgroundColor3 = Color3.fromRGB(90, 55, 200)
        DesyncStatus.Text = "✅ Desync  Active!"
        task.delay(3, function() if DesyncStatus then DesyncStatus.Text = "" end end)
    else
        local root = desyncGetRoot(char)
        local visualCF = root and root.CFrame

        if desyncLoop then desyncLoop:Disconnect() desyncLoop = nil end
        if desyncSeat and desyncSeat.Parent then desyncSeat:Destroy() end
        desyncSeat = nil desyncWeld = nil

        if visualCF and char then
            task.wait(0.1)
            pcall(function() char:PivotTo(visualCF) end)
        end

        desyncActive = false
        desyncSpeedOn = false
        DesyncToggle.Text = "Desync | OFF"
        DesyncToggle.BackgroundColor3 = Color3.fromRGB(60, 40, 140)
        DesyncSpeedBtn.Text = "Speed | OFF"
        DesyncSpeedBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        DesyncStatus.Text = "✅ TP to visual position!"
        task.delay(3, function() if DesyncStatus then DesyncStatus.Text = "" end end)
    end
end)

