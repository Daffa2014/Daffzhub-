SBLastQuery = ""
SBIsSearching = false

local function SBDoSearch(silent)
    local query = SBSearchInput.Text
    if query == "" then return end
    if SBIsSearching then return end
    SBIsSearching = true
    SBLastQuery = query

    if not silent then
        SBStatusLabel.Text = "⏳ search on Scriptblox & RawScripts.."
        SBStatusLabel.TextColor3 = Color3.fromRGB(255,200,100)
    end

    task.spawn(function()
        local sbRes = SBFetchScriptblox(query)
        local rsRes = SBFetchRawScripts(query)

        SBLastSBResults = sbRes
        SBLastRSResults = rsRes

        local total = #sbRes + #rsRes
        if total == 0 then
            SBStatusLabel.Text = "❌ No Results For: " .. query
            SBStatusLabel.TextColor3 = Color3.fromRGB(255,80,80)
        else
            SBStatusLabel.Text = "✅ " .. #sbRes .. " Scriptblox · " .. #rsRes .. " RawScripts"
            SBStatusLabel.TextColor3 = Color3.fromRGB(80,200,80)
        end

        SBRefreshList()
        SBIsSearching = false
    end)
end

