function EGetReal(id)
    local ok, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))
    end)
    if ok and result and #result > 0 then
        local obj = result[1]
        if obj:IsA("Animation") and obj.AnimationId ~= "" then
            return tonumber(obj.AnimationId:match("%d+"))
        elseif obj:FindFirstChildOfClass("Animation") then
            return tonumber(obj:FindFirstChildOfClass("Animation").AnimationId:match("%d+"))
        end
    end
end

function EPlayEmote(id)
    if ECurrentAnim then ECurrentAnim:Stop(ESettings["Fade Out"]) end
    local animId
    local ok, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))
    end)
    if ok and result and #result > 0 then
        local obj = result[1]
        animId = obj:IsA("Animation") and obj.AnimationId or ("rbxassetid://" .. tostring(id))
    else
        animId = "rbxassetid://" .. tostring(id)
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = animId
    local track = EHum:LoadAnimation(anim)
    local priority = ESettings["High Priority"] and Enum.AnimationPriority.Action4 or Enum.AnimationPriority.Action
    track.Priority = priority
    local weight = ESettings["Weight"]
    if weight == 0 then weight = 0.001 end
    if ESettings["Stop Other Animations On Play"] then
        for _, t in pairs(EHum.Animator:GetPlayingAnimationTracks()) do
            if t.Priority ~= priority then t:Stop() end
        end
    end
    track:Play(ESettings["Fade In"], weight, ESettings["Speed"])
    ECurrentAnim = track
    ECurrentAnim.Priority = priority
    ECurrentAnim.Looped = ESettings["Looped"]
end

