-- ================================================
-- 1. VARIABLES PROTECTION
-- ================================================
local protections = {
    antiFling = false,
    antiSlap = false,
    antiVoid = false,
    antiSit = false,
    antiAfk = false
}

local protectionConnections = {
    antiFling = nil,
}

local FLING_MAX_VELOCITY = 60
local FLING_MAX_ANGULAR = 30
local originalFallenHeight = workspace.FallenPartsDestroyHeight

-- ================================================
-- 2. FUNGSI ANTI FLING
-- ================================================
local function startAntiFling()
    if protectionConnections.antiFling then return end
    
    protectionConnections.antiFling = RunService.RenderStepped:Connect(function()
        if not protections.antiFling then return end
        
        local myChar = Player.Character
        if not myChar then return end

        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not (myHum and myRoot and myHum.Health > 0) then return end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player then
                local char = plr.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        -- Block velocity fling
                        if hrp.Velocity.Magnitude > FLING_MAX_VELOCITY then
                            hrp.Velocity = Vector3.zero
                        end

                        -- Block rotation fling
                        if hrp.RotVelocity.Magnitude > FLING_MAX_ANGULAR then
                            hrp.RotVelocity = Vector3.zero
                        end

                        -- Prevent fake hitbox fling
                        if hrp.Size.X > 5 or hrp.Size.Y > 5 or hrp.Size.Z > 5 then
                            hrp.Size = Vector3.new(2, 2, 1)
                        end

                        -- Prevent no-collide fling
                        if hrp.CanCollide == false then
                            hrp.CanCollide = true
                        end
                    end
                end
            end
        end
    end)
end

local function stopAntiFling()
    if protectionConnections.antiFling then
        protectionConnections.antiFling:Disconnect()
        protectionConnections.antiFling = nil
    end
end

-- ================================================
-- 3. FUNGSI ANTI SLAP
-- ================================================
local function doBodyVelocity(v, char)
    local undo = false
    if protections.antiSlap then
        -- Remove BodyAngularVelocity
        if v:IsA("BodyAngularVelocity") then
            undo = true
            v:Destroy()
        -- Remove malicious BodyGyro
        elseif v:IsA("BodyGyro") and v.MaxTorque ~= Vector3.new(8999999488, 8999999488, 8999999488) and v.D ~= 500 and v.D ~= 50 and v.P ~= 90000 then
            undo = true
            v:Destroy()
        -- Remove BodyVelocity
        elseif v:IsA("BodyVelocity") and v.MaxForce ~= Vector3.new(8999999488, 8999999488, 8999999488) and v.Velocity ~= Vector3.new(0, 0, 0) then
            undo = true
            v:Destroy()
        -- Listen to BasePart children
        elseif v:IsA("BasePart") then
            v.ChildAdded:Connect(function(v2)
                doBodyVelocity(v2, char)
            end)
        end
        
        -- Undo sit/platformstand
        if undo and char and char:FindFirstChild("Humanoid") then
            char.Humanoid.Sit = false
            char.Humanoid.PlatformStand = false
        end
    end
end

local function setupAntiSlap(char)
    -- Apply to existing children
    for _, v in pairs(char:GetChildren()) do
        doBodyVelocity(v, char)
        for _, v2 in pairs(v:GetChildren()) do
            doBodyVelocity(v2, char)
        end
    end
    
    -- Listen for new children
    char.ChildAdded:Connect(function(v)
        doBodyVelocity(v, char)
    end)
end

-- ================================================
-- 4. FUNGSI ANTI SIT
-- ================================================
local function startAntiSit()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    antiSitConnection = hum:GetPropertyChangedSignal("Sit"):Connect(function()
        if hum.Sit then
            -- 1. Destroy seat
            local seat = hum.SeatPart
            if seat then pcall(function() seat:Destroy() end) end

            -- 2. Force properties
            pcall(function() hum.Sit = false end)
            pcall(function() hum.PlatformStand = false end)

            -- 3. Force jump state
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)

            -- 4. Remove semua BodyMover yang mungkin nahan karakter
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BodyPosition") or part:IsA("BodyVelocity") 
                    or part:IsA("BodyGyro") or part:IsA("AlignPosition")
                    or part:IsA("AlignOrientation") then
                        pcall(function() part:Destroy() end)
                    end
                end
            end

            -- 5. Unanchor semua part
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() part.Anchored = false end)
                end
            end

            -- 6. Stop semua animasi duduk
            for _, track in pairs(hum:GetPlayingAnimationTracks()) do
                pcall(function() track:Stop() end)
            end
        end
    end)
end

local function stopAntiSit()
    if antiSitConnection then antiSitConnection:Disconnect() antiSitConnection = nil end
end

