-- VARIABLES
local SelectedSpectatePlayer = nil
local SelectedTeleportPlayer = nil
local CurrentSpectateTarget = nil

-- FUNGSI UPDATE PLAYER LISTS
local function UpdatePlayerLists()
    local spectateSearch = SpectateSearch.Text:lower()
    local teleportSearch = TeleportSearch.Text:lower()
    local selectedSpectateName = SelectedSpectatePlayer and SelectedSpectatePlayer.Name or nil
    local selectedTeleportName = SelectedTeleportPlayer and SelectedTeleportPlayer.Name or nil

    for _, child in ipairs(SpectateList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, child in ipairs(TeleportList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player then
            -- Spectate Item
            local spectateItem = Instance.new("TextButton", SpectateList)
            spectateItem.Size = UDim2.new(1, -10, 0, 25)
            spectateItem.Position = UDim2.new(0, 5, 0, 0)
            spectateItem.Text = player.DisplayName .. " (@" .. player.Name .. ")"
            spectateItem.Font = Enum.Font.Gotham
            spectateItem.TextSize = 12
            spectateItem.TextTruncate = Enum.TextTruncate.AtEnd
            spectateItem.AutoButtonColor = true
            Instance.new("UICorner", spectateItem).CornerRadius = UDim.new(0, 4)

            -- Restore selection warna biru kalau player ini yang dipilih
            if selectedSpectateName == player.Name then
                spectateItem.BackgroundColor3 = Color3.fromRGB(40,100,180)
                spectateItem.TextColor3 = Color3.new(1,1,1)
            else
                spectateItem.BackgroundColor3 = Color3.fromRGB(45,45,45)
                spectateItem.TextColor3 = Color3.new(1,1,1)
            end

            -- Restore visibility sesuai search
            spectateItem.Visible = spectateSearch == "" or spectateItem.Text:lower():find(spectateSearch) ~= nil

            spectateItem.MouseButton1Click:Connect(function()
                -- Kalau lagi spectate, lock - tidak bisa ganti player
                if CurrentSpectateTarget ~= nil then return end
                SelectedSpectatePlayer = player
                for _, btn in ipairs(SpectateList:GetChildren()) do
                    if btn:IsA("TextButton") then
                        btn.BackgroundColor3 = Color3.fromRGB(45,45,45)
                    end
                end
                spectateItem.BackgroundColor3 = Color3.fromRGB(40,100,180)
            end)

            -- Teleport Item
            local teleportItem = Instance.new("TextButton", TeleportList)
            teleportItem.Size = UDim2.new(1, -10, 0, 25)
            teleportItem.Position = UDim2.new(0, 5, 0, 0)
            teleportItem.Text = player.DisplayName .. " (@" .. player.Name .. ")"
            teleportItem.Font = Enum.Font.Gotham
            teleportItem.TextSize = 12
            teleportItem.TextTruncate = Enum.TextTruncate.AtEnd
