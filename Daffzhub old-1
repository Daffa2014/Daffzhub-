local function PerformReportSearch(searchTerm)
local term = searchTerm:lower():gsub("%s+", " "):gsub("^%s*(.-)%s*$", "%1")
    IsSearchingReport = term ~= ""
    
    if term == "" then
        for _, data in ipairs(AllReportFrames) do
            data.card.Visible = true
        end
        ReportHeader.Text = "Report System (Testing)"
        return
    end
    
    local ResultCount = 0
    
    for _, data in ipairs(AllReportFrames) do
        data.card.Visible = false
    end
    
    for _, data in ipairs(AllReportFrames) do
        local MatchFound = 
            data.category:find(term, 1, true) ~= nil or
            data.name:find(term, 1, true) ~= nil or
            data.text:find(term, 1, true) ~= nil
        
        if MatchFound then
            data.card.Visible = true
            ResultCount = ResultCount + 1
            
            local stroke = data.card:FindFirstChild("UIStroke")
            if stroke then
                TweenService:Create(stroke, TweenInfo.new(0.2), {
                    Transparency = 0.1,
                    Color = Color3.fromRGB(0,180,255)
                }):Play()
            end
        end
    end
    
    ReportHeader.Text = "🔍 " .. ResultCount .. " RESULTS FOUND"
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    PerformReportSearch(SearchBox.Text)
end)

