-- SLIDER BUILDER -- gaya sama seperti SensiTrack/SensiKnob/SensiFill di Tab Setting
function EMakeSlider(name, minVal, maxVal, defaultVal)
    ESettings[name] = defaultVal or minVal

    local frame = Instance.new("Frame", ESettingsScroll)
    frame.Size = UDim2.new(1, 0, 0, 50)
    frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel", frame)
    lbl.Size = UDim2.new(1, -16, 0, 18)
    lbl.Position = UDim2.new(0, 8, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = string.format("%s: %.2f", name, ESettings[name])
    lbl.TextColor3 = Color3.new(1,1,1)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local track = Instance.new("Frame", frame)
    track.Size = UDim2.new(1, -16, 0, 6)
    track.Position = UDim2.new(0, 8, 0, 30)
    track.BackgroundColor3 = Color3.fromRGB(40,40,40)
    Instance.new("UICorner", track).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = Color3.fromRGB(40, 170, 80)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)

    local knob = Instance.new("TextButton", track)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.Text = ""
    knob.AutoButtonColor = false
    knob.ZIndex = 2
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

    local function updateSlider(val)
        val = math.clamp(val, minVal, maxVal)
        val = math.floor(val * 100) / 100
        ESettings[name] = val
        local pct = (val - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        lbl.Text = string.format("%s: %.2f", name, val)
        if ECurrentAnim and ECurrentAnim.IsPlaying then
            if name == "Speed" then
                pcall(function() ECurrentAnim:AdjustSpeed(val) end)
            elseif name == "Weight" then
                pcall(function() ECurrentAnim:AdjustWeight(val == 0 and 0.001 or val) end)
            end
        end
    end

    -- PENTING: 'dragging' HARUS local di sini, supaya tiap slider (Speed, Weight, dst)
    -- punya statusnya sendiri-sendiri. Kalau kata 'local' ini hilang, semua slider
    -- akan berbagi 1 variabel 'dragging' global -> geser 1 slider, semua ikut geser.
    local dragging = false

    local function getVal(input)
        local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        return minVal + (maxVal - minVal) * pct
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(getVal(input))
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(getVal(input))
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    ESettings._sliders[name] = updateSlider
    updateSlider(defaultVal or minVal)
end

