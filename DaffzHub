-- returns reply, nil on success or nil, errorText on failure
function DHBot.Ask(text, useHistory)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then return nil, "Your executor has no request function." end
    local HS = game:GetService("HttpService")
    local model = string.gsub(DHBot.Model, "[^%w%.%-_]", "")
    if model == "" then model = "gemini-flash-lite-latest" end
    local contents = {}
    if useHistory then
        for i = math.max(1, #DHBot.History - 15), #DHBot.History do
            local m = DHBot.History[i]
            contents[#contents + 1] = {role = m.role, parts = {{text = m.text}}}
        end
        while contents[1] and contents[1].role ~= "user" do table.remove(contents, 1) end
    end
    contents[#contents + 1] = {role = "user", parts = {{text = text}}}
    local sys = DHBot.Personas[DHBot.Persona][2] .. " Reply in the same language the user writes in. Keep replies under about 1200 characters unless the user asks for long code. Do not use LaTeX; write math with plain symbols like ×, ÷, √, ², π."
    local ctx = DHBot.Context()
    if ctx ~= "" then sys = sys .. " Extra info the user chose to share: " .. ctx end
    local bodyJson = HS:JSONEncode({
        systemInstruction = {parts = {{text = sys}}},
        contents = contents,
        generationConfig = {temperature = 0.8, maxOutputTokens = 1024},
    })
    -- busy servers (500/503/504): try again once, then fall back to the lighter model
    local spare = (model ~= "gemini-flash-lite-latest") and "gemini-flash-lite-latest" or "gemini-flash-latest"
    local res, okj, data, code
    for attempt = 1, 3 do
        local useModel = (attempt == 3) and spare or model
        local url, hdr, body
        if DHBot.UseOwn and DHBot.Key ~= "" then
            url = "https://generativelanguage.googleapis.com/v1beta/models/" .. useModel .. ":generateContent"
            hdr = {["Content-Type"] = "application/json", ["x-goog-api-key"] = DHBot.Key}
            body = bodyJson
        else
            url = DHBot.Proxy
            hdr = {["Content-Type"] = "application/json"}
            body = HS:JSONEncode({model = useModel, systemInstruction = {parts = {{text = sys}}}, contents = contents})
        end
        local ok, r = pcall(req, {Url = url, Method = "POST", Headers = hdr, Body = body})
        if not ok or type(r) ~= "table" then return nil, "Request failed. Check your connection." end
        res = r
        okj, data = pcall(function() return HS:JSONDecode(res.Body or "") end)
        code = res.StatusCode
        if code ~= 500 and code ~= 503 and code ~= 504 then break end
       if attempt < 3 then task.wait(1) end
    end

    if code ~= 200 then
        if code == 429 then return nil, "Rate limit reached. Wait a minute and try again." end
        local msg = okj and type(data) == "table" and type(data.error) == "table" and data.error.message
        return nil, "Gemini error " .. tostring(code) .. ": " .. string.sub(tostring(msg or "unknown"), 1, 150)
    end
    if not okj or type(data) ~= "table" then return nil, "Could not read the reply." end
    local cand = data.candidates and data.candidates[1]
    local parts = cand and cand.content and cand.content.parts
    local out = {}
    if parts then
        for _, p in ipairs(parts) do
            if type(p.text) == "string" then out[#out + 1] = p.text end
        end
    end
    local reply = table.concat(out)
    if reply == "" then
        if cand and cand.finishReason == "SAFETY" then return nil, "Blocked by the safety filter. Try rephrasing." end
        return nil, "Empty reply. Try again."
    end
    return reply, nil
end

-- sends a reply to the game chat (only called after the user confirms)
function DHBot.ToChat(text)
    task.spawn(function()
        local one = string.gsub(DHBot.Plain(text), "%c+", " ")
        local ch, legacy
        pcall(function()
            local c = game:GetService("TextChatService"):FindFirstChild("TextChannels")
            ch = c and c:FindFirstChild("RBXGeneral")
        end)
        pcall(function()
            local f = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
            legacy = f and f:FindFirstChild("SayMessageRequest")
        end)
        for i = 1, 3 do
            local piece = string.sub(one, (i - 1) * 190 + 1, i * 190)
            if piece == "" then break end
            if ch then
                pcall(function() ch:SendAsync(piece) end)
            elseif legacy then
                pcall(function() legacy:FireServer(piece, "All") end)
            end
            task.wait(1.3)
        end
    end)
end

-- ---------- reply formatting: markdown -> Roblox rich text, LaTeX -> plain symbols ----------
DHBot.Sup = {["0"] = "⁰", ["1"] = "¹", ["2"] = "²", ["3"] = "³", ["4"] = "⁴", ["5"] = "⁵", ["6"] = "⁶", ["7"] = "⁷", ["8"] = "⁸", ["9"] = "⁹", ["n"] = "ⁿ", ["+"] = "⁺", ["-"] = "⁻"}
DHBot.Sub = {["0"] = "₀", ["1"] = "₁", ["2"] = "₂", ["3"] = "₃", ["4"] = "₄", ["5"] = "₅", ["6"] = "₆", ["7"] = "₇", ["8"] = "₈", ["9"] = "₉"}
DHBot.Tex = {
    ["\\times"] = "×", ["\\div"] = "÷", ["\\cdot"] = "·", ["\\pm"] = "±", ["\\leq"] = "≤", ["\\le"] = "≤",
    ["\\geq"] = "≥", ["\\ge"] = "≥", ["\\neq"] = "≠", ["\\ne"] = "≠", ["\\approx"] = "≈", ["\\infty"] = "∞",
    ["\\pi"] = "π", ["\\theta"] = "θ", ["\\alpha"] = "α", ["\\beta"] = "β", ["\\gamma"] = "γ", ["\\delta"] = "δ",
    ["\\Delta"] = "Δ", ["\\sigma"] = "σ", ["\\mu"] = "μ", ["\\lambda"] = "λ", ["\\omega"] = "ω", ["\\Omega"] = "Ω",
    ["\\sum"] = "Σ", ["\\int"] = "∫", ["\\rightarrow"] = "→", ["\\to"] = "→", ["\\circ"] = "°", ["\\degree"] = "°",
    ["\\left"] = "", ["\\right"] = "", ["\\quad"] = " ", ["\\,"] = " ",
}

function DHBot.Esc(s)
    s = string.gsub(s, "&", "&amp;")
    s = string.gsub(s, "<", "&lt;")
    s = string.gsub(s, ">", "&gt;")
    return s
end

function DHBot.Math(s)
    -- drop the $ ... $ and \( \) \[ \] wrappers, but only around real math (so prices like $5 stay)
    s = string.gsub(s, "%$([^%$\n]-)%$", function(m)
        if string.find(m, "[\\%^_{}]") then return m end
        return nil
    end)
    s = string.gsub(s, "\\%((.-)\\%)", "%1")
    s = string.gsub(s, "\\%[(.-)\\%]", "%1")
    s = string.gsub(s, "\\text{([^{}]*)}", "%1")
    s = string.gsub(s, "\\frac%s*{([^{}]*)}%s*{([^{}]*)}", "(%1)/(%2)")
    s = string.gsub(s, "\\sqrt%s*{([^{}]*)}", "√(%1)")
    s = string.gsub(s, "([%w%)])%^{([%dn%+%-]+)}", function(a, b)
        return a .. string.gsub(b, ".", DHBot.Sup)
    end)
    s = string.gsub(s, "([%w%)])%^([%dn])", function(a, b) return a .. DHBot.Sup[b] end)
    s = string.gsub(s, "_{(%d+)}", function(b) return (string.gsub(b, ".", DHBot.Sub)) end)
    s = string.gsub(s, "\\[%a,]+", function(cmd) return DHBot.Tex[cmd] end)
    return s
end

function DHBot.Rich(text)
    local s = DHBot.Math(tostring(text))
    local codes = {}
    local function keep(c)
        codes[#codes + 1] = '<font face="RobotoMono" color="#9fd8ff">' .. DHBot.Esc(c) .. "</font>"
        return "\1" .. #codes .. "\2"
    end
    -- code is set aside first so nothing inside it is changed
    s = string.gsub(s, "```[%w_]*\n?(.-)```", function(c) return keep((string.gsub(c, "\n$", ""))) end)
    s = string.gsub(s, "`([^`\n]+)`", keep)
    s = DHBot.Esc(s)
    s = string.gsub(s, "\n#+%s*([^\n]*)", "\n<b>%1</b>")
    s = string.gsub(s, "^#+%s*([^\n]*)", "<b>%1</b>")
    s = string.gsub(s, "\n%s*[%*%-]%s+", "\n• ")
    s = string.gsub(s, "^%s*[%*%-]%s+", "• ")
    s = string.gsub(s, "%*%*(.-)%*%*", "<b>%1</b>")
    s = string.gsub(s, "__(.-)__", "<b>%1</b>")
    s = string.gsub(s, "%*([^%*\n]+)%*", "<i>%1</i>")
    s = string.gsub(s, "%[([^%]\n]+)%]%(([^%)\n]+)%)", "%1 (%2)")
    s = string.gsub(s, "\1(%d+)\2", function(i) return codes[tonumber(i)] end)
    return s
end

-- plain text for the game chat (no markdown symbols)
function DHBot.Plain(text)
    local s = DHBot.Math(tostring(text))
    s = string.gsub(s, "```[%w_]*\n?", "")
    s = string.gsub(s, "%*%*", "")
    s = string.gsub(s, "`", "")
    s = string.gsub(s, "\n#+%s*", "\n")
    s = string.gsub(s, "^#+%s*", "")
    s = string.gsub(s, "%*([^%*\n]+)%*", "%1")
    return s
end

