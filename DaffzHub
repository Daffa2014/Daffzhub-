            min = nil, max = nil, sum = 0, n = 0, hist = {},
            label = DHStatTable.Cell(row, 1, d.label, 10, Color3.fromRGB(170,170,170), Enum.Font.Gotham),
            now = DHStatTable.Cell(row, 2, "-", 12, Color3.fromRGB(255,255,255)),
            mn = DHStatTable.Cell(row, 3, "-", 10, Color3.fromRGB(150,150,150)),
            mx = DHStatTable.Cell(row, 4, "-", 10, Color3.fromRGB(150,150,150)),
            av = DHStatTable.Cell(row, 5, "-", 10, Color3.fromRGB(150,150,150)),
            tr = DHStatTable.Cell(row, 6, "", 10, Color3.fromRGB(150,150,150), Enum.Font.Gotham),
        }
    end
end

function DHStatTable.Fmt(key, v)
    if DHStatTable.Defs[key].dec == 0 then
        return tostring(math.floor(v + 0.5))
    end
    return string.format("%.1f", v)
end

function DHStatTable.Push(key, v)
    local d, r = DHStatTable.Defs[key], DHStatTable.Rows[key]
    if not (d and r) then return end
    r.min = r.min and math.min(r.min, v) or v
    r.max = r.max and math.max(r.max, v) or v
    r.sum = r.sum + v
    r.n = r.n + 1

    -- trend: now against the average of the last samples
    local prev = nil
    if #r.hist >= 4 then
        local s = 0
        for _, x in ipairs(r.hist) do s = s + x end
        prev = s / #r.hist
    end
    r.hist[#r.hist + 1] = v
    if #r.hist > 10 then table.remove(r.hist, 1) end

    r.now.Text = DHStatTable.Fmt(key, v)
    r.now.TextColor3 = d.color and d.color(v) or Color3.fromRGB(255,255,255)
    r.mn.Text = DHStatTable.Fmt(key, r.min)
    r.mx.Text = DHStatTable.Fmt(key, r.max)
    r.av.Text = DHStatTable.Fmt(key, r.sum / r.n)

    local arrow, col = "–", Color3.fromRGB(110,110,110)
    if prev then
        local diff = v - prev
        local limit = math.max(math.abs(prev) * 0.03, d.dec == 0 and 0.5 or 0.2)
        if math.abs(diff) > limit then
            local up = diff > 0
            arrow = up and "▲" or "▼"
            if d.good == 0 then
                col = Color3.fromRGB(77,163,255)
            else
                col = ((up and d.good > 0) or (not up and d.good < 0)) and Color3.fromRGB(47,224,122) or Color3.fromRGB(255,70,70)
            end
        end
    end
    r.tr.Text = arrow
    r.tr.TextColor3 = col
end

