DHAdj = {Orig = {}, Sliders = {}}

function DHAdj.Set(obj, key, v)
    if not obj then return end
    DHAdj.Orig[obj] = DHAdj.Orig[obj] or {}
    if DHAdj.Orig[obj][key] == nil then
        local ok, cur = pcall(function() return obj[key] end)
        if ok then DHAdj.Orig[obj][key] = cur end
    end
    pcall(function() obj[key] = v end)
end

function DHAdj.GetClouds()
    local t = workspace.Terrain
    local c = t:FindFirstChildOfClass("Clouds")
    if not c then
        c = Instance.new("Clouds")
        c.Name = "DH_Clouds"
        c.Parent = t
        DHAdj.Clouds = c
    end
    return c
end

function DHAdj.Reset()
    for obj, t in pairs(DHAdj.Orig) do
        for k, v in pairs(t) do
            pcall(function() obj[k] = v end)
        end
    end
    DHAdj.Orig = {}
    if DHAdj.Clouds then
        DHAdj.Clouds:Destroy()
        DHAdj.Clouds = nil
    end
    for _, s in ipairs(DHAdj.Sliders) do
        s[1].Set(s[2], true)
    end
end

