function DHShader.Particles(kind, token)
    local part = Instance.new("Part")
    part.Name = "DH_WeatherEmitter"
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Transparency = 1
    part.Size = Vector3.new(80, 1, 80)
    part.Parent = workspace

    local e = Instance.new("ParticleEmitter")
    e.EmissionDirection = Enum.NormalId.Bottom
    if kind == "snow" then
        e.Rate = 150
        e.Lifetime = NumberRange.new(6, 8)
        e.Speed = NumberRange.new(5, 9)
        e.Size = NumberSequence.new(0.3)
        e.Color = ColorSequence.new(Color3.new(1, 1, 1))
        e.Transparency = NumberSequence.new(0.2)
        e.RotSpeed = NumberRange.new(-40, 40)
        e.SpreadAngle = Vector2.new(20, 20)
    else
        e.Rate = (kind == "storm") and 500 or 300
        e.Lifetime = NumberRange.new(1.2, 1.6)
        e.Speed = NumberRange.new(70, 90)
        e.Size = NumberSequence.new(0.6)
        e.Orientation = Enum.ParticleOrientation.VelocityParallel
        e.Color = ColorSequence.new(Color3.fromRGB(190, 210, 235))
        e.Transparency = NumberSequence.new(0.55)
        e.SpreadAngle = Vector2.new(3, 3)
    end
    e.Parent = part

    task.spawn(function()
        while DHShader.Token == token and part.Parent do
            local cam = workspace.CurrentCamera
            if cam then
                part.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 45, 0))
            end
            task.wait()
        end
        part:Destroy()
    end)
end

