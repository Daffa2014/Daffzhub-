            return
        end
        local dir = Camera.CFrame.LookVector
        if magnetEnabled then ToggleMagnet() end
        pcall(function() blk.AssemblyLinearVelocity = dir * DHMoveCfg.ThrowPower end)
        MagnetStatus.Text = "Status: Thrown"
    end)
end
