    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 12)
    pad.PaddingLeft = UDim.new(0, 12)
    pad.PaddingRight = UDim.new(0, 12)
    local lay = Instance.new("UIListLayout", card)
    lay.Padding = UDim.new(0, 5)
    lay.SortOrder = Enum.SortOrder.LayoutOrder

    local function Esc(s)
        s = s:gsub("&", "&amp;")
        s = s:gsub("<", "&lt;")
        s = s:gsub(">", "&gt;")
        return s
    end
    local function Hex(c)
        return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
    end
    local order = 0
    local function Line(text, size, color, font)
        order = order + 1
        local l = Instance.new("TextLabel", card)
        l.LayoutOrder = order
        l.Size = UDim2.new(1, 0, 0, 0)
        l.AutomaticSize = Enum.AutomaticSize.Y
        l.BackgroundTransparency = 1
        l.RichText = true
        l.Text = text
        l.Font = font
        l.TextSize = size
        l.TextColor3 = color
        l.TextWrapped = true
        l.TextXAlignment = Enum.TextXAlignment.Left
        return l
    end

    local gray = Color3.fromRGB(215, 215, 215)
    local gold = Color3.fromRGB(255, 200, 0)
    Line("What's New:", 18, Color3.new(1, 1, 1), Enum.Font.GothamBold)

    for idx, entry in ipairs(DHChangelog) do
        local head = "Update " .. string.char(64 + idx) .. "  (" .. Esc(tostring(entry.date)) .. ")"
        if idx == 1 then head = head .. '  <font color="#50C86E">NEW</font>' end
        Line(head, 14, gold, Enum.Font.GothamBold)
        -- plain text notes (no category) come first
        for _, it in ipairs(entry.items) do
            if type(it) == "string" then
                Line("•  " .. Esc(it), 12, gray, Enum.Font.Gotham)
            end
        end
        -- then one colored line per item, in the order of the categories
        for _, tg in ipairs(DHChangelogTags) do
            for _, it in ipairs(entry.items) do
                if type(it) == "table" and it[1] == tg.key then
                    Line('<font color="' .. Hex(tg.color) .. '">●  ' .. tg.key .. ":</font>  " .. Esc(tostring(it[2])), 12, gray, Enum.Font.Gotham)
                end
            end
        end
    end

    -- put the card right under the Version row, above "Content Inside Hub"
    local n, after = 0, nil
    for _, c in ipairs(CreditScroll:GetChildren()) do
        if c:IsA("GuiObject") and c ~= card then
            n = n + 10
            c.LayoutOrder = n
            if c == VersionFrame then after = n end
        end
    end
    card.LayoutOrder = (after or n) + 5
end

task.spawn(function()
    task.wait(2)
    pcall(DHWhatsNew)
end)

end)
