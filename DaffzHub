            local moved = (root.Position - ELastPos).Magnitude > 0.1
            local jumped = EHum and EHum:GetState() == Enum.HumanoidStateType.Jumping
            if moved or jumped then
                ECurrentAnim:Stop(ESettings["Fade Out"])
                ECurrentAnim = nil
            end
        end
        ELastPos = root.Position
    end
end)

