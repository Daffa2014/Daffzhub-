function DHMood.Filter(text)
    local s = string.lower(text)
    for _, c in ipairs(DHMood.Cards) do
        local n = string.lower(c.entry.name or "")
        c.btn.Visible = (s == "") or (string.find(n, s, 1, true) ~= nil) or (string.find(tostring(c.entry.id), s, 1, true) ~= nil)
    end
end

-- brings back the default moods that were deleted (your own moods stay)
function DHMood.Reset()
    local have = {}
    for _, e in ipairs(DHMood.List) do have[e.id] = true end
    local n = 0
    for _, d in ipairs(DHMood.Defaults) do
        if not have[d[1]] then
            DHMood.List[#DHMood.List + 1] = {id = d[1], name = d[2]}
            n = n + 1
        end
    end
    if DHMood.Built then
        for _, c in ipairs(DHMood.Cards) do
            pcall(function() c.btn:Destroy() end)
        end
        DHMood.Cards = {}
        DHMood.Built = false
        DHMood.BuildCards()
    end
    DHMood.Save()
    DHMood.Say(n > 0 and ("Restored " .. n .. " moods") or "Nothing to restore")
end

function DHMood.BuildCards()
    if DHMood.Built then return end
    DHMood.Built = true
    for _, e in ipairs(DHMood.List) do DHMood.AddCard(e) end
    DHMood.Mark()
end

