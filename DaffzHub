-- ---------- Noclip: only parts it changed are restored, nothing is left behind ----------
DHMods.NcOrig = setmetatable({}, {__mode = "k"})
function DHMods.NoclipSet(on)
    if DHMods.NcConn then
        DHMods.NcConn:Disconnect()
        DHMods.NcConn = nil
    end
    if on then
        DHMods.NcConn = RunService.Stepped:Connect(function()
            local char = Player.Character
            if not char then return end
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then
                    DHMods.NcOrig[p] = true
                    p.CanCollide = false
                end
            end
        end)
    else
        for p in pairs(DHMods.NcOrig) do
            if p.Parent then p.CanCollide = true end
        end
        DHMods.NcOrig = setmetatable({}, {__mode = "k"})
    end
end

-- ---------- Wall Walk: walk on walls and ceilings like a spider ----------
-- walk / idle animations for wall mode: the Humanoid is switched off there, so we play the character's own animations
function DHMods.WwAnimStop()
    local ww = DHMods.Ww
    if not ww then return end
    if ww.Tracks then
        for _, t in pairs(ww.Tracks) do
            if t then pcall(function() t:Stop(0.15) end) end
        end
    end
    ww.Tracks = nil
    ww.TrackHum = nil
    ww.Cur = nil
end

function DHMods.WwAnim(hum, moving, speed)
    local ww = DHMods.Ww
    if not ww.Tracks or ww.TrackHum ~= hum then
        DHMods.WwAnimStop()
        local animate = hum.Parent and hum.Parent:FindFirstChild("Animate")
        local animator = hum:FindFirstChildOfClass("Animator")
        if not (animate and animator) then return end
        local function Load(folder, child)
            local fo = animate:FindFirstChild(folder)
            local a = fo and (fo:FindFirstChild(child) or fo:FindFirstChildOfClass("Animation"))
            if not a then return nil end
            local ok, t = pcall(function() return animator:LoadAnimation(a) end)
            if not ok or not t then return nil end
            t.Priority = Enum.AnimationPriority.Action
            t.Looped = true
            return t
        end
        ww.Tracks = {walk = Load("walk", "WalkAnim"), idle = Load("idle", "Animation1")}
        ww.TrackHum = hum
    end
    local tr = ww.Tracks
    if not tr then return end
    local want = moving and tr.walk or tr.idle
    if want ~= ww.Cur then
        if ww.Cur then ww.Cur:Stop(0.15) end
        if want then want:Play(0.15) end
        ww.Cur = want
    end
    if moving and tr.walk then tr.walk:AdjustSpeed(math.clamp(speed / 16, 0.3, 3)) end
end

-- a force that cancels gravity while we hang on a wall, so the body does not sag between frames
function DHMods.WwForceSet(root)
    local ww = DHMods.Ww
    if ww.Force then ww.Force:Destroy() ww.Force = nil end
    if ww.Att then ww.Att:Destroy() ww.Att = nil end
    if not root then return end
    local att = Instance.new("Attachment")
    att.Name = "DHWwAtt"
    att.Parent = root
    local vf = Instance.new("VectorForce")
    vf.Name = "DHWwForce"
    vf.Attachment0 = att
    vf.RelativeTo = Enum.ActuatorRelativeTo.World
    vf.ApplyAtCenterOfMass = true
    vf.Force = Vector3.zero
    vf.Parent = root
    ww.Att = att
    ww.Force = vf
end

-- raw stick / keys input (x = right, z = back), it does not depend on where the camera is rolled to
function DHMods.WwInput()
    if DHMods.WwCtl == nil then
        DHMods.WwCtl = false
        pcall(function()
            local ps = Player:FindFirstChild("PlayerScripts")
            local pm = ps and ps:FindFirstChild("PlayerModule")
            if pm then DHMods.WwCtl = require(pm):GetControls() end
        end)
    end
    if DHMods.WwCtl then
        local ok, v = pcall(function() return DHMods.WwCtl:GetMoveVector() end)
        if ok and typeof(v) == "Vector3" then return -v.Z, v.X end
    end
    return nil, nil
end

function DHMods.WwExit(hum, root, onFloor)
    local ww = DHMods.Ww
    if not ww or not ww.Active then return end
    ww.Active = false
    DHMods.WwActive = false
    DHMods.WwAnimStop()
    DHMods.WwForceSet(nil)
    if root and root.Parent then
        local look = ww.Fwd or root.CFrame.LookVector
        look = Vector3.new(look.X, 0, look.Z)
        if look.Magnitude < 0.05 then look = Vector3.new(0, 0, -1) end
        root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if hum and hum.Parent then
        hum.PlatformStand = false
        hum:ChangeState(onFloor and Enum.HumanoidStateType.GettingUp or Enum.HumanoidStateType.Freefall)
    end
end

function DHMods.WwStep(ww, dt, rp)
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) or hum.Health <= 0 then
        DHMods.WwExit(nil, nil, false)
        return
    end
    if hum.SeatPart then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    rp.FilterDescendantsInstances = {char}

    -- what the player pushes (forward f, right r)
    local look = cam.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0, 0, -1) end
    flatLook = flatLook.Unit
    local flatRight = Vector3.new(-flatLook.Z, 0, flatLook.X)
    local f, r = DHMods.WwInput()
    if not f then
        f, r = 0, 0
        local md = hum.MoveDirection
        if md.Magnitude > 0.1 then
            f = md:Dot(flatLook)
            r = md:Dot(flatRight)
        end
    end

    if not ww.Active then
        -- walking into a wall (or a steep slope)? start climbing it
        if tick() < ww.Cool then return end
        local dir = flatLook * f + flatRight * r
        if dir.Magnitude < 0.1 then return end
        dir = dir.Unit
        local hit = workspace:Raycast(root.Position, dir * 3.2, rp)
        if hit and hit.Normal.Y < 0.7 then
            ww.Active = true
            DHMods.WwActive = true
            ww.Up = root.CFrame.UpVector
            ww.Target = hit.Normal
            ww.Fwd = dir
            ww.Vel = Vector3.zero
            ww.Lost = 0
            ww.Born = tick()
            hum.PlatformStand = true
            DHMods.WwForceSet(root)
        end
        return
    end

    local up = ww.Up
    -- forward on the surface: where the camera looks, or straight "up the wall" when the camera faces it
    local tf = look - up * look:Dot(up)
    if tf.Magnitude < 0.35 then
        local cu = cam.CFrame.UpVector
        tf = cu - up * cu:Dot(up)
    end
    if tf.Magnitude < 0.01 then
        local fb = ww.Fwd or Vector3.new(0, 0, -1)
        tf = fb - up * fb:Dot(up)
    end
    if tf.Magnitude < 0.01 then return end
    tf = tf.Unit
    local tr = tf:Cross(up)
    local dir = tf * f + tr * r
    local mag = math.min(dir.Magnitude, 1)
    local moving = mag > 0.1
    if moving then
        dir = dir.Unit
        ww.Dir = dir
        -- turn the body smoothly towards where we walk
        local nf = (ww.Fwd or dir):Lerp(dir, math.clamp(dt * 14, 0, 1))
        if nf.Magnitude < 0.05 then nf = dir end
        ww.Fwd = nf.Unit
    else
        ww.Dir = Vector3.zero
    end

    -- feel the surface with many rays and average the normals: centre, a ring around the feet, and one ahead
    local pos = root.Position
    local base = (ww.Fwd or tf)
    base = base - up * base:Dot(up)
    if base.Magnitude < 0.01 then base = tf end
    base = base.Unit
    local side = up:Cross(base)
    local sum = Vector3.zero
    local hits = 0
    local bestGap, bestN = nil, nil
    local function Take(h, w, useGap)
        sum = sum + h.Normal * w
        hits = hits + 1
        if not useGap then return end
        -- how far we are from this surface (straight distance to its plane)
        local gap = (pos - h.Position):Dot(h.Normal)
        if not bestGap or gap < bestGap then
            bestGap = gap
            bestN = h.Normal
        end
    end
    local hc = workspace:Raycast(pos, -up * 6, rp)
    if hc then Take(hc, 2, true) end
    for i = 0, 11 do
        local ang = i * (math.pi / 6)
        local rad = base * math.cos(ang) + side * math.sin(ang)
        -- start outside the feet and aim down and inwards, this also catches the side of an edge we walk over
        local h = workspace:Raycast(pos + rad * 3, (-up * 3 - rad * 1.3).Unit * 12, rp)
        if h then Take(h, 0.5 + 0.5 * math.max(0, rad:Dot(base))) end
    end
    if moving then
        local h = workspace:Raycast(pos, dir * 5, rp)
        if h and h.Normal:Dot(up) < 0.9 then Take(h, 10, true) end
    end

    if hits > 0 then
        ww.Lost = 0
        if sum.Magnitude > 0.01 then ww.Target = sum.Unit end
    else
        ww.Lost = ww.Lost + dt
        if ww.Lost > 0.3 then
            DHMods.WwExit(hum, root, false)
            return
        end
    end

    local tn = ww.Target or up
    -- back on normal ground: hand control back to the normal walking
    if tn.Y > 0.85 and up.Y > 0.85 and tick() - ww.Born > 0.3 then
        local g = workspace:Raycast(pos, Vector3.new(0, -4.5, 0), rp)
        if g and g.Normal.Y > 0.7 then
            DHMods.WwExit(hum, root, true)
            return
        end
    end

    up = up:Lerp(tn, math.clamp(dt * 12, 0, 1))
    if up.Magnitude < 0.01 then up = tn end
    up = up.Unit
    ww.Up = up

    local fwd = ww.Fwd or tf
    fwd = fwd - up * fwd:Dot(up)
    if fwd.Magnitude < 0.01 then fwd = tf end
    fwd = fwd.Unit
    root.CFrame = CFrame.fromMatrix(pos, fwd:Cross(up), up, -fwd)

    -- speed up and slow down smoothly, and hold the body 3 studs off the nearest surface
    ww.Vel = (ww.Vel or Vector3.zero):Lerp(moving and dir * (hum.WalkSpeed * mag) or Vector3.zero, math.clamp(dt * 10, 0, 1))
    local hold = -6
    local hn = tn
    if bestGap then
        hold = math.clamp((3 - bestGap) * 12, -25, 25)
        hn = bestN
    end
    root.AssemblyLinearVelocity = ww.Vel + hn * hold
    root.AssemblyAngularVelocity = Vector3.zero
    if ww.Force then ww.Force.Force = Vector3.new(0, workspace.Gravity * root.AssemblyMass, 0) end
    pcall(DHMods.WwAnim, hum, moving, hum.WalkSpeed * mag)
end

function DHMods.WallWalkSet(on)
    DHMods.Ww = DHMods.Ww or {}
    local ww = DHMods.Ww
    if ww.Conn then
        ww.Conn:Disconnect()
        ww.Conn = nil
    end
    if ww.Jump then
        ww.Jump:Disconnect()
        ww.Jump = nil
    end
    if not on then
        local char = Player.Character
        DHMods.WwExit(char and char:FindFirstChildOfClass("Humanoid"), char and char:FindFirstChild("HumanoidRootPart"), true)
        return
    end
    ww.Active = false
    DHMods.WwActive = false
    DHMods.WwCtl = nil
    ww.Up = Vector3.new(0, 1, 0)
    ww.Lost = 0
    ww.Cool = 0
    ww.Born = 0
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.RespectCanCollide = true

    -- jump lets go of the wall and kicks you away from it
    ww.Jump = UIS.JumpRequest:Connect(function()
        if not ww.Active then return end
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not (hum and root) then return end
        local kick = ww.Up * 45 + (ww.Dir or Vector3.zero) * hum.WalkSpeed
        ww.Cool = tick() + 0.4
        DHMods.WwExit(hum, root, false)
        root.AssemblyLinearVelocity = kick
    end)

    ww.Conn = RunService.Heartbeat:Connect(function(dt)
        pcall(DHMods.WwStep, ww, dt, rp)
    end)
end

-- optional: roll the camera with the wall, so a ceiling looks like a floor (screen up = the surface "up")
function DHMods.WwCamStep(dt)
    local ww = DHMods.Ww
    local cam = workspace.CurrentCamera
    if not (ww and cam) then return end
    local y = Vector3.new(0, 1, 0)
    local want = (ww.Active and ww.Up) or y
    local cu = (ww.CamUp or y):Lerp(want, math.clamp(dt * 6, 0, 1))
    if cu.Magnitude < 0.05 then cu = want end
    cu = cu.Unit
    ww.CamUp = cu
    if (cu - y).Magnitude < 0.02 then return end
    local cf = cam.CFrame
    local l = cf.LookVector
    local p = cu - l * cu:Dot(l)
    -- looking straight along the surface normal has no clear roll, so fade the roll out there
    local k = math.clamp(p.Magnitude / 0.5, 0, 1)
    if k <= 0.01 then return end
    local u = cf.UpVector:Lerp(p.Unit, k)
    if u.Magnitude < 0.05 then return end
    cam.CFrame = CFrame.lookAt(cf.Position, cf.Position + l, u.Unit)
end

function DHMods.WwCamSet(on)
    pcall(function() RunService:UnbindFromRenderStep("DHWwCam") end)
    DHMods.Ww = DHMods.Ww or {}
    DHMods.Ww.CamUp = nil
    if not on then return end
    RunService:BindToRenderStep("DHWwCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
        pcall(DHMods.WwCamStep, dt)
    end)
end

