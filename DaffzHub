-- ---------- Click Teleport: tap (phone) or click (PC) the world to teleport there ----------
DHMods.Ct = {}

function DHMods.CtGo(sp)
    local cam = workspace.CurrentCamera
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (cam and hum and root) or hum.Health <= 0 then return end
    local ray = cam:ScreenPointToRay(sp.X, sp.Y)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {char}
    rp.RespectCanCollide = true
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, rp)
    if not hit then return end
    local n = hit.Normal
    local h = hum.HipHeight + root.Size.Y / 2
    -- stand on top of the spot, and a little away from a wall
    local pos = hit.Position + Vector3.new(n.X, 0, n.Z) * 2 + Vector3.new(0, h + 0.5, 0)
    root.CFrame = CFrame.new(pos) * root.CFrame.Rotation
    root.AssemblyLinearVelocity = Vector3.zero
end

function DHMods.CtSet(on)
    local ct = DHMods.Ct
    if ct.Tap then
        ct.Tap:Disconnect()
        ct.Tap = nil
    end
    if ct.Click then
        ct.Click:Disconnect()
        ct.Click = nil
    end
    if not on then return end

    ct.Tap = UIS.TouchTapInWorld:Connect(function(pos, processed)
        if processed then return end
        pcall(DHMods.CtGo, pos)
    end)
    ct.Click = UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            pcall(DHMods.CtGo, input.Position)
        end
    end)
end

