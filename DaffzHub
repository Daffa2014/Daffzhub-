    Btn.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

    -- own ScreenGui; the hub's DisplayOrder is raised while it is on, so DaffzHub stays above it
    local BlackGui = Instance.new("ScreenGui")
    BlackGui.Name = "DH_BlackScreen"
    BlackGui.ResetOnSpawn = false
    BlackGui.IgnoreGuiInset = true
    BlackGui.DisplayOrder = 50
    BlackGui.Enabled = false
    BlackGui.Parent = ScreenGui.Parent

    local Cover = Instance.new("Frame", BlackGui)
    Cover.Size = UDim2.new(1, 0, 1, 0)
    Cover.BackgroundColor3 = Color3.new(0, 0, 0)
    Cover.BorderSizePixel = 0
    Cover.Active = true -- swallows touches: camera and controls cannot be moved

    local Card = Instance.new("Frame", Cover)
    Card.AnchorPoint = Vector2.new(0.5, 0.5)
    Card.Position = UDim2.new(0.5, 0, 0.5, 0)
    Card.Size = UDim2.new(0, 280, 0, 246)
    Card.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 12)

    local CardStroke = Instance.new("UIStroke", Card)
    CardStroke.Color = Color3.new(1, 1, 1) -- the white line
    CardStroke.Thickness = 2

    local Title = Instance.new("TextLabel", Card)
    Title.Size = UDim2.new(1, 0, 0, 32)
    Title.Position = UDim2.new(0, 0, 0, 4)
    Title.BackgroundTransparency = 1
    Title.Text = "🌑 BLACK SCREEN"
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 15
    Title.TextColor3 = Color3.new(1, 1, 1)

    local function Line(y, transparency)
        local l = Instance.new("Frame", Card)
        l.Size = UDim2.new(1, -24, 0, 1)
        l.Position = UDim2.new(0, 12, 0, y)
        l.BackgroundColor3 = Color3.new(1, 1, 1)
        l.BackgroundTransparency = transparency
        l.BorderSizePixel = 0
    end

    local function Row(y, name)
        local k = Instance.new("TextLabel", Card)
        k.Size = UDim2.new(0.5, -14, 0, 28)
        k.Position = UDim2.new(0, 14, 0, y)
        k.BackgroundTransparency = 1
        k.Text = name
        k.Font = Enum.Font.Gotham
        k.TextSize = 13
        k.TextColor3 = Color3.fromRGB(170, 170, 170)
        k.TextXAlignment = Enum.TextXAlignment.Left

        local v = Instance.new("TextLabel", Card)
        v.Size = UDim2.new(0.5, -14, 0, 28)
        v.Position = UDim2.new(0.5, 0, 0, y)
        v.BackgroundTransparency = 1
        v.Text = "-"
        v.Font = Enum.Font.GothamBold
        v.TextSize = 14
        v.TextColor3 = Color3.new(1, 1, 1)
        v.TextXAlignment = Enum.TextXAlignment.Right
        return v
    end

    Line(38, 0)
    local FpsV = Row(44, "FPS")
    Line(72, 0.7)
    local PingV = Row(72, "Ping")
    Line(100, 0.7)
    local PlayersV = Row(100, "Players")
    Line(128, 0.7)
    local ServerV = Row(128, "Server Time")
    Line(156, 0.7)
    local BlackV = Row(156, "Black Screen")
    Line(188, 0)

    -- Safe Zone shortcut: mirrors the Safe Zone button of the Player tab and triggers the same action
    local SZ = Instance.new("TextButton", Card)
    SZ.Size = UDim2.new(0, 150, 0, 34)
    SZ.Position = UDim2.new(0, 14, 0, 198)
    SZ.Font = Enum.Font.GothamBold
    SZ.TextSize = 13
    SZ.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", SZ).CornerRadius = UDim.new(0, 8)

    local function SyncSafeZone()
        SZ.Text = TPSafeZoneBtn.Text
        SZ.BackgroundColor3 = TPSafeZoneBtn.BackgroundColor3
    end
    SyncSafeZone()
    TPSafeZoneBtn:GetPropertyChangedSignal("Text"):Connect(SyncSafeZone)
    TPSafeZoneBtn:GetPropertyChangedSignal("BackgroundColor3"):Connect(SyncSafeZone)
    SZ.MouseButton1Click:Connect(function() ToggleSafeZone() end)

    local on = false
    local startTime = 0
    local prevOrder = 0

    local function Fmt(sec)
        return string.format("%d:%02d:%02d", math.floor(sec / 3600), math.floor((sec % 3600) / 60), sec % 60)
    end

    local function Refresh(m)
        FpsV.Text = tostring(m.fps)
        FpsV.TextColor3 = DHFpsColor(m.fps)
        PingV.Text = m.ping .. " ms"
        PingV.TextColor3 = DHPingColor(m.ping)
        PlayersV.Text = #Players:GetPlayers() .. "/" .. game.Players.MaxPlayers
        ServerV.Text = Fmt(os.time() - DHMetrics.serverStart)
        BlackV.Text = Fmt(os.time() - startTime)
    end

    -- same shared numbers as the Info Tab and Other Settings
    table.insert(DHMetrics.listeners, function(m)
        if on then Refresh(m) end
    end)

        local warmToken = 0

    local function SetBlack(state)
        on = state
        warmToken = warmToken + 1
        Btn.Text = state and "Black Screen: ON" or "Black Screen: OFF"
        Btn.BackgroundColor3 = state and Color3.fromRGB(40, 170, 80) or Color3.fromRGB(180, 30, 30)
        if state then
            if not BlackGui.Enabled then prevOrder = ScreenGui.DisplayOrder end
            BlackGui.Enabled = true
            Title.Text = "🌑 BLACK SCREEN"
            startTime = os.time()
            ScreenGui.DisplayOrder = 100 -- keep DaffzHub above the black screen
            Refresh(DHMetrics)
            if BlackCfg.Disable3D then
                pcall(function() RunService:Set3dRenderingEnabled(false) end)
            end
        elseif BlackCfg.Disable3D then
            -- bring 3D back first, but keep the black cover for a few seconds:
            -- the world reloads behind it instead of lagging on your screen
            pcall(function() RunService:Set3dRenderingEnabled(true) end)
            Title.Text = "⏳ RESTORING..."
            local myWarm = warmToken
            task.delay(BlackCfg.WarmUp, function()
                if warmToken == myWarm and not on then
                    BlackGui.Enabled = false
                    ScreenGui.DisplayOrder = prevOrder
                end
            end)
        else
            BlackGui.Enabled = false
            ScreenGui.DisplayOrder = prevOrder
        end
    end

    Btn.MouseButton1Click:Connect(function()
        SetBlack(not on)
    end)
    
    -- Quit: leave Black Screen
    local Quit = Instance.new("TextButton", Card)
    Quit.Size = UDim2.new(0, 94, 0, 34)
    Quit.Position = UDim2.new(0, 172, 0, 198)
    Quit.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
    Quit.Text = "Quit"
    Quit.Font = Enum.Font.GothamBold
    Quit.TextSize = 13
    Quit.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", Quit).CornerRadius = UDim.new(0, 8)
    Quit.MouseButton1Click:Connect(function()
        SetBlack(false)
    end)

    -- if the hub is closed while the black screen is on, give the screen back
    ScreenGui.Destroying:Connect(function()
        if on then
            pcall(function() RunService:Set3dRenderingEnabled(true) end)
        end
        BlackGui:Destroy()
    end)
end

pcall(BuildBlackScreen)

end

