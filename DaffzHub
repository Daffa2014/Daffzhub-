function DHMood.Load()
    local data
    pcall(function()
        if isfile and readfile and isfile(DHMood.Path) then
            data = game:GetService("HttpService"):JSONDecode(readfile(DHMood.Path))
        end
    end)
    DHMood.List = {}
    if type(data) == "table" and type(data.moods) == "table" then
        for _, e in ipairs(data.moods) do
            if type(e) == "table" and type(e.id) == "number" then
                DHMood.List[#DHMood.List + 1] = {id = e.id, name = type(e.name) == "string" and e.name or nil}
            end
        end
        if type(data.loop) == "boolean" then DHMood.Loop = data.loop end
        if type(data.keep) == "boolean" then DHMood.Keep = data.keep end
    end
    if #DHMood.List == 0 then
        for _, d in ipairs(DHMood.Defaults) do
            DHMood.List[#DHMood.List + 1] = {id = d[1], name = d[2]}
        end
    end
end

-- waits a moment so many changes write the file only once
function DHMood.Save()
    DHMood.Token = DHMood.Token + 1
    local my = DHMood.Token
    task.delay(0.8, function()
        if my ~= DHMood.Token then return end
        pcall(function()
            if not (writefile and makefolder and isfolder) then return end
            if not isfolder("Daffzhub_file") then makefolder("Daffzhub_file") end
            if not isfolder("Daffzhub_file/Setting") then makefolder("Daffzhub_file/Setting") end
            local moods = {}
            for _, e in ipairs(DHMood.List) do moods[#moods + 1] = {id = e.id, name = e.name} end
            writefile(DHMood.Path, game:GetService("HttpService"):JSONEncode({moods = moods, loop = DHMood.Loop, keep = DHMood.Keep}))
        end)
    end)
end

-- the real animation id behind a catalog asset
function DHMood.AnimId(id)
    local ok, obj = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id)) end)
    if ok and obj and #obj > 0 then
        local r = obj[1]
        if r:IsA("Animation") and r.AnimationId ~= "" then return r.AnimationId end
        for _, d in ipairs(r:GetDescendants()) do
            if d:IsA("Animation") and d.AnimationId ~= "" then return d.AnimationId end
        end
    end
    return "rbxassetid://" .. tostring(id)
end

function DHMood.Mark()
    for _, c in ipairs(DHMood.Cards) do
        c.stroke.Transparency = (DHMood.Cur == c.entry.id) and 0 or 1
    end
end

function DHMood.StopTrack()
    local t = DHMood.Track
    DHMood.Track = nil
    if t then pcall(function() t:Stop(0.1) end) end
end

function DHMood.Play(id)
    DHMood.StopTrack()
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then
        DHMood.Say("No character")
        return
    end
    DHMood.Cur = id
    DHMood.Mark()
    task.spawn(function()
        local a = Instance.new("Animation")
        a.AnimationId = DHMood.AnimId(id)
        -- another mood was picked while this one was loading
        if DHMood.Cur ~= id then return end
        local ok, t = pcall(function() return animator:LoadAnimation(a) end)
        if not ok or not t then
            DHMood.Say("Could not load this mood")
            return
        end
        t.Priority = Enum.AnimationPriority.Action4
        t.Looped = DHMood.Loop
        local w = ESettings["Weight"] or 1
        if w <= 0 then w = 0.001 end
        t:Play(0.1, w, ESettings["Speed"] or 1)
        DHMood.Track = t
        DHMood.Say("Mood playing")
    end)
end

function DHMood.Stop()
    DHMood.Cur = nil
    DHMood.StopTrack()
    DHMood.Mark()
    DHMood.Say("Mood stopped")
end

function DHMood.Fetch(card)
    DHMood.FetchN = DHMood.FetchN + 1
    local delay = DHMood.FetchN * 0.15
    task.spawn(function()
        task.wait(delay)
        local e = card.entry
        if e.name then return end
        local ok, res = pcall(function() return game:GetService("MarketplaceService"):GetProductInfo(e.id) end)
        local n
        if ok and res and res.Name then
            n = string.gsub(res.Name, "%s*%-?%s*[Mm]ood%s*$", "")
        else
            n = string.sub(tostring(e.id), -4)
        end
        e.name = n
        if card.label.Parent then card.label.Text = n end
        DHMood.Save()
    end)
end

