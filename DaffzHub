-- ---------- Float: an invisible pad under your feet, so your normal animations keep playing ----------
function DHMods.FloatSet(on)
    if DHMods.FloatConn then
        DHMods.FloatConn:Disconnect()
        DHMods.FloatConn = nil
    end
    if DHMods.FloatPart then
        DHMods.FloatPart:Destroy()
        DHMods.FloatPart = nil
    end
    DHMods.FloatDir = 0
    if not on then return end

    local part = Instance.new("Part")
    part.Name = "DH_FloatPad"
    part.Size = Vector3.new(7, 1, 7)
    part.Transparency = 0.35
    part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(0, 255, 120)
    part.CastShadow = false
    part.Anchored = true
    part.CanCollide = true
    part.CanQuery = false
    part.CanTouch = false
    part.Parent = workspace
    DHMods.FloatPart = part

    local lastRoot, platY = nil, 0
    DHMods.FloatConn = RunService.Heartbeat:Connect(function(dt)
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if not root then return end
        if root ~= lastRoot then
            -- first frame, or you respawned: put the pad right under the feet
            lastRoot = root
            local hh = hum.HipHeight
            if hum.RigType == Enum.HumanoidRigType.R6 then hh = 2 end
            platY = root.Position.Y - hh - root.Size.Y / 2 - 0.5
            DHMods.FloatBase = platY
        end
        local hh = hum.HipHeight
        if hum.RigType == Enum.HumanoidRigType.R6 then hh = 2 end
        local feetY = root.Position.Y - hh - root.Size.Y / 2
        local dir = DHMods.FloatDir or 0
        if DHMods.FlyActive then
            -- Fly: the pad stays right under your feet (no collision while flying), so it is there when you stop
            platY = feetY - 0.6
            DHMods.FloatBase = platY
            part.CanCollide = false
        else
            part.CanCollide = true
            platY = platY + dir * 14 * dt
            if DHMods.FloatBase and platY > DHMods.FloatBase + 300 then
                platY = DHMods.FloatBase + 300
            end
            if dir < 0 then
                -- going down: stop at the real ground so the pad never sinks into the floor
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {char, part}
                rp.RespectCanCollide = true
                local hit = workspace:Raycast(root.Position, Vector3.new(0, -600, 0), rp)
                if hit then
                    local minY = hit.Position.Y - 0.5
                    if platY < minY then platY = minY end
                end
            end
            local top = platY + 0.5
            if feetY < top - 6 then
                -- far below the pad (fell, teleported, noclip): the pad comes to you
                platY = feetY - 0.5
                DHMods.FloatBase = platY
            elseif feetY < top - 0.05 and DHMods.NcConn and root.AssemblyLinearVelocity.Y <= 0.5 then
                -- Noclip lets your body fall through the pad, so stand on it by hand
                root.CFrame = root.CFrame + Vector3.new(0, top - feetY, 0)
                local v = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
            end
        end
        part.CFrame = CFrame.new(root.Position.X, platY, root.Position.Z)
    end)
end

