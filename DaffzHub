-- ================================================
-- MODS TAB (part 6): Silent Aim (best effort, any device)
-- Redirects shot data (Mouse.Hit/Target/UnitRay, Raycast, FindPartOnRay*,
-- ScreenPointToRay) while your camera stays still. Needs executor hook support.
-- ================================================
DHMods.Sa = {On = false, Hooked = false, Part = nil, Pos = nil, Cam = nil, Head = nil, CamObj = nil, Hide = false}
DHMods.SaDesc = "Redirects your shots, camera stays still"

function DHMods.SaNear(o)
    local Sa = DHMods.Sa
    if Sa.Cam and (o - Sa.Cam).Magnitude < 15 then return true end
    if Sa.Head and (o - Sa.Head).Magnitude < 15 then return true end
    return false
end

function DHMods.SaInstall()
    local Sa = DHMods.Sa
    if Sa.Hooked then return true end
    if not (hookmetamethod and getnamecallmethod and checkcaller) then return false end
    local wrap = newcclosure or function(f) return f end
    local mouse = Player:GetMouse()

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", wrap(function(self, key)
        if Sa.On and Sa.Pos and (key == "Hit" or key == "Target" or key == "UnitRay")
            and self == mouse and not checkcaller() then
            if key == "Hit" then
                return CFrame.new(Sa.Pos)
            elseif key == "Target" then
                return Sa.Part
            elseif Sa.Cam and Sa.Pos ~= Sa.Cam then
                return Ray.new(Sa.Cam, (Sa.Pos - Sa.Cam).Unit)
            end
        end
        return oldIndex(self, key)
    end))

    local oldNc
    oldNc = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        if not (Sa.On and Sa.Pos) then return oldNc(self, ...) end
        local m = getnamecallmethod()
        if checkcaller() then return oldNc(self, ...) end

        if m == "Raycast" and self == workspace then
            local o, d = ...
            if typeof(o) == "Vector3" and typeof(d) == "Vector3" and d.Magnitude > 0
                and o ~= Sa.Pos and DHMods.SaNear(o) then
                return oldNc(self, o, (Sa.Pos - o).Unit * d.Magnitude, select(3, ...))
            end
        elseif (m == "FindPartOnRay" or m == "FindPartOnRayWithIgnoreList" or m == "FindPartOnRayWithWhitelist")
            and self == workspace then
            local r = ...
            if typeof(r) == "Ray" and r.Origin ~= Sa.Pos and DHMods.SaNear(r.Origin) then
                return oldNc(self, Ray.new(r.Origin, (Sa.Pos - r.Origin).Unit * r.Direction.Magnitude), select(2, ...))
            end
        elseif (m == "ScreenPointToRay" or m == "ViewportPointToRay") and self == Sa.CamObj then
            local r = oldNc(self, ...)
            if typeof(r) == "Ray" and r.Origin ~= Sa.Pos then
                return Ray.new(r.Origin, (Sa.Pos - r.Origin).Unit * r.Direction.Magnitude)
            end
            return r
        end
        return oldNc(self, ...)
    end))

    Sa.Hooked = true
    return true
end

function DHMods.SaStep()
    local Sa = DHMods.Sa
    local cam = workspace.CurrentCamera
    if not cam then return end
    Sa.CamObj = cam
    Sa.Cam = cam.CFrame.Position
