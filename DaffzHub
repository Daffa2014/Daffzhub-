DHFx = {Show = {}, Chips = {}}
DHFx.Default = {Bass = 0, Mid = 0, Treble = 0, Speed = 1, Pitch = 1, Reverb = 0, Echo = 0, Dist = 0, Spin = false}
DHFx.S = {}
for k, v in pairs(DHFx.Default) do DHFx.S[k] = v end

DHFx.Presets = {
    {"Normal", {}},
    {"Echo", {Echo = 6}},
    {"Reverb", {Reverb = 6}},
    {"Slowed", {Speed = 0.8}},
    {"Slowed+Reverb", {Speed = 0.8, Reverb = 6}},
    {"Sped Up", {Speed = 1.25}},
    {"Nightcore", {Speed = 1.2, Pitch = 1.2}},
    {"Bass Boost", {Bass = 10}},
    {"8D Audio", {Spin = true, Reverb = 2}},
    {"Lo-fi", {Bass = 3, Treble = -25, Dist = 0.15, Reverb = 2}},
    {"Phonk", {Bass = 10, Dist = 0.35, Reverb = 3}},
    {"Underwater", {Mid = -6, Treble = -40, Reverb = 5}},
    {"Muffled", {Mid = -4, Treble = -40}},
    {"Deep Voice", {Pitch = 0.75}},
    {"Chipmunk", {Pitch = 1.6}},
    {"Daycore", {Speed = 0.75, Treble = -10, Reverb = 3}},
}

function DHFx.Get(snd, class, name)
    local e = snd:FindFirstChild(name)
    if not e then
        e = Instance.new(class)
        e.Name = name
        e.Parent = snd
    end
    return e
end

function DHFx.Drop(snd, name)
    local e = snd:FindFirstChild(name)
    if e then e:Destroy() end
end

-- move the sound to another parent without stopping it
function DHFx.Move(snd, parent)
    if snd.Parent == parent then return end
    local was, pos = snd.IsPlaying, snd.TimePosition
    snd.Parent = parent
    if was then
        snd.TimePosition = pos
        snd:Play()
    end
end

-- 8D: the sound circles around your head
function DHFx.SpinStart()
    if DHFx.SpinConn then return end
    local part = Instance.new("Part")
    part.Name = "DH_8D"
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Transparency = 1
    part.Size = Vector3.new(1, 1, 1)
    part.Parent = workspace
    DHFx.SpinPart = part
    local ang = 0
    DHFx.SpinConn = RunService.Heartbeat:Connect(function(dt)
        local cam = workspace.CurrentCamera
        if not cam then return end
        ang = ang + dt * 0.8
        part.Position = cam.CFrame.Position + Vector3.new(math.cos(ang) * 6, 0, math.sin(ang) * 6)
    end)
end

function DHFx.SpinStop()
    if not DHFx.SpinConn then return end
    DHFx.SpinConn:Disconnect()
    DHFx.SpinConn = nil
    local part = DHFx.SpinPart
    DHFx.SpinPart = nil
    if CurrentSound and CurrentSound.Parent == part then
        pcall(DHFx.Move, CurrentSound, workspace)
    end
    if part then pcall(function() part:Destroy() end) end
end

function DHFx.Apply(snd)
    local s = DHFx.S
    if s.Spin then DHFx.SpinStart() else DHFx.SpinStop() end
    snd = snd or CurrentSound
    if not (snd and snd.Parent) then return end
    snd.PlaybackSpeed = s.Speed

    -- one equalizer reaches +10 dB at most, so a stronger boost stacks several of them
    local used = (s.Bass ~= 0 or s.Mid ~= 0 or s.Treble ~= 0)
    local n = math.clamp(math.ceil(math.max(s.Bass, s.Mid, s.Treble) / 10), 1, 4)
    for i = 1, 4 do
        local name = "DHFx_EQ" .. i
        if used and i <= n then
            local e = DHFx.Get(snd, "EqualizerSoundEffect", name)
            local function part(v)
                if v > 0 then return v / n end
                return (i == 1) and v or 0
            end
            e.LowGain = part(s.Bass)
            e.MidGain = part(s.Mid)
            e.HighGain = part(s.Treble)
        else
            DHFx.Drop(snd, name)
        end
    end

    -- one pitch shifter covers 0.5x to 2x, beyond that two of them work together
    if s.Pitch ~= 1 then
        if s.Pitch < 0.5 or s.Pitch > 2 then
            local half = math.sqrt(s.Pitch)
            DHFx.Get(snd, "PitchShiftSoundEffect", "DHFx_Pitch").Octave = half
            DHFx.Get(snd, "PitchShiftSoundEffect", "DHFx_Pitch2").Octave = half
        else
            DHFx.Get(snd, "PitchShiftSoundEffect", "DHFx_Pitch").Octave = s.Pitch
            DHFx.Drop(snd, "DHFx_Pitch2")
        end
    else
        DHFx.Drop(snd, "DHFx_Pitch")
        DHFx.Drop(snd, "DHFx_Pitch2")
    end

    if s.Reverb > 0 then
        local e = DHFx.Get(snd, "ReverbSoundEffect", "DHFx_Reverb")
        e.DecayTime = 1.5 + s.Reverb * 0.3
        e.Density = 1
        e.Diffusion = 1
        e.DryLevel = -2
        e.WetLevel = math.min(10, -24 + s.Reverb * 2.4)
    else
        DHFx.Drop(snd, "DHFx_Reverb")
    end
    if s.Echo > 0 then
        local e = DHFx.Get(snd, "EchoSoundEffect", "DHFx_Echo")
        e.Delay = 0.28
        e.Feedback = math.min(0.9, 0.2 + s.Echo * 0.04)
        e.DryLevel = 0
        e.WetLevel = math.min(10, -20 + s.Echo * 1.6)
    else
        DHFx.Drop(snd, "DHFx_Echo")
    end
    if s.Dist > 0 then
        DHFx.Get(snd, "DistortionSoundEffect", "DHFx_Dist").Level = s.Dist
    else
        DHFx.Drop(snd, "DHFx_Dist")
    end
    if s.Spin and DHFx.SpinPart then
        DHFx.Move(snd, DHFx.SpinPart)
    end
end

function DHFx.Mark(name)
    for n, b in pairs(DHFx.Chips) do
        b.BackgroundColor3 = (n == name) and Color3.fromRGB(40, 140, 200) or Color3.fromRGB(55, 55, 55)
    end
end

function DHFx.Use(name, p)
    local s = DHFx.S
    for k, v in pairs(DHFx.Default) do s[k] = v end
    for k, v in pairs(p) do s[k] = v end
    for _, f in pairs(DHFx.Show) do f() end
    DHFx.Mark(name)
    DHFx.Apply()
end

function DHFx.Slider(sec, y, name, lo, hi, step, key, fmt)
