    local function show()
        local v = DHFx.S[key]
        local r = math.clamp((v - lo) / (hi - lo), 0, 1)
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, 0, 0.5, 0)
        lbl.Text = name .. ": " .. string.format(fmt, v)
    end
    DHFx.Show[key] = show
