        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            FromInput(input)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            TrollScroll.ScrollingEnabled = true
        end
    end)
    Apply((default - min) / (max - min))
end

-- ---------- Spin ----------
function DHT.SpinStep(dt)
    local sp = DHT.Spin
    if DHMods and (DHMods.WwActive or DHMods.FlyActive) then return end
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and (char:FindFirstChild("HumanoidRootPart") or (hum and hum.RootPart))
    if not (hum and root) or hum.Health <= 0 then return end
    -- new character after a respawn: forget the old AutoRotate memory
    if sp.Char ~= char then
        sp.Char = char
        sp.AutoRot = false
    end
    if hum.AutoRotate then
        sp.AutoRot = true
        hum.AutoRotate = false
    end
    root.CFrame = root.CFrame * CFrame.Angles(0, sp.Speed * 2 * math.pi * math.min(dt, 0.1), 0)
end

function DHT.SpinConnect()
    local sp = DHT.Spin
    if sp.Conn then
        sp.Conn:Disconnect()
        sp.Conn = nil
    end
    sp.Conn = RunService.Heartbeat:Connect(function(dt)
        pcall(DHT.SpinStep, dt)
    end)
end

function DHT.SpinSet(on)
    local sp = DHT.Spin
    if sp.Conn then
        sp.Conn:Disconnect()
        sp.Conn = nil
    end
    if sp.CharConn then
        sp.CharConn:Disconnect()
        sp.CharConn = nil
    end
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and sp.AutoRot then hum.AutoRotate = true end
    sp.AutoRot = false
    sp.Char = nil
    sp.On = on and true or false
    if not on then return end
    DHT.SpinConnect()
    -- after a respawn: start again on the new character
    sp.CharConn = Player.CharacterAdded:Connect(function()
        sp.Char = nil
        sp.AutoRot = false
        task.defer(function()
            if sp.On then DHT.SpinConnect() end
        end)
    end)
end

