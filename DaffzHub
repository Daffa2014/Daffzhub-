-- slider row: name, value, draggable bar. onChange(value) is called while dragging.
function DHMods.AddSlider(name, min, max, default, step, fmt, onChange)
    DHMods.N = DHMods.N + 1
    if DHMods.Note then DHMods.Note.Visible = false end

    local row = Instance.new("Frame", DHMods.Scroll)
    row.Size = UDim2.new(1, 0, 0, 58)
    row.LayoutOrder = DHMods.N
    row.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    row.BorderSizePixel = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local nm = Instance.new("TextLabel", row)
    nm.Size = UDim2.new(1, -80, 0, 18)
    nm.Position = UDim2.new(0, 10, 0, 7)
    nm.BackgroundTransparency = 1
    nm.Text = name
    nm.Font = Enum.Font.GothamBold
    nm.TextSize = 13
    nm.TextColor3 = Color3.new(1, 1, 1)
    nm.TextXAlignment = Enum.TextXAlignment.Left

    local val = Instance.new("TextLabel", row)
    val.Size = UDim2.new(0, 60, 0, 18)
    val.Position = UDim2.new(1, -70, 0, 7)
    val.BackgroundTransparency = 1
    val.Font = Enum.Font.GothamBold
    val.TextSize = 12
    val.TextColor3 = Color3.fromRGB(100, 200, 255)
    val.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame", row)
    bar.Size = UDim2.new(1, -24, 0, 8)
    bar.Position = UDim2.new(0, 12, 0, 40)
    bar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    bar.BorderSizePixel = 0
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 4)

    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(35, 160, 90)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)

    local knob = Instance.new("Frame", bar)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 8)

    -- a wide invisible area so the bar is easy to hit with a thumb
    local hit = Instance.new("TextButton", row)
    hit.Size = UDim2.new(1, 0, 0, 30)
    hit.Position = UDim2.new(0, 0, 0, 28)
    hit.BackgroundTransparency = 1
    hit.Text = ""

    local dragging = false
    local function Apply(r)
        r = math.clamp(r, 0, 1)
        local v = min + (max - min) * r
        v = math.floor(v / step + 0.5) * step
        r = (v - min) / (max - min)
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, 0, 0.5, 0)
        val.Text = string.format(fmt, v)
        pcall(onChange, v)
    end
    local function FromInput(input)
        Apply((input.Position.X - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X))
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            DHMods.Scroll.ScrollingEnabled = false
            FromInput(input)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            FromInput(input)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            DHMods.Scroll.ScrollingEnabled = true
        end
    end)
    Apply((default - min) / (max - min))
end

-- ---------- God Mode (beta): keeps health full on your side ----------
function DHMods.GodSet(on)
    if DHMods.GodConn then
        DHMods.GodConn:Disconnect()
        DHMods.GodConn = nil
    end
    DHMods.GodHum = nil
    local ds = DHMods.GodApi and DHMods.GodApi.Desc
    if ds then ds.Text = "Beta: only works if the map handles damage on your side" end
    if not on then return end
    -- honest mode: we never overwrite your Health (that only hid the real value).
    -- We only watch it and tell you when the map applies damage on the server.
    local last = nil
    DHMods.GodConn = RunService.Heartbeat:Connect(function()
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if hum ~= DHMods.GodHum then
            DHMods.GodHum = hum
            last = hum.Health
            return
        end
        if hum.Health < last - 0.5 then
            local d = DHMods.GodApi and DHMods.GodApi.Desc
            if d then d.Text = "Damage detected: this map uses server damage" end
        end
        last = hum.Health
    end)
end

-- ---------- Xray Vision: local only (LocalTransparencyModifier), nothing real is changed ----------
DHMods.XrayVal = 0.6
DHMods.XrayLite = false
DHMods.XrayOn = false
DHMods.XraySet = {}

function DHMods.XrayRestore()
    for p in pairs(DHMods.XraySet) do
        if p.Parent then
            pcall(function() p.LocalTransparencyModifier = 0 end)
        end
    end
    DHMods.XraySet = {}
end

function DHMods.XrayStep()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local ex = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then ex[#ex + 1] = pl.Character end
    end
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = ex

    local range = DHMods.XrayLite and 50 or 200
    local limit = DHMods.XrayLite and 400 or 1500
    local parts = workspace:GetPartBoundsInRadius(root.Position, range, op)

    local now = {}
    for i, p in ipairs(parts) do
        if i > limit then break end
        if p.Transparency < 0.95 then
            now[p] = true
            if DHMods.XraySet[p] ~= DHMods.XrayVal then
                DHMods.XraySet[p] = DHMods.XrayVal
                p.LocalTransparencyModifier = DHMods.XrayVal
            end
        end
    end
    -- parts that left the range (or were removed) go back to normal
    for p in pairs(DHMods.XraySet) do
        if not now[p] then
            if p.Parent then p.LocalTransparencyModifier = 0 end
            DHMods.XraySet[p] = nil
        end
    end
end

function DHMods.XrayToggle(on)
    DHMods.XrayTok = (DHMods.XrayTok or 0) + 1
    local tok = DHMods.XrayTok
    DHMods.XrayOn = on
    if not on then
        DHMods.XrayRestore()
        return
    end
    task.spawn(function()
        while DHMods.XrayOn and DHMods.XrayTok == tok do
            pcall(DHMods.XrayStep)
            task.wait(DHMods.XrayLite and 0.8 or 0.4)
        end
    end)
end

