DHAdj.Made = {}

function DHAdj.Fx(class, name, defaults)
    local L = game:GetService("Lighting")
    local o = L:FindFirstChild(name)
    if not o then
        o = Instance.new(class)
        o.Name = name
        for k, v in pairs(defaults) do
            pcall(function() o[k] = v end)
        end
        o.Parent = L
        table.insert(DHAdj.Made, o)
    end
    return o
end

DHAdj.Reset0 = DHAdj.Reset
function DHAdj.Reset()
    DHAdj.Reset0()
    for _, o in ipairs(DHAdj.Made) do
        pcall(function() o:Destroy() end)
    end
    DHAdj.Made = {}
end

function DHAdj.More(box, Add)
