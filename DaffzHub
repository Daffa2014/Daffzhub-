function DHPv.Fit()
    local model = DHPv.Model
    if model then
        local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
        if ok and cf then
            DHPv.Center = cf.Position
            DHPv.Dist = math.clamp(math.max(size.Y, size.X) * 1.7, 5, 30)
        else
            DHPv.Center = Vector3.new(0, 1, 0)
            DHPv.Dist = 8
        end
    end
    DHPv.Yaw = 180
    DHPv.Pitch = 6
    DHPv.Cam()
