function DHT.OrbStep(dt)
    local ob = DHT.Orb
    local tp = ob.Target
    if not tp or not tp.Parent then
        DHT.OrbSet(false)
        DHT.OrbHint("Target left the server")
        return
    end
    if DHMods and DHMods.WwActive then return end

    local tchar = tp.Character
    local troot = tchar and (tchar:FindFirstChild("HumanoidRootPart") or tchar.PrimaryPart)
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (troot and root) then return end

    -- our own parts must not push the player we circle
    if ob.PartsChar ~= char then
        ob.PartsChar = char
        ob.Parts = {}
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then ob.Parts[#ob.Parts + 1] = d end
        end
    end
    ob.Orig = ob.Orig or {}
    for _, p in ipairs(ob.Parts) do
        if p.Parent then
            if ob.Orig[p] == nil then ob.Orig[p] = p.CanCollide end
            p.CanCollide = false
        end
    end

    ob.A = ob.A + ob.Speed * math.min(dt, 0.1)
    local c = troot.Position
    local pos = c + Vector3.new(math.cos(ob.A) * ob.Dist, 0, math.sin(ob.A) * ob.Dist)
    root.CFrame = CFrame.lookAt(pos, c)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

function DHT.OrbSet(on)
    local ob = DHT.Orb
    if ob.Conn then
        ob.Conn:Disconnect()
        ob.Conn = nil
    end
    DHT.OrbRestore()
    ob.Following = on and true or false
    DHT.OrbSetBtn()
    if not on then return end

    local ok, ev = pcall(function() return RunService.PreSimulation end)
    if not (ok and ev) then ev = RunService.Stepped end
    ob.Conn = ev:Connect(function(a, b)
        -- PreSimulation gives (dt), Stepped gives (time, dt)
        pcall(DHT.OrbStep, b or a)
    end)
end

-- ---------- Click Fling: tap a player in the world, the same fling as Fling Player ----------
function DHT.CfSay(text)
    if DHT.CfNote then DHT.CfNote.Text = text end
end

function DHT.CfTarget(sp)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    -- touch / mouse positions are viewport coordinates, so use ViewportPointToRay
    local ray = cam:ViewportPointToRay(sp.X, sp.Y)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {Player.Character}
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, rp)
    local inst = hit and hit.Instance
    while inst and inst ~= workspace do
        local pl = Players:GetPlayerFromCharacter(inst)
        if pl then
            if pl ~= Player then return pl end
            break
        end
        inst = inst.Parent
    end

    -- forgiving pick: the closest player on screen to the tap (works from far away)
    local best, bestD = nil, 70
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            local ch = p.Character
            local r = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
            if r then
                local v, onScreen = cam:WorldToViewportPoint(r.Position)
                if onScreen and v.Z > 0 then
                    local d = (Vector2.new(v.X, v.Y) - Vector2.new(sp.X, sp.Y)).Magnitude
                    if d < bestD then
                        best, bestD = p, d
                    end
                end
            end
        end
    end
    return best
end

function DHT.CfGo(sp)
    if FlingActive then return end
    local pl = DHT.CfTarget(sp)
    if not pl then
        DHT.CfSay("No player there")
        task.delay(1, function()
            if DHT.Cf.On and not FlingActive then DHT.CfSay("Tap a player in the world to fling them") end
        end)
        return
    end
    local ch = pl.Character
    local hm = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hm or hm.Health <= 0 then return end
    FlingActive = true
    DHT.CfSay("Flinging " .. pl.DisplayName .. "...")
    FlingStatus.Text = "Click Fling: " .. pl.Name
    task.spawn(function()
        pcall(SkidFling, pl)
        FlingActive = false
        pcall(UpdateFlingStatus)
        DHT.CfSay("Tap a player in the world to fling them")
    end)
end

function DHT.CfSet(on)
    local cf = DHT.Cf
    if cf.Tap then
        cf.Tap:Disconnect()
        cf.Tap = nil
    end
    if cf.Click then
        cf.Click:Disconnect()
        cf.Click = nil
    end
    cf.On = on and true or false
    DHT.CfSay(on and "Tap a player in the world to fling them" or "Turn on, then tap a player in the world")
    if not on then return end

    cf.Tap = UIS.TouchTapInWorld:Connect(function(pos, processed)
        if processed then return end
        pcall(DHT.CfGo, pos)
    end)
    cf.Click = UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            pcall(DHT.CfGo, input.Position)
        end
    end)
end

-- ---------- Lag Switch: holds back your outgoing data, others see you frozen ----------
function DHT.LagLimit(v)
    return pcall(function()
        game:GetService("NetworkClient"):SetOutgoingKBPSLimit(v)
    end)
end

function DHT.LagRelease()
    if not DHT.LagLimit(math.huge) then DHT.LagLimit(2 ^ 30) end
end

function DHT.LagSet(on)
    local lg = DHT.Lag
    lg.Token = lg.Token + 1
    local my = lg.Token
    if on then
        if not DHT.LagLimit(1) then
            task.defer(function()
                if DHT.LagApi then DHT.LagApi.Set(false) end
                DHT.LagNote.Text = "Not supported by your executor"
            end)
            return
        end
        if lg.Secs <= 0 then
            DHT.LagNote.Text = "Hold mode: lag stays ON until you turn it off"
            return
        end
        DHT.LagNote.Text = "Lag is ON, it releases by itself after " .. lg.Secs .. " seconds"
        task.delay(lg.Secs, function()
            if lg.Token == my and DHT.LagApi and DHT.LagApi.On then
                DHT.LagApi.Set(false)
            end
        end)
    else
        DHT.LagRelease()
        DHT.LagNote.Text = "Others see you frozen while it is ON. Too long can disconnect you."
    end
end

