-- MODS TAB (part 5): Aimbot
-- ================================================
DHMods.Ab = {Size = 150, Smooth = 30, Team = false, Wall = false, Hold = false, Held = false, On = false, Part = "Closest"}
DHMods.AbConns = {}

-- Kill Check (always on): skips dead, dying, removed or downed players
function DHMods.AbAlive(ch, hum)
    if hum.Health <= 0 then return false end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    if not ch:IsDescendantOf(workspace) then return false end
    if not ch:FindFirstChild("HumanoidRootPart") then return false end
    if ch:GetAttribute("Dead") or ch:GetAttribute("Knocked") or ch:GetAttribute("Downed") then return false end
    return true
end

-- which body parts can be aimed at (Head / Body / Closest)
function DHMods.AbParts(ch)
    local mode = DHMods.Ab.Part
    local out = {}
    local function add(p) if p then out[#out + 1] = p end end
    local head = ch:FindFirstChild("Head")
    local root = ch:FindFirstChild("HumanoidRootPart")
    local torso = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or root
    if mode == "Head" then
        add(head)
    elseif mode == "Body" then
        add(torso)
    else
        add(head)
        add(torso)
        add(root)
    end
    return out
end

-- Hitbox (client side). Modes: Box (extra welded part), Torso (real torso part), Root (HumanoidRootPart, like common hitbox scripts).
-- Has its own Team Check and Target Team (separate from the Aimbot ones). The original values live on the part itself (attributes),
-- so turning it off or changing the mode always puts everything back.
DHMods.Hit = {On = false, Size = 8, Mode = "Root", Token = 0, Team = false, TeamPick = "All"}

function DHMods.HitPart(ch, mode)
    if mode == "Root" then
        return ch:FindFirstChild("HumanoidRootPart")
    elseif mode == "Torso" then
        return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
    end
    return nil
end

function DHMods.HitRestorePart(p)
    if not (p and p.Parent) then return end
    if not p:GetAttribute("DH_Hit") then return end
    local sz = p:GetAttribute("DH_OSize")
    local tr = p:GetAttribute("DH_OTrans")
    local cc = p:GetAttribute("DH_OCol")
    if sz then p.Size = sz end
    if tr then p.Transparency = tr end
    if cc ~= nil then p.CanCollide = cc end
    p:SetAttribute("DH_Hit", nil)
    p:SetAttribute("DH_OSize", nil)
    p:SetAttribute("DH_OTrans", nil)
    p:SetAttribute("DH_OCol", nil)
end

-- puts one character back to normal, except the part named in keep (can be nil)
function DHMods.HitClear(ch, keep)
    if not ch then return end
    if keep ~= "Box" then
        local b = ch:FindFirstChild("DH_HitboxPart")
        if b then b:Destroy() end
    end
    local r = ch:FindFirstChild("HumanoidRootPart")
    if r and r ~= keep then DHMods.HitRestorePart(r) end
    local t = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
    if t and t ~= keep then DHMods.HitRestorePart(t) end
end

function DHMods.HitRestoreAll()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then DHMods.HitClear(pl.Character) end
    end
end

-- the part ESP should outline while Hitbox is on (nil = outline the whole character)
function DHMods.HitTarget(ch)
    local h = DHMods.Hit
    if not h.On then return nil end
    if h.Mode == "Box" then return ch:FindFirstChild("DH_HitboxPart") end
    local p = DHMods.HitPart(ch, h.Mode)
    if p and p:GetAttribute("DH_Hit") then return p end
    return nil
end

-- Hitbox has its own team filter (Team Check and Hitbox Target Team), separate from the Aimbot ones
function DHMods.HitTeamSkip(pl)
    local h = DHMods.Hit
    if h.Team and pl.Team ~= nil and pl.Team == Player.Team then return true end
    local pick = h.TeamPick
    if not pick or pick == "All" then return false end
    if not game:GetService("Teams"):FindFirstChild(pick) then return false end
    return pl.Team == nil or pl.Team.Name ~= pick
end

function DHMods.HitStep()
    local h = DHMods.Hit
    local ab = DHMods.Ab
    local s = Vector3.new(h.Size, h.Size, h.Size)
    for _, pl in ipairs(Players:GetPlayers()) do
        local ch = pl.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if root and pl ~= Player then
            local hum = ch:FindFirstChildOfClass("Humanoid")
            local skip = (not hum) or hum.Health <= 0 or DHMods.HitTeamSkip(pl)
            if skip then
                DHMods.HitClear(ch)
            elseif h.Mode == "Box" then
                DHMods.HitClear(ch, "Box") -- anything left from the other modes goes away
                local b = ch:FindFirstChild("DH_HitboxPart")
                if not b then
                    b = Instance.new("Part")
                    b.Name = "DH_HitboxPart"
                    b.Transparency = 0.7
                    b.Color = Color3.fromRGB(255, 70, 70)
                    b.Material = Enum.Material.SmoothPlastic
                    b.CastShadow = false
                    b.CanCollide = false
                    b.CanQuery = true
                    b.CanTouch = true
                    b.Massless = true
                    b.Size = s
                    b.CFrame = root.CFrame
                    local w = Instance.new("WeldConstraint")
                    w.Part0 = root
                    w.Part1 = b
                    w.Parent = b
                    b.Parent = ch
                end
                if b.Size ~= s then b.Size = s end
            else
                local p = DHMods.HitPart(ch, h.Mode)
                DHMods.HitClear(ch, p) -- box and the other mode's part go back to normal
                if p then
                    if not p:GetAttribute("DH_Hit") then
                        p:SetAttribute("DH_OSize", p.Size)
                        p:SetAttribute("DH_OTrans", p.Transparency)
                        p:SetAttribute("DH_OCol", p.CanCollide)
                        p:SetAttribute("DH_Hit", true)
                    end
                    if p.Size ~= s then p.Size = s end
                    p.Transparency = 0.7
                    p.CanCollide = false
                end
            end
        end
    end
end

function DHMods.HitSet(on)
    local h = DHMods.Hit
    h.On = on and true or false
    h.Token = h.Token + 1
    local my = h.Token
    if not h.On then
        DHMods.HitRestoreAll()
        return
    end
    task.spawn(function()
        while h.On and h.Token == my do
            pcall(DHMods.HitStep)
            task.wait(0.2)
        end
    end)
end

-- Target Team: when one team is picked, every player outside that team is skipped
function DHMods.AbTeamSkip(pl)
    local pick = DHMods.Ab.TeamPick
    if not pick or pick == "All" then return false end
    if not game:GetService("Teams"):FindFirstChild(pick) then return false end
    return pl.Team == nil or pl.Team.Name ~= pick
end

function DHMods.AbTarget(free)
    local ab = DHMods.Ab
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local vs = cam.ViewportSize
    local cx, cy = vs.X / 2, vs.Y / 2
    local best, bestD = nil, free and math.huge or ab.Size / 2
    local myChar = Player.Character
    for _, pl in ipairs(Players:GetPlayers()) do
        local ch = pl.Character
        local skip = (pl == Player) or (not ch) or (ab.Team and pl.Team ~= nil and pl.Team == Player.Team) or DHMods.AbTeamSkip(pl)
        if not skip then
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum and DHMods.AbAlive(ch, hum) then
                for _, part in ipairs(DHMods.AbParts(ch)) do
                    local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                    local seen = onScreen and sp.Z > 0
                    if seen or free then
                        local d
                        if seen then
                            d = math.sqrt((sp.X - cx) ^ 2 + (sp.Y - cy) ^ 2)
                        else
                            d = 100000 + (part.Position - cam.CFrame.Position).Magnitude
                        end
                        if d < bestD then
                            local visible = true
                            if ab.Wall then
                                local ex = {ch}
                                if myChar then ex[2] = myChar end
                                local rp = RaycastParams.new()
                                rp.FilterType = Enum.RaycastFilterType.Exclude
                                rp.FilterDescendantsInstances = ex
                                rp.RespectCanCollide = true
                                local o = cam.CFrame.Position
                                visible = (workspace:Raycast(o, part.Position - o, rp) == nil)
                            end
                            if visible then
                                best, bestD = part, d
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

function DHMods.AbStep(dt)
    local ab = DHMods.Ab
    local cam = workspace.CurrentCamera
    if not cam then return end
    local fr = DHMods.AbCircle
    if fr then
        local vs = cam.ViewportSize
        local iy = ScreenGui.IgnoreGuiInset and 0 or game:GetService("GuiService"):GetGuiInset().Y
        fr.Size = UDim2.fromOffset(ab.Size, ab.Size)
        fr.Position = UDim2.fromOffset(vs.X / 2, vs.Y / 2 - iy)
    end
    if ab.Hold and not ab.Held then return end
    local t = DHMods.AbTarget()
    if not t then return end
    local a = math.clamp(1 - ab.Smooth / 100, 0.03, 1)
    a = 1 - (1 - a) ^ (math.min(dt, 0.1) * 60)
    local pos = cam.CFrame.Position
    cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(pos, t.Position), a)
end

