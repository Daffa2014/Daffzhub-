    local alertConns = {}
    local alertSeq = 0
    local alertHolder = Instance.new("Frame", ScreenGui)
    alertHolder.Name = "DH_AlertHolder"
    alertHolder.AnchorPoint = Vector2.new(1, 0)
    alertHolder.Position = UDim2.new(1, -8, 0, 40)
