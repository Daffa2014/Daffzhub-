-- ================================================
-- MUSIC VISUALIZER: RGB bars that move with the loudness of the music you play
-- ================================================
DHViz = {N = 48, Style = 1, Bars = {}, Lvl = 0, Last = 0, Kick = 0}

function DHViz.Build()
    local sec = Instance.new("Frame", MusicScroll)
    sec.Size = UDim2.new(1, 0, 0, 96)
    sec.Position = UDim2.new(0, 0, 0, 310)
    sec.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    sec.ClipsDescendants = true
    Instance.new("UICorner", sec).CornerRadius = UDim.new(0, 8)

    local area = Instance.new("Frame", sec)
    area.Position = UDim2.new(0, 8, 0, 6)
    area.Size = UDim2.new(1, -16, 0, 84)
    area.BackgroundTransparency = 1
    for i = 1, DHViz.N do
        local b = Instance.new("Frame", area)
        b.AnchorPoint = Vector2.new(0.5, 0.5)
        b.Position = UDim2.new((i - 0.5) / DHViz.N, 0, 0.5, 0)
        b.Size = UDim2.new(1 / DHViz.N, -2, 0, 4)
        b.BorderSizePixel = 0
        b.BackgroundColor3 = Color3.new(1, 1, 1)
        Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
        DHViz.Bars[i] = b
    end

    local btn = Instance.new("TextButton", sec)
    btn.Position = UDim2.new(1, -82, 0, 6)
    btn.Size = UDim2.new(0, 74, 0, 18)
    btn.BackgroundColor3 = Color3.new(0, 0, 0)
    btn.BackgroundTransparency = 0.4
    btn.Text = "Style: Bars"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.ZIndex = 3
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    btn.MouseButton1Click:Connect(function()
        DHViz.Style = (DHViz.Style == 1) and 2 or 1
        btn.Text = (DHViz.Style == 1) and "Style: Bars" or "Style: Wave"
    end)

    local t, acc = 0, 0
    DHViz.Conn = RunService.Heartbeat:Connect(function(dt)
        if not (MusicContent and MusicContent.Visible) then return end
        t = t + dt
        acc = acc + dt
        if acc < 1 / 30 then return end
        local step = acc
        acc = 0

        local snd = CurrentSound
        local loud = 0
        if snd and snd.Parent and snd.IsPlaying then loud = snd.PlaybackLoudness end
        local target = math.clamp(loud / 450, 0, 1)
        -- rises fast, falls slowly
        local k = (target > DHViz.Lvl) and 0.5 or 0.12
        DHViz.Lvl = DHViz.Lvl + (target - DHViz.Lvl) * math.min(1, k * step * 60)
        DHViz.Kick = math.max(math.clamp((loud - DHViz.Last) / 120, 0, 1), DHViz.Kick - step * 3)
        DHViz.Last = loud

        -- history of the loudness: the middle is "now", the sides are the last moments, so the bars follow the real music
        local H = 40
        local hist = DHViz.Hist
        if not hist then
            hist = {}
            for j = 1, H do hist[j] = 0 end
            DHViz.Hist = hist
        end
        -- soft scale: boosted bass makes the bars longer, and the Volume setting scales them too
        local vol = 1
        if snd and snd.Parent then vol = math.clamp(snd.Volume, 0.1, 1) ^ 0.6 end
        table.insert(hist, 1, (1 - math.exp(-loud / 600)) * vol)
        hist[H + 1] = nil

        local n = DHViz.N
        local bars = DHViz.Style == 1
        for i = 1, n do
            local b = DHViz.Bars[i]
            local x = (i - 0.5) / n
            -- 0 in the middle, 1 at the sides
            local d = math.abs(x - 0.5) * 2
            local p = 1 + d * (H - 1)
            local a = math.floor(p)
            local f = p - a
            local v1 = hist[a] or 0
            local v2 = hist[math.min(H, a + 1)] or 0
            local h = v1 + (v2 - v1) * f
            if bars then
                b.Visible = (i % 2 == 0)
                h = h ^ 0.9
            else
                b.Visible = true
            end
            h = math.clamp(h, 0, 1)
            if b.Visible then
                b.Size = UDim2.new((bars and 2 or 1) / n, -2, 0, 4 + h * 76)
                b.BackgroundColor3 = Color3.fromHSV((t * 0.12 + x) % 1, 0.9, 1)
            end
        end
    end)

    ScreenGui.Destroying:Connect(function()
        if DHViz.Conn then DHViz.Conn:Disconnect() end
    end)
end
pcall(DHViz.Build)

