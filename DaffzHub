-- ---------- servers ----------
function DHJ.LoadServers()
    if DHJ.SBusy then return end
    DHJ.SBusy = true
    DHJ.SStatus.Text = "Loading servers..."
    task.spawn(function()
        pcall(function()
            local placeId = tonumber(DHJ.PlaceBox.Text) or game.PlaceId
            local order = (DHJ.Sort == 2) and "Desc" or "Asc"
            local data = DHJ.Json("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=" .. order .. "&limit=100")
            if not (data and type(data.data) == "table") then
                DHJ.SStatus.Text = "Could not load servers, try again"
                return
            end
            local list = {}
            for _, s in ipairs(data.data) do
                -- full servers cannot be joined, so they are left out
                if s.id and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
                    list[#list + 1] = s
                end
            end
            if DHJ.Sort == 1 then
                table.sort(list, function(a, b) return a.playing < b.playing end)
            elseif DHJ.Sort == 2 then
                table.sort(list, function(a, b) return a.playing > b.playing end)
            else
                table.sort(list, function(a, b) return (a.ping or 9999) < (b.ping or 9999) end)
            end

            DHJ.Clear(DHJ.SList)
            for _, s in ipairs(list) do
                local text = string.format("%d/%d   %s   %s", s.playing, s.maxPlayers,
                    s.ping and (math.floor(s.ping) .. " ms") or "- ms", string.sub(s.id, 1, 8))
                if s.id == game.JobId then text = text .. "  (this)" end
                local id = s.id
                DHJ.Row(DHJ.SList, text, {
                    {"Copy", Color3.fromRGB(45, 90, 160), function()
                        if setclipboard then pcall(setclipboard, id) end
                    end},
                    {"Join", Color3.fromRGB(40, 170, 80), function()
                        ShowConfirmPopup("Join this server?", Color3.fromRGB(30, 170, 60), function()
                            pcall(function()
                                game:GetService("TeleportService"):TeleportToPlaceInstance(placeId, id, Player)
                            end)
                        end)
                    end},
                })
            end
            DHJ.SStatus.Text = (#list == 0) and "No open servers found" or ("Found " .. #list .. " open servers")
        end)
        DHJ.SBusy = false
    end)
end

-- ---------- maps ----------
function DHJ.FindMaps(q)
    local HS = game:GetService("HttpService")
    local out, ids, meta = {}, {}, {}

    if q:match("^%d+$") then
        -- a number is taken as a place id
        return {{name = "Place ID " .. q, place = tonumber(q)}}
    end

    local data = DHJ.Json("https://apis.roblox.com/search-api/omni-search?verticalType=Game&searchQuery="
        .. HS:UrlEncode(q) .. "&pageType=all&sessionId=" .. HS:GenerateGUID(false))
    if data and type(data.searchResults) == "table" then
        for _, g in ipairs(data.searchResults) do
            if type(g.contents) == "table" and (g.contentGroupType == nil or g.contentGroupType == "Game") then
                for _, c in ipairs(g.contents) do
                    local uid = tonumber(c.universeId or c.contentId)
                    if uid and not meta[uid] and #ids < 20 then
                        ids[#ids + 1] = uid
                        meta[uid] = {name = c.name, playing = tonumber(c.playerCount), place = tonumber(c.rootPlaceId)}
                    end
                end
            end
        end
    end

    if #ids > 0 then
        -- the search gives universes, this turns them into places to join
        local det = DHJ.Json("https://games.roblox.com/v1/games?universeIds=" .. table.concat(ids, ","))
        local byId = {}
        if det and type(det.data) == "table" then
            for _, d in ipairs(det.data) do
                byId[tonumber(d.id)] = d
            end
        end
        for _, uid in ipairs(ids) do
            local d, m = byId[uid], meta[uid]
            local place = (d and tonumber(d.rootPlaceId)) or m.place
            if place then
                out[#out + 1] = {
                    name = (d and d.name) or m.name or "Unknown",
                    place = place,
                    playing = (d and tonumber(d.playing)) or m.playing or 0,
                }
            end
        end
    end

    if #out == 0 then
        -- older search endpoint as a fallback
        local old = DHJ.Json("https://games.roblox.com/v1/games/list?model.keyword=" .. HS:UrlEncode(q)
            .. "&model.startRows=0&model.maxRows=20")
        if old and type(old.games) == "table" then
            for _, g in ipairs(old.games) do
                local place = tonumber(g.placeId)
                if place then
                    out[#out + 1] = {name = g.name or "Unknown", place = place, playing = tonumber(g.playerCount) or 0}
                end
            end
        end
    end

    table.sort(out, function(a, b) return (a.playing or 0) > (b.playing or 0) end)
    return out
end

function DHJ.SearchMaps()
    if DHJ.MBusy then return end
    local q = DHJ.MapBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if q == "" then
        DHJ.MStatus.Text = "Type a map name first"
        return
    end
    DHJ.MBusy = true
    DHJ.MStatus.Text = "Searching..."
    task.spawn(function()
        pcall(function()
            local ok, res = pcall(DHJ.FindMaps, q)
            DHJ.Clear(DHJ.MList)
            if not ok or type(res) ~= "table" then
                DHJ.MStatus.Text = "Could not search, try again"
                return
            end
            if #res == 0 then
                DHJ.MStatus.Text = "No maps found"
                return
            end
            for _, m in ipairs(res) do
                local text = m.name
                if m.playing then text = text .. "   " .. DHJ.Count(m.playing) .. " playing" end
                DHJ.Row(DHJ.MList, text, {
                    {"Servers", Color3.fromRGB(45, 90, 160), function()
                        -- show the servers of this map in the Server Browser above
                        DHJ.PlaceBox.Text = tostring(m.place)
                        JoinerScroll.CanvasPosition = Vector2.new(0, DHJ.ServerPanel.Position.Y.Offset)
                        DHJ.LoadServers()
                    end},
                    {"Join", Color3.fromRGB(40, 170, 80), function()
                        ShowConfirmPopup("Join " .. m.name .. "?", Color3.fromRGB(30, 170, 60), function()
                            pcall(function()
                                game:GetService("TeleportService"):Teleport(m.place, Player)
                            end)
                        end)
                    end},
                })
            end
            DHJ.MStatus.Text = "Found " .. #res .. " maps"
        end)
        DHJ.MBusy = false
    end)
end

