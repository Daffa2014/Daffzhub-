-- ================================================
-- ONE POPUP AT A TIME
-- Every confirmation popup is a big Frame in the ScreenGui (ZIndex 10, or 200 for the countdown one).
-- When a new popup appears, the older ones are removed, so one Cancel is always enough.
-- ================================================
function DHIsPopup(f)
    if not f:IsA("Frame") then return false end
    if f.Size.X.Offset < 200 or f.Size.Y.Offset < 100 then return false end
    return f.ZIndex == 10 or f.ZIndex == 200
end

ScreenGui.ChildAdded:Connect(function(child)
    if not child:IsA("Frame") then return end
    task.defer(function() -- wait until the code that created the popup has finished setting it up
        if child.Parent ~= ScreenGui or not DHIsPopup(child) then return end
        for _, other in ipairs(ScreenGui:GetChildren()) do
            if other ~= child and DHIsPopup(other) then
                other:Destroy()
            end
        end
    end)
end)

