    local tr = e.Tracks[key]
    if tr then return tr end
    local animator = e.Hum:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    local an = Instance.new("Animation")
    an.AnimationId = id
    local ok, t = pcall(function() return animator:LoadAnimation(an) end)
    if not ok or not t then return nil end
    t.Looped = looped and true or false
    if prio then t.Priority = prio end
    e.Tracks[key] = t
    return t
end

function DHDum.Spawn()
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = hum and hum.RootPart
    if not (hum and root) or hum.Health <= 0 then
        DHDum.Say("No character")
        return
    end
    if #DHDum.List >= 10 then
        DHDum.Say("Maximum 10 dummies")
        return
    end
    local cf = root.CFrame
    task.spawn(function()
        local d = Instance.new("HumanoidDescription")
        local gray = Color3.fromRGB(163, 162, 165)
        d.HeadColor = gray
        d.TorsoColor = gray
        d.LeftArmColor = gray
        d.RightArmColor = gray
        d.LeftLegColor = gray
        d.RightLegColor = gray
        d.Face = 144075659
        d.BodyTypeScale = 0
        d.ProportionScale = 0
        local ok, m = pcall(function() return Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15) end)
        d:Destroy()
        if not ok or not m then
            DHDum.Say("Could not make a dummy")
            return
        end
        m.Name = "DaffzDummy"
        for _, x in ipairs(m:GetDescendants()) do
            if x:IsA("BaseScript") or x:IsA("Sound") then pcall(function() x:Destroy() end) end
        end
        local h = m:FindFirstChildOfClass("Humanoid")
        local r = m:FindFirstChild("HumanoidRootPart")
        if not (h and r) then
            m:Destroy()
            DHDum.Say("Could not make a dummy")
            return
        end
        h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        h.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        -- the lowest free number, so a removed Dummy 1 is used again
        local n = 1
        local taken = true
        while taken do
            taken = false
            for _, x in ipairs(DHDum.List) do
                if x.Id == n then
                    taken = true
                    n = n + 1
                    break
                end
            end
        end
        local a = n * 1.3
        local pos = cf.Position + Vector3.new(math.cos(a) * 4, 0, math.sin(a) * 4)
        m.Parent = workspace
        m:PivotTo(CFrame.new(pos) * (cf - cf.Position))

        local animator = h:FindFirstChildOfClass("Animator") or Instance.new("Animator", h)
        local entry = {Id = n, Name = "Dummy " .. n, Model = m, Hum = h, Root = r, Tracks = {}, Home = pos}
        DHDum.List[#DHDum.List + 1] = entry
        for key, id in pairs(DHDum.Anims) do
            DHDum.Track(entry, key, id, key ~= "jump")
        end
        DHDum.Start()
        DHDum.Fill()
        DHDum.Say(entry.Name .. " spawned (only you can see it)")
    end)
end

-- plays the picked emote on the controlled dummy (or on all dummies when none is controlled)
function DHDum.PlayEmote()
    local id = DHDum.EmoteIds[DHDum.EmoteSel]
    if not id then return end
    local targets = DHDum.Ctl and {DHDum.Ctl} or DHDum.List
    if #targets == 0 then
        DHDum.Say("Spawn a dummy first")
        return
    end
    local loop = string.sub(DHDum.EmoteSel, 1, 5) == "Dance"
    for _, e in ipairs(targets) do
      local tr = DHDum.Track(e, "emote_" .. DHDum.EmoteSel, "rbxassetid://" .. id, loop, Enum.AnimationPriority.Action)
        if tr then
            if e.Emote and e.Emote ~= tr then pcall(function() e.Emote:Stop(0.15) end) end
            local cur = e.Tracks[e.Cur]
            if cur then cur:Stop(0.15) end
            e.Cur = nil
            e.Emote = tr
            e.EmoteT = os.clock()
            tr:Play(0.15)
        end
    end
    DHDum.Say(DHDum.EmoteSel .. " playing")
end

function DHDum.StopEmote()
    local targets = DHDum.Ctl and {DHDum.Ctl} or DHDum.List
    for _, e in ipairs(targets) do
        if e.Emote then
            pcall(function() e.Emote:Stop(0.15) end)
            e.Emote = nil
        end
    end
    DHDum.Say("Emote stopped")
end

function DHDum.Anim(e)
    local h, r = e.Hum, e.Root
    local moving = h.MoveDirection.Magnitude > 0.1
    local air = h.FloorMaterial == Enum.Material.Air

    -- an emote keeps playing until it ends, or until the controlled dummy moves / leaves the ground
    local et = e.Emote
    if et then
        local cancel = DHDum.Ctl == e and (moving or air)
        local fresh = os.clock() - (e.EmoteT or 0) < 0.8
        if (et.IsPlaying or fresh) and not cancel then return end
        pcall(function() et:Stop(0.2) end)
        e.Emote = nil
    end

    local st = h:GetState()
    local state
    if e.Climb or st == Enum.HumanoidStateType.Climbing then
        state = "climb"
    elseif st == Enum.HumanoidStateType.Swimming then
        state = moving and "swim" or "swimidle"
    elseif air then
        state = r.AssemblyLinearVelocity.Y > 1 and "jump" or "fall"
    else
        state = moving and "walk" or "idle"
    end
    -- fall back to a simpler animation when this one failed to load
    if not e.Tracks[state] then
        if state == "swimidle" then state = "swim" end
        if state == "swim" and not e.Tracks.swim then state = "fall" end
        if state == "climb" and not e.Tracks.climb then state = "idle" end
    end
    if state ~= e.Cur then
        local old = e.Tracks[e.Cur]
        if old then old:Stop(0.15) end
        local new = e.Tracks[state]
        if new then new:Play(0.15) end
        e.Cur = state
    end
    if state == "walk" and e.Tracks.walk then
        e.Tracks.walk:AdjustSpeed(math.max(0.3, h.WalkSpeed / 16))
    elseif state == "climb" and e.Tracks.climb then
        -- the climb pose freezes while the dummy hangs still
        e.Tracks.climb:AdjustSpeed(math.abs(r.AssemblyLinearVelocity.Y) > 1 and 1 or 0)
    end
end

-- ladder help for the controlled dummy: real TrussParts already work, this also covers
-- ladder-shaped parts (named ladder / climb / rung / ...) that games build from normal parts
function DHDum.Assist(e, md)
    local h, r = e.Hum, e.Root
    if h:GetState() == Enum.HumanoidStateType.Climbing then
        e.Climb = false
        return
    end
    local moving = md.Magnitude > 0.1
    local dir = moving and Vector3.new(md.X, 0, md.Z) or Vector3.new(r.CFrame.LookVector.X, 0, r.CFrame.LookVector.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local ign = {e.Model}
    if Player.Character then ign[#ign + 1] = Player.Character end
    for _, x in ipairs(DHDum.List) do ign[#ign + 1] = x.Model end
    rp.FilterDescendantsInstances = ign

    local hit = workspace:Raycast(r.Position, dir * 2.4, rp)
    local ladder = false
    if hit and hit.Instance then
        local p = hit.Instance
        if p:IsA("TrussPart") then
            ladder = true
        else
            local nm = string.lower(p.Name .. " " .. (p.Parent and p.Parent.Name or ""))
            for _, w in ipairs(DHDum.ClimbWords) do
                if string.find(nm, w, 1, true) then
                    ladder = true
                    break
                end
            end
        end
    end

    if ladder then
        local into = moving and (-hit.Normal):Dot(dir) or 0
        if into > 0.3 then
            -- walking into the ladder: go up
            r.AssemblyLinearVelocity = Vector3.new(0, math.clamp(h.WalkSpeed * 0.8, 6, 40), 0) + (-hit.Normal) * 3
            e.Climb = true
        elseif e.Climb and not moving then
            -- let go of the stick: hang on the ladder
            r.AssemblyLinearVelocity = Vector3.zero
        else
            e.Climb = false
        end
    else
        if e.Climb and moving then
            -- reached the top: hop over the edge
            r.AssemblyLinearVelocity = Vector3.new(dir.X * h.WalkSpeed * 0.6, 14, dir.Z * h.WalkSpeed * 0.6)
        end
        e.Climb = false
    end
end

function DHDum.EspDrop(e)
    for _, k in ipairs({"Hl", "Tag", "Ln"}) do
        if e[k] then
            pcall(function() e[k]:Destroy() end)
            e[k] = nil
        end
    end
    e.NameLbl, e.DistLbl, e.LastD = nil, nil, nil
end

function DHDum.EspKill()
    for _, k in ipairs({"Tags", "Lines"}) do
        if DHDum[k] then
            pcall(function() DHDum[k]:Destroy() end)
            DHDum[k] = nil
        end
    end
end

-- Highlight / NameTag / Distance / Line for every dummy (the one you control is skipped, like your own player)
function DHDum.EspUpdate()
    local E = DHDum.Esp
    local cam = workspace.CurrentCamera
    if not cam then return end
    local any = E.On or E.Line or E.Dist or E.Name
    local par = ScreenGui.Parent
    if any and par then
        if not DHDum.Tags or not DHDum.Tags.Parent then
            DHDum.Tags = Instance.new("Folder")
            DHDum.Tags.Name = "DH_DUMMY_Tags"
            DHDum.Tags.Parent = par
        end
        if not DHDum.Lines or not DHDum.Lines.Parent then
            local g = Instance.new("ScreenGui")
            g.Name = "DH_DUMMY_Lines"
            g.ResetOnSpawn = false
            g.IgnoreGuiInset = true
            g.DisplayOrder = -1
            g.Parent = par
            DHDum.Lines = g
        end
    end

    -- distance is measured from the dummy you control, or from your own body
    local from = cam.CFrame.Position
    if DHDum.Ctl then
        from = DHDum.Ctl.Root.Position
    else
        local mine = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if mine then from = mine.Position end
    end
    local col = DHDum.EspColor

    for _, e in ipairs(DHDum.List) do
        if not any or DHDum.Ctl == e then
            if e.Hl or e.Tag or e.Ln then DHDum.EspDrop(e) end
        else
            -- Highlight
            if E.On then
                local hl = e.Hl
                if not hl or hl.Parent ~= e.Model then
                    if hl then hl:Destroy() end
                    hl = Instance.new("Highlight")
                    hl.Name = "DH_DUMMY_HL"
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = e.Model
                    hl.Parent = e.Model
                    e.Hl = hl
                end
                hl.Enabled = true
                hl.FillColor = col
                hl.OutlineColor = col
                hl.OutlineTransparency = 0
                hl.FillTransparency = (E.Style == "Filled") and 0.5 or 1
            elseif e.Hl then
                e.Hl.Enabled = false
            end

            -- NameTag + Distance
            if (E.Name or E.Dist) and DHDum.Tags then
                local tag = e.Tag
                if not tag or not tag.Parent then
                    tag = Instance.new("BillboardGui")
                    tag.Name = "DH_DUMMY_Tag"
                    tag.AlwaysOnTop = true
                    tag.Size = UDim2.new(0, 140, 0, 36)
                    tag.StudsOffset = Vector3.new(0, 2.6, 0)
                    tag.LightInfluence = 0
                    tag.ResetOnSpawn = false
                    local nl = Instance.new("TextLabel", tag)
                    nl.Size = UDim2.new(1, 0, 0, 18)
                    nl.BackgroundTransparency = 1
                    nl.Font = Enum.Font.GothamBold
                    nl.TextSize = 14
                    nl.TextStrokeTransparency = 0.3
                    local dl = Instance.new("TextLabel", tag)
                    dl.Size = UDim2.new(1, 0, 0, 14)
                    dl.BackgroundTransparency = 1
                    dl.Font = Enum.Font.Gotham
                    dl.TextSize = 12
                    dl.TextColor3 = Color3.new(1, 1, 1)
                    dl.TextStrokeTransparency = 0.3
                    tag.Parent = DHDum.Tags
                    e.Tag, e.NameLbl, e.DistLbl = tag, nl, dl
                end
                tag.Adornee = e.Model:FindFirstChild("Head") or e.Root
                e.NameLbl.Visible = E.Name
                e.NameLbl.Text = e.Name
                e.NameLbl.TextColor3 = col
                e.DistLbl.Visible = E.Dist
                e.DistLbl.Position = UDim2.new(0, 0, 0, E.Name and 18 or 0)
                if E.Dist then
                    local dist = math.floor((from - e.Root.Position).Magnitude + 0.5)
                    if dist ~= e.LastD then
                        e.LastD = dist
                        e.DistLbl.Text = dist .. "m"
                    end
                end
            elseif e.Tag then
                e.Tag:Destroy()
                e.Tag, e.NameLbl, e.DistLbl = nil, nil, nil
            end

            -- Line from the bottom of the screen
            if E.Line and DHDum.Lines then
                local f = e.Ln
                if not f or not f.Parent then
                    f = Instance.new("Frame")
                    f.Name = "L"
                    f.AnchorPoint = Vector2.new(0.5, 0.5)
                    f.BorderSizePixel = 0
                    f.BackgroundTransparency = 0.15
                    f.Size = UDim2.new(0, 0, 0, 2)
                    f.Visible = false
                    f.Parent = DHDum.Lines
                    e.Ln = f
                end
                f.BackgroundColor3 = col
                local v, onScreen = cam:WorldToViewportPoint(e.Root.Position)
                if onScreen and v.Z > 0 then
                    local vs = cam.ViewportSize
                    local a = Vector2.new(vs.X / 2, vs.Y)
                    local b = Vector2.new(v.X, v.Y)
                    local dv = b - a
                    f.Size = UDim2.new(0, dv.Magnitude, 0, 2)
                    f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
                    f.Rotation = math.deg(math.atan2(dv.Y, dv.X))
                    f.Visible = true
                else
                    f.Visible = false
                end
            elseif e.Ln then
                e.Ln:Destroy()
                e.Ln = nil
            end
        end
    end
end

function DHDum.Step()
    local changed = false
    for i = #DHDum.List, 1, -1 do
        local e = DHDum.List[i]
        if not (e.Model and e.Model.Parent and e.Hum.Parent and e.Root.Parent) then
            if DHDum.Ctl == e then DHDum.Release() end
            DHDum.EspDrop(e)
            table.remove(DHDum.List, i)
            changed = true
        end
    end
    if changed then DHDum.Fill() end

    local c = DHDum.Ctl
    if c then
        local char, hum = DHDum.Char, DHDum.RHum
        -- your real body died or was replaced: give the camera back
        if Player.Character ~= char or not hum or not hum.Parent or hum.Health <= 0 then
            DHDum.Release(true)
        else
            local rr = char:FindFirstChild("HumanoidRootPart")
            if rr and not rr.Anchored then rr.Anchored = true end
            local cam = workspace.CurrentCamera
            if cam and cam.CameraSubject ~= c.Hum then cam.CameraSubject = c.Hum end
            c.Hum.WalkSpeed = DHDum.Speed
            c.Hum:Move(hum.MoveDirection, false)
            if hum.Jump then c.Hum.Jump = true end
            pcall(DHDum.Assist, c, hum.MoveDirection)
        end
    end

    for _, e in ipairs(DHDum.List) do
        if e.Root.Position.Y < workspace.FallenPartsDestroyHeight + 50 then
            e.Model:PivotTo(CFrame.new(e.Home + Vector3.new(0, 3, 0)))
            e.Root.AssemblyLinearVelocity = Vector3.zero
        end
        DHDum.Anim(e)
    end
    pcall(DHDum.EspUpdate)

    if #DHDum.List == 0 and not DHDum.Ctl and DHDum.Conn then
        DHDum.Conn:Disconnect()
        DHDum.Conn = nil
    end
end

function DHDum.Start()
    if DHDum.Conn then return end
    DHDum.Conn = RunService.Heartbeat:Connect(function()
        pcall(DHDum.Step)
    end)
end

function DHDum.Control(e)
    if DHInv and DHInv.Active then
        DHDum.Say("Turn off Invisible first")
        return
    end
    if DHMods.FlyActive or DHMods.WwActive then
        DHDum.Say("Turn off Fly / Wall Walk first")
        return
    end
    if DHSafeState and DHSafeState() then
        DHDum.Say("Turn off Safe Zone first")
        return
    end
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local rr = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and rr) or hum.Health <= 0 then
        DHDum.Say("No character")
        return
    end
    if not DHDum.Ctl then
        DHDum.Char, DHDum.RHum = char, hum
        rr.Anchored = true
        DHDum.JumpConn = UIS.JumpRequest:Connect(function()
            if DHDum.Ctl then DHDum.Ctl.Hum.Jump = true end
        end)
    else
        pcall(function() DHDum.Ctl.Hum:Move(Vector3.zero, false) end)
    end
    DHDum.Ctl = e
    DHDum.Start()
    DHDum.Fill()
    DHDum.Say("Controlling " .. e.Name)
end

-- back to your own body (gone = your real body was already replaced)
function DHDum.Release(gone)
    if not DHDum.Ctl then return end
    local c = DHDum.Ctl
    DHDum.Ctl = nil
    c.Climb = false
    if DHDum.JumpConn then
        DHDum.JumpConn:Disconnect()
        DHDum.JumpConn = nil
    end
    pcall(function() c.Hum:Move(Vector3.zero, false) end)
    local char = DHDum.Char
    DHDum.Char, DHDum.RHum = nil, nil
    if not gone and char then
        local rr = char:FindFirstChild("HumanoidRootPart")
        if rr then
            rr.AssemblyLinearVelocity = Vector3.zero
            rr.Anchored = false
        end
    end
    pcall(function()
        local cam = workspace.CurrentCamera
        local h = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
        if cam and h then
            cam.CameraType = Enum.CameraType.Custom
            cam.CameraSubject = h
        end
    end)
    DHDum.Fill()
    DHDum.Say("Back in your own body")
end

function DHDum.Remove(e)
    if DHDum.Ctl == e then DHDum.Release() end
    for i, x in ipairs(DHDum.List) do
        if x == e then
            table.remove(DHDum.List, i)
            break
        end
    end
    for _, tr in pairs(e.Tracks) do pcall(function() tr:Stop(0) end) end
    DHDum.EspDrop(e)
    pcall(function() e.Model:Destroy() end)
    DHDum.Fill()
    DHDum.Say(e.Name .. " removed")
end

function DHDum.Clear()
    DHDum.Release()
    for i = #DHDum.List, 1, -1 do
        local e = DHDum.List[i]
        for _, tr in pairs(e.Tracks) do pcall(function() tr:Stop(0) end) end
        DHDum.EspDrop(e)
        pcall(function() e.Model:Destroy() end)
        table.remove(DHDum.List, i)
    end
    DHDum.EspKill()
    DHDum.Fill()
end

