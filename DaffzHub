            if not DHW.Death then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            local cf = root and root.CFrame
            if (not cf or cf.Position.Y < workspace.FallenPartsDestroyHeight + 50) and DHW.Safe then
                cf = DHW.Safe
            end
