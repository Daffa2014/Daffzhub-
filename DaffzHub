    Add("Sun Rays Intensity", 0, 1, 2, rays, "Intensity", 0)
    Add("Sun Rays Spread", 0, 1, 2, rays, "Spread", 0.5)

    Add("Color Brightness", -1, 1, 2, cc, "Brightness", 0)
    Add("Color Contrast", -1, 1, 2, cc, "Contrast", 0)
    Add("Color Saturation", -1, 1, 2, cc, "Saturation", 0)

    Add("Blur Size", 0, 56, 0, blur, "Size", 0)

    Add("Bloom Intensity", 0, 1, 2, bloom, "Intensity", 0)
    Add("Bloom Size", 0, 56, 0, bloom, "Size", 24)
