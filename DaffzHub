                PopulateWaypointList(WaypointSearch.Text)
            end
        end)
    end)
end

-- every frame: remember the spot before a teleport (any source), keep the marker distances fresh
function DHW.Step(dt)
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then
        DHW.Prev = nil
        return
    end
    if hum.Health > 0 then
        local pos = root.Position
        if DHW.Prev then
            local lim = 25 + root.AssemblyLinearVelocity.Magnitude * dt * 2 + 100 * dt
            if (pos - DHW.Prev.Position).Magnitude > lim then
                DHW.Back = DHW.Prev
            end
        end
        DHW.Prev = root.CFrame
        if hum.FloorMaterial ~= Enum.Material.Air then DHW.Safe = root.CFrame end
    end

    DHW.T = DHW.T + dt
    if DHW.T >= 0.25 and DHW.Labels then
        DHW.T = 0
        for _, e in ipairs(DHW.Labels) do
            if e[1].Parent then
                e[1].Text = e[2] .. "\n" .. math.floor((e[3] - root.Position).Magnitude) .. " studs"
            end
        end
    end
end

function DHW.GoBack()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (root and DHW.Back) then
        DHW.BackBtn.Text = "No spot yet"
        task.delay(1.2, function() DHW.BackBtn.Text = "Back" end)
        return
    end
    local target = DHW.Back
    DHW.Back = root.CFrame
    pcall(function()
        Player:RequestStreamAroundAsync(target.Position, 5)
    end)
    root.CFrame = target
    root.AssemblyLinearVelocity = Vector3.zero
    DHW.Prev = target
end

