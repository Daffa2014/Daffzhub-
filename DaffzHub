ERefreshSavedPanel = function()
    for _, child in ipairs(ESavedScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local search = ESavedSearch.Text:lower()
    local filtered = {}
    for _, v in ipairs(EmoteSavedList) do
        if search == "" or (v.Name and v.Name:lower():find(search, 1, true)) then
            table.insert(filtered, v)
        end
    end
    table.sort(filtered, function(a, b)
        if a.Favorite ~= b.Favorite then return a.Favorite end
        return false
    end)
    ESavedEmptyLabel.Visible = #filtered == 0
    for _, v in ipairs(filtered) do
        EBuildSavedCard(v)
    end
end

