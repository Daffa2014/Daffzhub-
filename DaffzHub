function DoSpectate(target)
    if not target or not target.Character then
        -- Tunggu character load dulu
        task.spawn(function()
            local char = target.Character or target.CharacterAdded:Wait()
            char:WaitForChild("HumanoidRootPart", 5)
            DoSpectate(target)
        end)
        return
    end

    -- Pastikan Humanoid juga ready, bukan cuma HumanoidRootPart
    local targetHumanoid = target.Character:FindFirstChildOfClass("Humanoid")
    if not targetHumanoid then
        task.spawn(function()
            local char = target.Character
            if char then
                targetHumanoid = char:WaitForChild("Humanoid", 5)
            end
            if targetHumanoid then
                DoSpectate(target)
            end
        end)
        return
    end

    CurrentSpectateTarget = target
    SelectedSpectatePlayer = target
    SpectateBtn.Text = "Unspectate"

-- Maksa area target di-stream duluan (non-blocking, biar navigasi tetap instan)
    task.spawn(function()
        pcall(function()
            local rootPart = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                Player:RequestStreamAroundAsync(rootPart.Position, 5)
            end
        end)
    end)

if workspace.CurrentCamera then
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        workspace.CurrentCamera.CameraSubject = targetHumanoid
    end

    -- Kalau target respawn saat masih di-spectate, otomatis ikuti karakter barunya
    local respawnConn
    respawnConn = target.CharacterAdded:Connect(function(newChar)
        if CurrentSpectateTarget ~= target then
            respawnConn:Disconnect()
            return
        end
        local newHumanoid = newChar:WaitForChild("Humanoid", 5)
        if newHumanoid and CurrentSpectateTarget == target and workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = newHumanoid
        end
    end)

-- Kalau PLAYER SENDIRI mati/respawn saat masih spectate, paksa kamera tetap ke target
    if SelfRespawnConn then
        SelfRespawnConn:Disconnect()
        SelfRespawnConn = nil
    end
    SelfRespawnConn = Player.CharacterAdded:Connect(function()
        if CurrentSpectateTarget ~= target then
            if SelfRespawnConn then
                SelfRespawnConn:Disconnect()
                SelfRespawnConn = nil
