    -- 6. HIDE PLAYER (other players only, visual only, local to you)
    -- Original values are stored as attributes on the objects themselves.
    -- A check every second also catches characters that were streamed out and back in.
    ------------------------------------------------
    local hideOn = false
    local hideToken = 0
    local hideConns = {}

    local function HideObj(o)
        if o:IsA("BasePart") then
            if o:GetAttribute("DH_Hide") == nil then o:SetAttribute("DH_Hide", o.LocalTransparencyModifier) end
            o.LocalTransparencyModifier = 1
        elseif o:IsA("Decal") or o:IsA("Texture") then
            if o:GetAttribute("DH_Hide") == nil then o:SetAttribute("DH_Hide", o.Transparency) end
            o.Transparency = 1
        elseif o:IsA("BillboardGui") then
            if o:GetAttribute("DH_Hide") == nil then o:SetAttribute("DH_Hide", o.Enabled and 1 or 0) end
            o.Enabled = false
        elseif o:IsA("Humanoid") then
            if o:GetAttribute("DH_Hide") == nil then o:SetAttribute("DH_Hide", o.DisplayDistanceType.Value) end
            o.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end
    end

    local function ShowObj(o)
        local orig = o:GetAttribute("DH_Hide")
        if orig == nil then return end
        if o:IsA("BasePart") then
            o.LocalTransparencyModifier = orig
        elseif o:IsA("Decal") or o:IsA("Texture") then
            o.Transparency = orig
        elseif o:IsA("BillboardGui") then
            o.Enabled = (orig == 1)
        elseif o:IsA("Humanoid") then
            pcall(function()
                o.DisplayDistanceType = Enum.HumanoidDisplayDistanceType:FromValue(orig)
            end)
        end
        o:SetAttribute("DH_Hide", nil)
    end

    local function HideCharacter(char)
        for _, o in ipairs(char:GetDescendants()) do
            HideObj(o)
        end
        table.insert(hideConns, char.DescendantAdded:Connect(function(o)
            if hideOn then HideObj(o) end
        end))
    end

    local function HideOnePlayer(plr)
        if plr == Player then return end
        if plr.Character then HideCharacter(plr.Character) end
        table.insert(hideConns, plr.CharacterAdded:Connect(function(c)
            if hideOn then HideCharacter(c) end
        end))
    end

    local function HideSweep()
        if not hideOn then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player and plr.Character then
                for _, o in ipairs(plr.Character:GetDescendants()) do
                    HideObj(o)
                end
            end
        end
    end

    local function SetHidePlayer(on)
        hideOn = on
        hideToken = hideToken + 1
        local myToken = hideToken
        for _, c in ipairs(hideConns) do c:Disconnect() end
        hideConns = {}
        if on then
            for _, plr in ipairs(Players:GetPlayers()) do
                HideOnePlayer(plr)
            end
            table.insert(hideConns, Players.PlayerAdded:Connect(function(plr)
                if hideOn then HideOnePlayer(plr) end
            end))
                                        task.spawn(function()
                while hideOn and hideToken == myToken do
                    task.wait(1)
                    if not hideOn or hideToken ~= myToken then break end
                    pcall(HideSweep)
                end
            end)
        else
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= Player and plr.Character then
                    for _, o in ipairs(plr.Character:GetDescendants()) do
