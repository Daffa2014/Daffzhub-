    local hit = Instance.new("TextButton", sec)
    hit.Position = UDim2.new(0, 10, 0, y + 14)
    hit.Size = UDim2.new(1, -20, 0, 28)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    local function setFrom(x)
        local r = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
        local v = lo + r * (hi - lo)
        v = math.floor(v / step + 0.5) * step
        DHFx.S[key] = tonumber(string.format("%.3f", math.clamp(v, lo, hi)))
        show()
        DHFx.Mark(nil)
        DHFx.Apply()
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
