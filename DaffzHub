DHFx = DHFx or {}
DHFx.mbStrength = 50

function DHFx.MotionBlur(on)
    if DHFx.mbConn then
        DHFx.mbConn:Disconnect()
        DHFx.mbConn = nil
    end
    local L = game:GetService("Lighting")
    local old = L:FindFirstChild("DH_MBlur")
    if old then old:Destroy() end
    if not on then return end

    local blur = Instance.new("BlurEffect")
    blur.Name = "DH_MBlur"
    blur.Size = 0
    blur.Parent = L

    local cam0 = workspace.CurrentCamera
    local prev = cam0 and cam0.CFrame.LookVector
    DHFx.mbConn = game:GetService("RunService").RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local look = cam.CFrame.LookVector
        local target = 0
        if prev then
            local d = math.clamp(prev:Dot(look), -1, 1)
            target = math.min(math.acos(d) * DHFx.mbStrength * 2, 24)
        end
        prev = look
        blur.Size = blur.Size + (target - blur.Size) * 0.4
    end)
end

function DHFx.Flare(on)
    if DHFx.flConn then
        DHFx.flConn:Disconnect()
        DHFx.flConn = nil
    end
    if DHFx.flGui then
        DHFx.flGui:Destroy()
        DHFx.flGui = nil
    end
    if not on then return end

    local g = Instance.new("ScreenGui")
    g.Name = "DH_Flare"
    g.IgnoreGuiInset = true
    g.ResetOnSpawn = false
    g.DisplayOrder = -5
    g.Parent = ScreenGui.Parent
    DHFx.flGui = g

    -- {size (screen height), transparency, distance along the line center -> sun, image}
    local spec = {
        {3.0, 0, 1, "rbxassetid://277033149"},
        {0.14, 0.8, 1.7, "rbxassetid://15164863822"},
        {0.04, 0.7, 0.3, "rbxassetid://15164863822"},
        {0.24, 0.9, -0.3, "rbxassetid://15164863822"},
        {0.09, 0.6, -0.9, "rbxassetid://15164863822"},
    }
    local imgs = {}
    for i, s in ipairs(spec) do
        local f = Instance.new("ImageLabel")
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.SizeConstraint = Enum.SizeConstraint.RelativeYY
        f.Size = UDim2.new(s[1], 0, s[1], 0)
        f.BackgroundTransparency = 1
        f.BorderSizePixel = 0
        f.Image = s[4]
        f.ImageColor3 = (i == 1) and Color3.new(1, 1, 0.95) or Color3.new(1, 1, 0.8)
        f.Rotation = (i == 1) and 0 or -25
        f.ImageTransparency = 1
        f.Parent = g
        imgs[i] = f
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    params.RespectCanCollide = true
    local vis = 0

    DHFx.flConn = game:GetService("RunService").RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local dir = game:GetService("Lighting"):GetSunDirection()
        local p = cam:WorldToViewportPoint(cam.CFrame.Position + dir * 1000)

        local char = game:GetService("Players").LocalPlayer.Character
        params.FilterDescendantsInstances = char and {char} or {}
        local blocked = workspace:Raycast(cam.CFrame.Position, dir * 1000, params) ~= nil
        vis = vis * 0.5 + (blocked and 0 or 1) * 0.5

        local center = cam.ViewportSize / 2
        local vec = Vector2.new(p.X, p.Y) - center
        for i, s in ipairs(spec) do
            local pos = center + vec * s[3]
            imgs[i].Position = UDim2.fromOffset(pos.X, pos.Y)
            imgs[i].ImageTransparency = (p.Z > 0) and (1 - vis + s[2] * vis) or 1
        end
    end)
end

function DHFx.GI(on)
    local L = game:GetService("Lighting")
    if on then
        DHAdj.Set(L, "EnvironmentDiffuseScale", 1)
        DHAdj.Set(L, "EnvironmentSpecularScale", 1)
        DHAdj.Set(L, "GlobalShadows", true)
        DHAdj.Set(L, "ShadowSoftness", 0.5)
    else
        local o = DHAdj.Orig[L]
        if o then
            for _, k in ipairs({"EnvironmentDiffuseScale", "EnvironmentSpecularScale", "GlobalShadows", "ShadowSoftness"}) do
                if o[k] ~= nil then
                    pcall(function() L[k] = o[k] end)
                    o[k] = nil
                end
            end
        end
    end
end

function DHFx.Copy()
    local out = {"-- DaffzHub saved adjustment"}
    for obj, t in pairs(DHAdj.Orig) do
        for k in pairs(t) do
            local ok, v = pcall(function() return obj[k] end)
            if ok then
                table.insert(out, obj.ClassName .. "." .. k .. " = " .. tostring(v))
            end
        end
    end
    if #out == 1 then return false end
    return (pcall(function() setclipboard(table.concat(out, "\n")) end))
end

function BuildEffect()
