-- MODS TAB (part 9): Invisible, your body waits in the Safe Zone, you control a ghost
-- ================================================
DHInv = {Want = false, Active = false, Busy = false, Speed = 16, Tracks = {}}

function DHInv.Hint(text)
    local d = DHInv.Api and DHInv.Api.Desc
    if not d then return end
    local old = "Your body waits in the Safe Zone, you control a ghost"
    d.Text = text
    task.delay(2.5, function()
        if d.Parent then d.Text = old end
    end)
end

function DHInv.MakeGhost(char, cf)
    char.Archivable = true
    local ok, ghost = pcall(function() return char:Clone() end)
    if not ok or not ghost then return nil end
    ghost.Name = "DaffzGhost"
    for _, d in ipairs(ghost:GetDescendants()) do
        if d:IsA("LuaSourceContainer") or d:IsA("Sound") then
            d:Destroy()
        elseif d:IsA("BasePart") then
            if d.Name ~= "HumanoidRootPart" then
                d.Transparency = 0.45
                d.Material = Enum.Material.ForceField
                d.Color = Color3.fromRGB(150, 220, 255)
            end
            d.CanTouch = false
        elseif d:IsA("Decal") then
            d.Transparency = 0.5
        end
    end
    local gh = ghost:FindFirstChildOfClass("Humanoid")
    local gr = ghost:FindFirstChild("HumanoidRootPart")
    if not (gh and gr) then
        ghost:Destroy()
        return nil
    end
    gh.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    gh.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    ghost.Parent = workspace
    ghost:PivotTo(cf)
    return ghost, gh, gr
end

function DHInv.LoadAnims(char, gh)
    DHInv.Tracks = {}
    DHInv.Cur = nil
    local an = char:FindFirstChild("Animate")
    if not an then return end
    local animator = gh:FindFirstChildOfClass("Animator")
    if not animator then animator = Instance.new("Animator", gh) end
    local function Load(key, a, b, looped)
        local ok, id = pcall(function() return an[a][b].AnimationId end)
        if not ok or not id or id == "" then return end
        local anim = Instance.new("Animation")
        anim.AnimationId = id
        local ok2, tr = pcall(function() return animator:LoadAnimation(anim) end)
        if ok2 and tr then
            tr.Looped = looped
            DHInv.Tracks[key] = tr
        end
    end
    Load("idle", "idle", "Animation1", true)
    Load("walk", "walk", "WalkAnim", true)
    Load("jump", "jump", "JumpAnim", false)
    Load("fall", "fall", "FallAnim", true)
end

function DHInv.AnimStep()
    local gh, gr = DHInv.GHum, DHInv.GRoot
    local air = gh.FloorMaterial == Enum.Material.Air
    local moving = gh.MoveDirection.Magnitude > 0.1
    local state
    if air then
        state = gr.AssemblyLinearVelocity.Y > 1 and "jump" or "fall"
    else
        state = moving and "walk" or "idle"
    end
    if state ~= DHInv.Cur then
        local old = DHInv.Tracks[DHInv.Cur]
        if old then old:Stop(0.15) end
        local new = DHInv.Tracks[state]
        if new then new:Play(0.15) end
        DHInv.Cur = state
    end
    if state == "walk" and DHInv.Tracks.walk then
        DHInv.Tracks.walk:AdjustSpeed(math.max(0.3, gh.WalkSpeed / 16))
    end
end

function DHInv.Cleanup()
    if DHInv.Conn then
        DHInv.Conn:Disconnect()
        DHInv.Conn = nil
    end
    if DHInv.JumpConn then
        DHInv.JumpConn:Disconnect()
        DHInv.JumpConn = nil
    end
    for _, tr in pairs(DHInv.Tracks) do
        pcall(function() tr:Stop(0) end)
    end
    DHInv.Tracks = {}
    DHInv.Cur = nil
    if DHInv.Ghost then
        pcall(function() DHInv.Ghost:Destroy() end)
        DHInv.Ghost = nil
    end
    -- also remove any ghost left behind by an earlier run
    for _, g in ipairs(workspace:GetChildren()) do
        if g.Name == "DaffzGhost" then pcall(function() g:Destroy() end) end
    end
    DHInv.GHum, DHInv.GRoot = nil, nil
    DHInv.Active = false
    -- camera always goes back to your own character
    pcall(function()
        local cam = workspace.CurrentCamera
        local ch = Player.Character
        local h = ch and ch:FindFirstChildOfClass("Humanoid")
        if cam and h then
            cam.CameraType = Enum.CameraType.Custom
            cam.CameraSubject = h
        end
    end)
end

function DHInv.Step()
    local char, hum = DHInv.Char, DHInv.RHum
    local gh, gr = DHInv.GHum, DHInv.GRoot
    -- real body died or was replaced: just clean up (the game puts the camera back)
    if Player.Character ~= char or not hum or not hum.Parent or hum.Health <= 0 or not (gh and gh.Parent and gr and gr.Parent) then
        DHInv.Cleanup()
        DHInv.Want = false
        if DHInv.Api then task.defer(function() DHInv.Api.Set(false) end) end
        return
    end
    -- Safe Zone was turned off by hand in the Player tab: end Invisible too
    if DHSafeState and not DHSafeState() then
        DHInv.Want = false
        if DHInv.Api then task.defer(function() DHInv.Api.Set(false) end) end
        return
    end

    local rr = char:FindFirstChild("HumanoidRootPart")
    if rr and not rr.Anchored then rr.Anchored = true end
    local cam = workspace.CurrentCamera
    if cam and cam.CameraSubject ~= gh then cam.CameraSubject = gh end

    gh.WalkSpeed = DHInv.Speed
    -- Shiftlock (or any script that turns AutoRotate off): the ghost faces where the camera looks
    local locked = hum.AutoRotate == false or UIS.MouseBehavior == Enum.MouseBehavior.LockCenter
    gh.AutoRotate = not locked
    if locked and cam then
        local look = cam.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then
            gr.CFrame = CFrame.lookAt(gr.Position, gr.Position + flat)
        end
    end
    gh:Move(hum.MoveDirection, false)
    if hum.Jump then gh.Jump = true end
    if gr.Position.Y < workspace.FallenPartsDestroyHeight + 50 and DHInv.Start then
        gr.CFrame = DHInv.Start
        gr.AssemblyLinearVelocity = Vector3.zero
    end
    DHInv.AnimStep()
end

function DHInv.Enter()
    if DHDum and DHDum.Ctl then
        DHInv.Hint("Go back to your own body first")
        return false
    end
    if DHSafeState and DHSafeState() then
        DHInv.Hint("Turn off Safe Zone first")
        return false
    end
    if DHMods.FlyActive or DHMods.WwActive then
        DHInv.Hint("Turn off Fly / Wall Walk first")
        return false
    end
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = hum and hum.RootPart
    if not (hum and root) or hum.Health <= 0 then
        DHInv.Hint("No character")
        return false
    end
    local cf = root.CFrame
    local ghost, gh, gr = DHInv.MakeGhost(char, cf)
    if not ghost then
        DHInv.Hint("Could not make the ghost")
        return false
    end
    DHInv.LoadAnims(char, gh)

    -- send the real body to the Safe Zone (same as the Player tab button)
    DHSafeSetReturn(cf)
    ToggleSafeZone()
    if not DHSafeState() then
        ghost:Destroy()
        DHInv.Hint("Safe Zone failed")
        return false
    end
    local rr = char:FindFirstChild("HumanoidRootPart")
    if rr then rr.Anchored = true end

    DHInv.Char, DHInv.RHum = char, hum
    DHInv.Ghost, DHInv.GHum, DHInv.GRoot = ghost, gh, gr
    DHInv.Start = cf
    DHInv.JumpConn = UIS.JumpRequest:Connect(function()
        if DHInv.GHum then DHInv.GHum.Jump = true end
    end)
    DHInv.Conn = RunService.Heartbeat:Connect(function()
        pcall(DHInv.Step)
    end)
    DHInv.Active = true
    return true
end

function DHInv.Exit()
    local gr = DHInv.GRoot
    local cf = (gr and gr.Parent) and gr.CFrame or DHInv.Start
    local char = DHInv.Char
    if DHInv.Conn then
        DHInv.Conn:Disconnect()
        DHInv.Conn = nil
    end
    if DHInv.JumpConn then
        DHInv.JumpConn:Disconnect()
        DHInv.JumpConn = nil
    end
    -- the body stays anchored while it travels back, so it cannot fall before the ground is ready
    pcall(function()
        if cf then
            if DHSafeState and DHSafeState() then
                DHSafeSetReturn(cf)
                ToggleSafeZone()
            elseif char then
                char:PivotTo(cf)
            end
        end
    end)
    pcall(function()
        task.wait(0.15)
        local rr = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if rr then
            rr.AssemblyLinearVelocity = Vector3.zero
            rr.AssemblyAngularVelocity = Vector3.zero
            rr.Anchored = false
        end
        if hum then hum:ChangeState(Enum.HumanoidStateType.Landed) end
    end)
    DHInv.Cleanup()
end

function DHInv.Set(on)
    DHInv.Want = on and true or false
    if DHInv.Busy then return end
    DHInv.Busy = true
    task.spawn(function()
        while DHInv.Want ~= DHInv.Active do
            if DHInv.Want then
                if not DHInv.Enter() then
                    DHInv.Want = false
                    if DHInv.Api then task.defer(function() DHInv.Api.Set(false) end) end
                end
            else
                pcall(DHInv.Exit)
                DHInv.Active = false
            end
        end
        DHInv.Busy = false
    end)
end

function BuildModsPart9()
    if not DHMods.Scroll then return end
    DHMods.Header("INVISIBLE")
    DHInv.Api = DHMods.AddToggle("Invisible", "Your body waits in the Safe Zone, you control a ghost", DHInv.Set)
    DHMods.AddSlider("Ghost Speed", 8, 100, 16, 2, "%.0f", function(v) DHInv.Speed = v end)
end

