        thumb.BackgroundColor3 = it.c1 or Color3.fromRGB(60, 60, 60)
        thumb.BorderSizePixel = 0
        thumb.ClipsDescendants = true
        thumb.Parent = btn
        Instance.new("UICorner", thumb).CornerRadius = UDim.new(0, 6)

        local grad = Instance.new("UIGradient", thumb)
        grad.Rotation = 90
        grad.Color = ColorSequence.new(it.c1 or Color3.fromRGB(60, 60, 60), it.c2 or Color3.fromRGB(30, 30, 30))

        local emo = Instance.new("TextLabel")
        emo.Size = UDim2.new(1, 0, 1, 0)
        emo.BackgroundTransparency = 1
        emo.Text = it.emoji or ""
        emo.TextSize = 26
        emo.Font = Enum.Font.Gotham
        emo.Parent = thumb

        if it.thumb then
            local img = Instance.new("ImageLabel")
            img.Size = UDim2.new(1, 0, 1, 0)
            img.BackgroundTransparency = 1
            img.ScaleType = Enum.ScaleType.Crop
            img.Image = "rbxassetid://" .. tostring(it.thumb)
            img.ZIndex = 2
            img.Parent = thumb
        end

        local nm = Instance.new("TextLabel")
        nm.Size = UDim2.new(1, -150, 1, 0)
        nm.Position = UDim2.new(0, 108, 0, 0)
        nm.BackgroundTransparency = 1
        nm.Text = it.name
        nm.Font = Enum.Font.GothamBold
        nm.TextSize = 14
        nm.TextColor3 = Color3.fromRGB(255, 255, 255)
        nm.TextXAlignment = Enum.TextXAlignment.Left
        nm.Parent = btn

        local check = Instance.new("TextLabel")
        check.Size = UDim2.new(0, 30, 1, 0)
        check.Position = UDim2.new(1, -36, 0, 0)
        check.BackgroundTransparency = 1
        check.Text = "✓"
        check.Font = Enum.Font.GothamBold
        check.TextSize = 22
        check.TextColor3 = Color3.fromRGB(80, 255, 120)
        check.Visible = false
        check.Parent = btn

        rows[it.key] = {item = it, btn = btn, check = check, stroke = stroke}

        btn.MouseButton1Click:Connect(function()
            api.Select(it.key)
        end)
    end

    search:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(search.Text)
        for _, r in pairs(rows) do
            r.btn.Visible = (q == "") or (string.find(string.lower(r.item.name), q, 1, true) ~= nil)
