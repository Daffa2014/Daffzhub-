    -- 5. FULL BRIGHT (v2: reacts at once when the game changes the lighting, and handles new effects)
    ------------------------------------------------
    local FB_AMBIENT = Color3.fromRGB(178, 178, 178)
    local fbOn = false
    local fbToken = 0
    local fbSaved = nil
    local fbConns = {}

    local function FbHandleChild(a)
        if a:IsA("Atmosphere") then
            if a:GetAttribute("DH_FBD") == nil then
                a:SetAttribute("DH_FBD", a.Density)
                a:SetAttribute("DH_FBH", a.Haze)
            end
            if a.Density ~= 0 then a.Density = 0 end
            if a.Haze ~= 0 then a.Haze = 0 end
        elseif a:IsA("ColorCorrectionEffect") then
            if a.Brightness < 0 then
                if a:GetAttribute("DH_FBB") == nil then
                    a:SetAttribute("DH_FBB", a.Brightness)
                end
                a.Brightness = 0
            end
        end
    end

    local function FbApply()
        if not fbOn then return end
        if Lighting.Brightness ~= 2 then Lighting.Brightness = 2 end
        if Lighting.ClockTime ~= 14 then Lighting.ClockTime = 14 end
        if Lighting.FogEnd ~= 100000 then Lighting.FogEnd = 100000 end
        if Lighting.ExposureCompensation ~= 0 then Lighting.ExposureCompensation = 0 end
        if Lighting.Ambient ~= FB_AMBIENT then Lighting.Ambient = FB_AMBIENT end
        if Lighting.OutdoorAmbient ~= FB_AMBIENT then Lighting.OutdoorAmbient = FB_AMBIENT end
        for _, a in ipairs(Lighting:GetChildren()) do
            FbHandleChild(a)
        end
    end

    local function FbSafe()
        pcall(FbApply)
    end

    local function SetFullBright(on)
        fbOn = on
        Lighting:SetAttribute("DH_FullBright", on)
        fbToken = fbToken + 1
        local myToken = fbToken
        for _, c in ipairs(fbConns) do c:Disconnect() end
        fbConns = {}

        if on then
            fbSaved = {
                Brightness = Lighting.Brightness,
                ClockTime = Lighting.ClockTime,
                FogEnd = Lighting.FogEnd,
                ExposureCompensation = Lighting.ExposureCompensation,
                Ambient = Lighting.Ambient,
                OutdoorAmbient = Lighting.OutdoorAmbient,
            }
            -- the moment the game changes any of these, put it back (no flicker between checks)
            for _, p in ipairs({"Brightness", "ClockTime", "FogEnd", "ExposureCompensation", "Ambient", "OutdoorAmbient"}) do
                table.insert(fbConns, Lighting:GetPropertyChangedSignal(p):Connect(FbSafe))
            end
            -- new effects added to Lighting later
            table.insert(fbConns, Lighting.ChildAdded:Connect(function()
                task.defer(FbSafe)
            end))
            FbSafe()
            -- safety net
            task.spawn(function()
                while fbOn and fbToken == myToken do
                    task.wait(1)
                    FbSafe()
                end
            end)
        else
            if fbSaved then
                for k, v in pairs(fbSaved) do
                    pcall(function() Lighting[k] = v end)
                end
                fbSaved = nil
            end
            for _, a in ipairs(Lighting:GetChildren()) do
                if a:IsA("Atmosphere") then
                    local d = a:GetAttribute("DH_FBD")
                    if d ~= nil then
                        a.Density = d
                        a.Haze = a:GetAttribute("DH_FBH") or a.Haze
                        a:SetAttribute("DH_FBD", nil)
                        a:SetAttribute("DH_FBH", nil)
                    end
                elseif a:IsA("ColorCorrectionEffect") then
                    local b = a:GetAttribute("DH_FBB")
                    if b ~= nil then
                        a.Brightness = b
                        a:SetAttribute("DH_FBB", nil)
                    end
                end
            end
        end
    end

