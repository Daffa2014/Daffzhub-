-- Sorts a list of players A-Z (names that start with a digit or symbol go last)
function DHSortPlayers(list, byName)
    table.sort(list, function(a, b)
        local x = (byName and a.Name or a.DisplayName):lower()
        local y = (byName and b.Name or b.DisplayName):lower()
        local gx = x:match("^%a") and 0 or 1
        local gy = y:match("^%a") and 0 or 1
        if gx ~= gy then return gx < gy end
        if x ~= y then return x < y end
        return a.Name:lower() < b.Name:lower()
    end)
    return list
end

