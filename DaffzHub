DHShader = {Token = 0}
DHShader.Props = {"Brightness", "ClockTime", "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom", "ExposureCompensation", "FogColor", "FogEnd", "FogStart"}

function DHShader.Fx(class, name)
    local L = game:GetService("Lighting")
    local o = L:FindFirstChild(name)
    if o and not o:IsA(class) then
        o:Destroy()
        o = nil
    end
    if not o then
        o = Instance.new(class)
        o.Name = name
        o.Parent = L
    end
    return o
end

function DHShader.Kill(name)
    local o = game:GetService("Lighting"):FindFirstChild(name)
    if o then o:Destroy() end
end

function DHShader.Set(obj, props)
    for k, v in pairs(props) do
        pcall(function() obj[k] = v end)
    end
end

function DHShader.RestoreAtmo()
    local s = DHShader.Snap
    if s and s.atmo and s.atmo.Parent then
        DHShader.Set(s.atmo, s.ap)
    end
    DHShader.Kill("DH_Atmo")
end

function DHShader.Paint(p)
    local L = game:GetService("Lighting")
    DHShader.Set(L, p.props)
    DHShader.Set(DHShader.Fx("ColorCorrectionEffect", "DH_CC"), p.cc)
    DHShader.Set(DHShader.Fx("BloomEffect", "DH_Bloom"), p.bloom)
    if p.rays then
        DHShader.Set(DHShader.Fx("SunRaysEffect", "DH_Rays"), p.rays)
    else
        DHShader.Kill("DH_Rays")
    end
    if p.dof then
        DHShader.Set(DHShader.Fx("DepthOfFieldEffect", "DH_DOF"), p.dof)
    else
        DHShader.Kill("DH_DOF")
    end
    if p.atmo then
        local a = DHShader.Snap and DHShader.Snap.atmo
        if not (a and a.Parent) then
            a = DHShader.Fx("Atmosphere", "DH_Atmo")
        end
        DHShader.Set(a, p.atmo)
    else
        DHShader.RestoreAtmo()
    end
end

function DHShader.Apply(p)
    local L = game:GetService("Lighting")
    if not DHShader.Snap then
        local s = {props = {}}
        for _, k in ipairs(DHShader.Props) do
            s.props[k] = L[k]
        end
        local a = L:FindFirstChildOfClass("Atmosphere")
        if a and a.Name ~= "DH_Atmo" then
            s.atmo = a
            s.ap = {Density = a.Density, Offset = a.Offset, Color = a.Color, Decay = a.Decay, Glare = a.Glare, Haze = a.Haze}
        end
        DHShader.Snap = s
    end
    DHShader.Token = DHShader.Token + 1
    local my = DHShader.Token
    DHShader.Paint(p)
    task.spawn(function()
        while DHShader.Token == my do
            task.wait(1)
            if DHShader.Token ~= my then break end
            -- Full Bright has priority while it is ON
            if not L:GetAttribute("DH_FullBright") then
                pcall(DHShader.Paint, p)
            end
        end
    end)
end

function DHShader.Restore()
    DHShader.Token = DHShader.Token + 1
    local L = game:GetService("Lighting")
    local s = DHShader.Snap
    if s then
        if not L:GetAttribute("DH_FullBright") then
            for k, v in pairs(s.props) do
                pcall(function() L[k] = v end)
            end
        end
        DHShader.RestoreAtmo()
    end
    for _, n in ipairs({"DH_CC", "DH_Bloom", "DH_Rays", "DH_DOF", "DH_Atmo"}) do
        DHShader.Kill(n)
    end
    DHShader.Snap = nil
end

