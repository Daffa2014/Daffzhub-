function DHRep.End(s)
    if string.find(s, "[%.%!%?]$") then return s end
    return s .. "."
end

-- full = true adds the Details / When parts (used when copying); the cards only show the short text
function DHRep.Compose(t, full)
    local p = DHRep.Player ~= "" and DHRep.Player or "this player"
    local d, w = "", ""
    if full and DHRep.Detail ~= "" then d = " Details: " .. DHRep.End(DHRep.Detail) end
    if full and DHRep.When ~= "" then w = " When / where: " .. DHRep.End(DHRep.When) end
    local out = string.gsub(t, "{player}", function() return p end)
    out = string.gsub(out, "{details}", function() return d end)
    out = string.gsub(out, "{when}", function() return w end)
    return string.upper(string.sub(out, 1, 1)) .. string.sub(out, 2)
end

function DHRep.Refresh()
    for _, c in ipairs(DHRep.Cards) do
        if c[1].Parent then c[1].Text = DHRep.Compose(c[2], false) end
