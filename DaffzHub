    rotR.MouseButton1Down:Connect(function() DHRot = 1 end)
    rotL.MouseButton1Up:Connect(function() DHRot = 0 end)
    rotR.MouseButton1Up:Connect(function() DHRot = 0 end)
    game:GetService("UserInputService").InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            DHRot = 0
        end
    end)

    RunService.RenderStepped:Connect(function(dt)
        if DHRot ~= 0 and heldBlock and mBodyGyro and mBodyGyro.Parent then
            local cf = mBodyGyro.CFrame
            mBodyGyro.CFrame = CFrame.Angles(0, DHRot * DHMoveCfg.RotateSpeed * dt, 0) * (cf - cf.Position)
        end
    end)

    -- Throw: let go of the held block and send it where the camera looks.
    -- Move turns OFF so it does not grab the thrown block again.
    throwBtn.MouseButton1Click:Connect(function()
        local blk = heldBlock
        if not (blk and blk.Parent and mBodyVelocity) then
