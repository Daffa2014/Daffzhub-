DHW = {Loaded = false, Last = nil, Back = nil, Safe = nil, Prev = nil, Death = false, Markers = true, T = 0}
DHW.Dir = "Daffzhub_file/Waypoint"
DHW.Id = tostring(game.PlaceId)
DHW.MapName = tostring(game.Name):gsub("[^%w _%-]", ""):gsub("^%s+", ""):gsub("%s+$", ""):sub(1, 40)
if DHW.MapName == "" then DHW.MapName = "Map" end
DHW.File = DHW.Dir .. "/" .. DHW.MapName .. "_" .. DHW.Id .. ".json"

function DHW.Encode()
    local t = {}
    for name, cf in pairs(WaypointsData) do
        t[name] = {cf:GetComponents()}
    end
    return HttpService:JSONEncode(t)
end

-- finds the file of this map (works even if the map was renamed)
function DHW.Find()
    local found
    pcall(function()
        if listfiles and isfolder and isfolder(DHW.Dir) then
            for _, f in ipairs(listfiles(DHW.Dir)) do
                if tostring(f):find("_" .. DHW.Id .. ".json", 1, true) then
                    found = f
                    break
                end
            end
        end
    end)
    return found
end

function DHW.Load()
    pcall(function()
        if not (isfile and readfile) then return end
        local src = DHW.Find()
        if src then
            DHW.File = src
        else
            -- old single-folder save from the first version
            local old = "Daffzhub_file/waypoints_" .. DHW.Id .. ".json"
            if isfile(old) then src = old end
        end
        if src and isfile(src) then
            local t = HttpService:JSONDecode(readfile(src))
            for name, c in pairs(t) do
                if type(name) == "string" and type(c) == "table" and #c == 12 and not WaypointsData[name] then
                    WaypointsData[name] = CFrame.new(unpack(c))
                end
            end
        end
    end)
    DHW.Loaded = true
    DHW.Last = DHW.Encode()
end

-- called by PopulateWaypointList: saves to file and rebuilds markers when something changed
function DHW.Sync()
    if not DHW.Loaded then return end
    local s = DHW.Encode()
    if s == DHW.Last then return end
    DHW.Last = s
    pcall(function()
        if writefile then
            if makefolder and isfolder then
                if not isfolder("Daffzhub_file") then makefolder("Daffzhub_file") end
                if not isfolder(DHW.Dir) then makefolder(DHW.Dir) end
            end
            writefile(DHW.File, s)
        end
    end)
    DHW.Rebuild()
end

function DHW.Rebuild()
    if DHW.Folder then DHW.Folder:Destroy() DHW.Folder = nil end
    DHW.Labels = {}
    if not DHW.Markers then return end
    local f = Instance.new("Folder")
    f.Name = "DHWMarkers"
    for name, cf in pairs(WaypointsData) do
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.Transparency = 1
        part.Size = Vector3.new(0.5, 0.5, 0.5)
        part.Position = cf.Position + Vector3.new(0, 2, 0)
        part.Parent = f

        local bb = Instance.new("BillboardGui", part)
        bb.Adornee = part
        bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0, 130, 0, 34)
        bb.ResetOnSpawn = false
        local lb = Instance.new("TextLabel", bb)
        lb.Size = UDim2.new(1, 0, 1, 0)
        lb.BackgroundTransparency = 1
        lb.Font = Enum.Font.GothamBold
        lb.TextSize = 12
        lb.TextColor3 = (name == "Death Point") and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(80, 220, 120)
        lb.TextStrokeTransparency = 0.3
        lb.Text = name
        DHW.Labels[#DHW.Labels + 1] = {lb, name, part.Position}
    end
    f.Parent = workspace
    DHW.Folder = f
end

function DHW.Hook(char)
