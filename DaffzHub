function BuildAdjustment()
    local L = game:GetService("Lighting")
    local box = DHVisual.AddContainer("Adjustment", 80)
    DHVisual.AddNote(box, "Live sliders. If a shader is active it repaints Lighting every second, so choose the shader first and expect time sliders to be overridden by it.")

    local function Add(title, min, max, dec, getObj, key, fb)
        local cur = fb
        local o = getObj(true)
        if o then
            local ok, v = pcall(function() return o[key] end)
            if ok and type(v) == "number" then cur = v end
        end
        cur = math.clamp(cur, min, max)
        local s = DHVisual.AddSlider(box, title, min, max, cur, dec, function(v)
            DHAdj.Set(getObj(), key, v)
        end)
        table.insert(DHAdj.Sliders, {s, cur})
    end

    local function Light() return L end
    local function Terr() return workspace.Terrain end
    local function Cl(noCreate)
        if noCreate then
            return workspace.Terrain:FindFirstChildOfClass("Clouds")
        end
        return DHAdj.GetClouds()
    end

    Add("Clock Time", 0, 24, 1, Light, "ClockTime", 12)
    Add("Geographic Latitude", 0, 180, 1, Light, "GeographicLatitude", 41)
    Add("Water Reflectance", 0, 1, 2, Terr, "WaterReflectance", 1)
    Add("Water Transparency", 0, 1, 2, Terr, "WaterTransparency", 0.3)
    Add("Water Wave Size", 0, 1, 2, Terr, "WaterWaveSize", 0.15)
    Add("Water Wave Speed", 0, 100, 0, Terr, "WaterWaveSpeed", 10)
    Add("Clouds Cover", 0, 1, 2, Cl, "Cover", 0.5)
    Add("Clouds Density", 0, 1, 2, Cl, "Density", 0.7)

    if DHAdj.More then DHAdj.More(box, Add) end
    DHVisual.AddButton(box, "Reset Adjustment", DHAdj.Reset)
    DHVisual.OnCleanup(DHAdj.Reset)
end

