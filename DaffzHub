-- ---------- Speed Glitch: normal speed on the ground, faster only while in the air ----------
DHMods.AirMult = 1.6
function DHMods.SpeedGlitchSet(on)
    if DHMods.SgConn then
        DHMods.SgConn:Disconnect()
        DHMods.SgConn = nil
    end
    local function Restore()
        local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
        if hum and DHMods.SgBoost and DHMods.SgHum == hum and DHMods.SgBase then
            hum.WalkSpeed = DHMods.SgBase
        end
        DHMods.SgBoost = false
    end
    if not on then
        Restore()
        return
    end
    DHMods.SgBoost = false
    DHMods.SgConn = RunService.Heartbeat:Connect(function()
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        if DHMods.SgHum ~= hum then
            DHMods.SgHum = hum
            DHMods.SgBoost = false
        end
        local st = hum:GetState()
        local air = (st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall) and not hum.SeatPart
        if air then
            if not DHMods.SgBoost then
                DHMods.SgBase = hum.WalkSpeed
                DHMods.SgBoost = true
            end
            hum.WalkSpeed = DHMods.SgBase * DHMods.AirMult
        elseif DHMods.SgBoost then
            hum.WalkSpeed = DHMods.SgBase
            DHMods.SgBoost = false
        end
    end)
end

