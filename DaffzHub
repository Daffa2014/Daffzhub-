                    ap.Position = c + Vector3.new(math.cos(a) * r, h, math.sin(a) * r)
                end)
            end
        end
    end)

    orbitBtn.MouseButton1Click:Connect(function()
        SetOrbit(not DHOrbit.on)
    end)

    -- ---------- GRAB LIMIT ----------
    local function ApplyLimit()
        local v = DHLimitSteps[DHLimitIndex]
        BringCfg.MaxParts = v
        limLabel.Text = "Grab Limit: " .. (v == math.huge and "Unlimited" or tostring(v))
        if BringCount > v then
            local list = {}
            for p in pairs(forcedParts) do list[#list + 1] = p end
            for _, p in ipairs(list) do
                if BringCount <= v then break end
                BringRelease(p)
            end
        end
    end

    limMinus.MouseButton1Click:Connect(function()
        DHLimitIndex = math.max(1, DHLimitIndex - 1)
        ApplyLimit()
    end)
    limPlus.MouseButton1Click:Connect(function()
        DHLimitIndex = math.min(#DHLimitSteps, DHLimitIndex + 1)
        ApplyLimit()
    end)
    ApplyLimit()

    -- ---------- RELEASE ALL / PANIC ----------
    local function Panic()
        SetOrbit(false)
        local list = {}
        for p in pairs(forcedParts) do list[#list + 1] = p end
        for _, p in ipairs(list) do BringRelease(p) end
        if blackHoleActive then ToggleBringParts() end
        if magnetEnabled then ToggleMagnet() end
        -- also unfreeze everything frozen with Move
        for p in pairs(frozenData) do
            if p and p.Parent then
                for _, x in ipairs(p:GetChildren()) do
                    if x:IsA("BodyPosition") or x:IsA("BodyGyro") then x:Destroy() end
                end
            end
        end
        frozenData = {}
        DHRot = 0
        BringStatusLabel.Text = "Grabbed: 0 | Owned: 0"
        MagnetStatus.Text = "Status: Idle"
    end
    panicBtn.MouseButton1Click:Connect(Panic)

    -- ---------- MOVE: ROTATE + THROW ----------
    MagnetContainer.Size = UDim2.new(1, 0, 0, 365)
    MagnetStatus.Position = UDim2.new(0, 10, 0, 340)

    local throwBtn = Btn(MagnetContainer, "Throw", UDim2.new(0.52, 5, 0, 260), UDim2.new(0.48, -5, 0, 30), Color3.fromRGB(200, 120, 30))
    throwBtn.TextSize = 12
    local rotL = Btn(MagnetContainer, "< Rotate", UDim2.new(0, 10, 0, 300), UDim2.new(0.48, -5, 0, 30), Color3.fromRGB(100, 150, 255))
