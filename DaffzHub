function IsOwned(v)
    if isnetworkowner then
        local ok, res = pcall(isnetworkowner, v)
        if ok then return res end
    end
    return v.AssemblyLinearVelocity.Magnitude > 1
end

function BringEligible(v)
    if not v:IsA("BasePart") or v.Anchored then return false end
    local root = v.AssemblyRootPart
    if root and root.Anchored then return false end -- welded to an anchored part
    if v == heldBlock then return false end -- the part you are holding with Move
    if v == heldBlock then return false end          -- the part you are holding with Move
    if Player.Character and v:IsDescendantOf(Player.Character) then return false end
    local p = v.Parent
    if not p or p:FindFirstChildOfClass("Humanoid") or p:FindFirstChild("Head") then return false end
    if v.Name == "Handle" or p:IsA("Tool") then return false end
    if frozenData and frozenData[v] then return false end
    return true
end

function BringClean(v)
    -- removes Bring constraints, including leftovers from older runs (any name)
    for _, x in ipairs(v:GetChildren()) do
        if x:IsA("AlignPosition") or x:IsA("AlignOrientation") or x:IsA("Torque") or x.Name == "DH_Att" then
            x:Destroy()
        end
    end
end

function BringRelease(v, forceCollide)
    if not v then return end
    BringClean(v)
    local o = bringObjs[v]
    if o then
        for _, x in ipairs(o.objs) do
            if x and x.Parent then x:Destroy() end
        end
        pcall(function() v.CanCollide = o.collide end)
        bringObjs[v] = nil
    elseif forceCollide then
        pcall(function() v.CanCollide = true end) -- stale part from an older run
    end
    if forcedParts[v] then
        forcedParts[v] = nil
        BringCount = math.max(0, BringCount - 1)
    end
    ownedParts[v] = nil
end

function ForcePart(v)
    if forcedParts[v] or BringCount >= BringCfg.MaxParts then return end
    if not BringEligible(v) then return end

    for _, x in ipairs(v:GetChildren()) do
        if x:IsA("BodyMover") or x:IsA("RocketPropulsion") then
            x:Destroy()
        end
    end

    BringClean(v)

    local collide = v.CanCollide
    v.CanCollide = false

    local Torque = Instance.new("Torque", v)
    Torque.Torque = Vector3.new(100000, 100000, 100000)
    local AlignPosition = Instance.new("AlignPosition", v)
    local Attachment2 = Instance.new("Attachment", v)
    Torque.Name = "DH_Torque"
    AlignPosition.Name = "DH_Align"
    Attachment2.Name = "DH_Att"
    Torque.Attachment0 = Attachment2
    AlignPosition.MaxForce = math.huge
    AlignPosition.MaxVelocity = math.huge
    AlignPosition.Responsiveness = 200
    AlignPosition.Attachment0 = Attachment2
    AlignPosition.Attachment1 = Attachment1

    forcedParts[v] = true
    ownedParts[v] = false
    bringObjs[v] = { objs = {Torque, AlignPosition, Attachment2}, collide = collide }
    BringCount = BringCount + 1
end

function BringScan()
    if BringCount >= BringCfg.MaxParts then return end

    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    local center = hrp and hrp.Position
    if not center then return end

    local candidates = {}
    if BringCfg.Radius >= 5000 then
        -- whole map (same reach as the old version): loose parts only
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and not v.Anchored and not forcedParts[v] then
                candidates[#candidates + 1] = {v, (v.Position - center).Magnitude}
            end
        end
    else
        local ignore = {Folder}
        if Player.Character then table.insert(ignore, Player.Character) end
        local op = OverlapParams.new()
        op.FilterType = Enum.RaycastFilterType.Exclude
        op.FilterDescendantsInstances = ignore
        op.MaxParts = 1500
        for _, v in ipairs(workspace:GetPartBoundsInRadius(center, BringCfg.Radius, op)) do
            if not v.Anchored and not forcedParts[v] then
                candidates[#candidates + 1] = {v, (v.Position - center).Magnitude}
            end
        end
    end

    table.sort(candidates, function(a, b) return a[2] < b[2] end)
    for _, c in ipairs(candidates) do
        if BringCount >= BringCfg.MaxParts then break end
        ForcePart(c[1])
    end
end

function VerifyAndRetry()
    local list = {}
    for v in pairs(forcedParts) do list[#list + 1] = v end

    local grabbed, owned = 0, 0
    for _, v in ipairs(list) do
        if v.Parent then
            ownedParts[v] = IsOwned(v) and true or false
            local o = bringObjs[v]
            if not o or not o.objs[2].Parent then
                BringRelease(v)
                ForcePart(v)
            end
            if forcedParts[v] then
                grabbed = grabbed + 1
                if ownedParts[v] then owned = owned + 1 end
            end
        else
            BringRelease(v)
        end
    end
    if BringStatusLabel then
        BringStatusLabel.Text = "Grabbed: " .. grabbed .. " | Owned: " .. owned
    end
end

function ToggleBringParts()
    blackHoleActive = not blackHoleActive
    BringBtn.BackgroundColor3 = blackHoleActive and Color3.fromRGB(30,180,30) or Color3.fromRGB(180,30,30)
    BringBtn.Text = "Bring Parts " .. (blackHoleActive and "ON" or "OFF")

    if blackHoleActive then
        BringScan()
        DescendantAddedConnection = workspace.DescendantAdded:Connect(ForcePart)

        BringHB = RunService.Heartbeat:Connect(function()
            pcall(function()
                sethiddenproperty(Player, "SimulationRadius", math.huge)
                sethiddenproperty(Player, "MaximumSimulationRadius", math.huge)
            end)
            for v in pairs(forcedParts) do
                if v.Parent and not ownedParts[v] then
                    v.AssemblyLinearVelocity = Network.Velocity
                end
            end
        end)

        RenderConnection = RunService.RenderStepped:Connect(function()
            if not blackHoleActive then return end
            if targetPart and targetPart.Parent then
                Attachment1.WorldCFrame = targetPart.CFrame
            end
            if tick() - lastScan > BringCfg.ScanInterval then
                lastScan = tick()
                BringScan()
                VerifyAndRetry()
            end
        end)
    else
        if DescendantAddedConnection then DescendantAddedConnection:Disconnect() DescendantAddedConnection = nil end
        if RenderConnection then RenderConnection:Disconnect() RenderConnection = nil end
        if BringHB then BringHB:Disconnect() BringHB = nil end

        if BringCfg.ReleaseOnOff then
            local list = {}
            for v in pairs(forcedParts) do list[#list + 1] = v end
            for _, v in ipairs(list) do BringRelease(v) end
        end

        forcedParts = {}
        ownedParts = {}
        bringObjs = {}
        BringCount = 0
        Network.BaseParts = {}
        if BringStatusLabel then
            BringStatusLabel.Text = "Grabbed: 0 | Owned: 0"
        end
    end
end

