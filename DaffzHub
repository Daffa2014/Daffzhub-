function DHAK.Install()
    if DHAK.Hooked then return true end
    if not (hookmetamethod and getnamecallmethod and checkcaller) then return false end
    local wrap = newcclosure or function(f) return f end

    local oldNc
    oldNc = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        if DHAK.On and self == Player and not checkcaller() then
            local m = getnamecallmethod()
            if m == "Kick" or m == "kick" then return end
        end
        return oldNc(self, ...)
    end))

    -- Player.Kick(Player) called without the colon
    if hookfunction then
        pcall(function()
            local oldKick
            oldKick = hookfunction(Player.Kick, wrap(function(self, ...)
                if DHAK.On and self == Player and not checkcaller() then return end
                return oldKick(self, ...)
            end))
        end)
    end

    DHAK.Hooked = true
    return true
end

function DHAK.SetBtn(on)
    if not AntiKickBtn then return end
    AntiKickBtn.BackgroundColor3 = on and Color3.fromRGB(30,180,30) or Color3.fromRGB(180,30,30)
    AntiKickBtn.Text = on and "Anti Kick | ON" or "Anti Kick | OFF"
end

function DHAK.Apply(on)
    if on then
        local ok, res = pcall(DHAK.Install)
        if not (ok and res) then return false end
    end
    DHAK.On = on
    protections.antiKick = on
    DHAK.SetBtn(on)
    updateProtectionStatus()
    return true
end

