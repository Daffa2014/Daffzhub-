        local ranges = {JumpSize = {50, 200}, JumpPosX = {-250, 200}, JumpPosY = {-300, 200}}
        for key, r in pairs(ranges) do
            local v = tonumber(data[key])
            if v then Player:SetAttribute(key, math.clamp(math.floor(v), r[1], r[2])) end
        end
    end)
end

function DHJump.Save()
    DHJump.Token = DHJump.Token + 1
    local my = DHJump.Token
    -- wait a moment so dragging a slider writes the file only once
    task.delay(0.6, function()
        if my ~= DHJump.Token then return end
        pcall(function()
            if not (writefile and makefolder and isfolder) then return end
            if not isfolder("Daffzhub_file") then makefolder("Daffzhub_file") end
            if not isfolder("Daffzhub_file/Setting") then makefolder("Daffzhub_file/Setting") end
            writefile(DHJump.Path, game:GetService("HttpService"):JSONEncode({
                JumpSize = Player:GetAttribute("JumpSize"),
                JumpPosX = Player:GetAttribute("JumpPosX"),
                JumpPosY = Player:GetAttribute("JumpPosY"),
            }))
        end)
    end)
