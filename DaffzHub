function DHAnim.Classify(a)
    local o = a
    for _ = 1, 4 do
        if not o then break end
        local s = string.lower(o.Name)
        if s:find("swimidle", 1, true) then return "swimidle" end
        if s:find("swim", 1, true) then return "swim" end
        if s:find("idle", 1, true) then return "idle" end
        if s:find("walk", 1, true) then return "walk" end
        if s:find("run", 1, true) then return "run" end
        if s:find("jump", 1, true) then return "jump" end
        if s:find("fall", 1, true) then return "fall" end
        if s:find("climb", 1, true) then return "climb" end
        o = o.Parent
    end
    return nil
end

-- the asset ids that make up a bundle (idle, walk, run ...)
function DHAnim.ClassifyName(s)
    s = string.lower(tostring(s or "")):gsub("[%s_%-]", "")
    if s:find("swimidle", 1, true) then return "swimidle" end
    if s:find("swim", 1, true) then return "swim" end
    if s:find("idle", 1, true) then return "idle" end
    if s:find("walk", 1, true) then return "walk" end
    if s:find("run", 1, true) then return "run" end
    if s:find("jump", 1, true) then return "jump" end
    if s:find("fall", 1, true) then return "fall" end
    if s:find("climb", 1, true) then return "climb" end
    return nil
end

-- the parts of a bundle: ids and names (Idle, Walk, Run ...)
function DHAnim.BundleAssets(bundleId)
    local ids, names = {}, {}
    local function add(id, nm)
        id = tonumber(id)
        if id and names[id] == nil then
            ids[#ids + 1] = id
            names[id] = nm or ""
        end
    end
    -- fast path: plain catalog data over HTTP
    pcall(function()
        local url = "https://catalog.roblox.com/v1/bundles/" .. tostring(bundleId) .. "/details"
        local body
        if request then
            local r = request({Url = url, Method = "GET"})
            body = r and r.Body
        else
            body = game:HttpGet(url)
        end
        if type(body) == "string" then
            local d3 = game:GetService("HttpService"):JSONDecode(body)
            if type(d3) == "table" and d3.items then
                for _, it in ipairs(d3.items) do
                    if it.type == "Asset" then add(it.id, it.name) end
                end
            end
        end
    end)
    if #ids > 0 then return ids, names end
    local ok, d = pcall(function()
        return game:GetService("AssetService"):GetBundleDetailsAsync(bundleId)
    end)
    if ok and type(d) == "table" and d.Items then
        for _, it in ipairs(d.Items) do
            if it.Type == "Asset" then add(it.Id, it.Name) end
        end
    end
    if #ids == 0 then
        local ok2, d2 = pcall(function()
            return game:GetService("AvatarEditorService"):GetItemDetails(bundleId, Enum.AvatarItemType.Bundle)
        end)
        if ok2 and type(d2) == "table" then
            local list = d2.BundledItems or d2.Items
            if list then
                for _, it in ipairs(list) do
                    local id = it.Id or it.id
                    if id and (it.Type == nil or it.Type == "Asset") then add(id, it.Name or it.name) end
                end
            end
        end
    end
    if #ids == 0 then
        local url = "https://catalog.roblox.com/v1/bundles/" .. tostring(bundleId) .. "/details"
        local ok3, body = pcall(function()
            if request then
                local r = request({Url = url, Method = "GET"})
                return r and r.Body
            end
            return game:HttpGet(url)
        end)
        if ok3 and type(body) == "string" then
            local ok4, d3 = pcall(function()
                return game:GetService("HttpService"):JSONDecode(body)
            end)
            if ok4 and type(d3) == "table" and d3.items then
                for _, it in ipairs(d3.items) do
                    if it.type == "Asset" then add(it.id, it.name) end
                end
            end
        end
    end
    return ids, names
end

-- bundle -> {slots = {idle = {id1, id2}, walk = {id}, ...}} (cached)
-- an animation id must really load, otherwise the pose becomes stiff
function DHAnim.Valid(id)
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local an = hum and hum:FindFirstChildOfClass("Animator")
    if not an then return true end
    DHAnim.VCache = DHAnim.VCache or {}
    if DHAnim.VCache[id] ~= nil then return DHAnim.VCache[id] end
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. tostring(id)
    local good = false
    local ok, tr = pcall(function() return an:LoadAnimation(a) end)
    if ok and tr then
        local t0 = tick()
        while tick() - t0 < 1.5 do
            if tr.Length > 0 then
                good = true
                break
            end
            task.wait(0.05)
        end
        pcall(function() tr:Stop(0) end)
        pcall(function() tr:Destroy() end)
    end
    a:Destroy()
    DHAnim.VCache[id] = good
    return good
end

-- moves an old save file from the top level into the Daffzhub_file folder (once)
function DHMigrate(old, new)
    pcall(function()
        if not (isfile and isfile(old) and not isfile(new)) then return end
        if makefolder and isfolder and not isfolder("Daffzhub_file") then makefolder("Daffzhub_file") end
        writefile(new, readfile(old))
        if delfile then delfile(old) end
    end)
end

-- saved packs (instant the next time, like the Emote tab cache)
DHAnim.File = "Daffzhub_file/AnimCache.json"
DHMigrate("DaffzHub_AnimCache.json", DHAnim.File)
function DHAnim.DiskLoad()
    if DHAnim.DiskData then return DHAnim.DiskData end
    DHAnim.DiskData = {}
    pcall(function()
        if isfile and isfile(DHAnim.File) then
            local d = game:GetService("HttpService"):JSONDecode(readfile(DHAnim.File))
            if type(d) == "table" then DHAnim.DiskData = d end
        end
    end)
    return DHAnim.DiskData
end
function DHAnim.DiskSave(id, data)
    local d = DHAnim.DiskLoad()
    d[tostring(id)] = data
    pcall(function()
        if writefile then
            writefile(DHAnim.File, game:GetService("HttpService"):JSONEncode(d))
        end
    end)
end

function DHAnim.Resolve(bundleId)
    if DHAnim.Cache[bundleId] then return DHAnim.Cache[bundleId] end
    local saved = DHAnim.DiskLoad()[tostring(bundleId)]
    if type(saved) == "table" and type(saved.slots) == "table" and next(saved.slots) then
        DHAnim.Cache[bundleId] = saved
        return saved
    end

    local ids, names = DHAnim.BundleAssets(bundleId)
    if #ids == 0 then
        DHAnim.Dbg = "(no parts found in this bundle)"
        return nil
    end

    local found, direct = {}, {}
    local function addAnim(tbl, slot, nm, n)
        tbl[slot] = tbl[slot] or {}
        table.insert(tbl[slot], {name = nm, id = n})
    end
    local pending, viaObj, viaName = #ids, 0, 0
    for _, aid in ipairs(ids) do
        task.spawn(function()
            local got = false
            local objs
            local ok, r = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(aid)) end)
            if ok and r then objs = r end
            if not objs then
                local ok2, r2 = pcall(function() return game:GetService("InsertService"):LoadAsset(aid) end)
                if ok2 and r2 then objs = {r2} end
            end
            if objs then
                for _, o in ipairs(objs) do
                    local all = {o}
                    for _, d in ipairs(o:GetDescendants()) do all[#all + 1] = d end
                    for _, a in ipairs(all) do
                        if a:IsA("Animation") and a.AnimationId ~= "" then
                            local s2 = DHAnim.Classify(a)
                            local n = tonumber(a.AnimationId:match("%d+"))
                            if s2 and n then
                                addAnim(found, s2, a.Name, n)
                                viaObj = viaObj + 1
                                got = true
                            end
                        end
                    end
                end
            end
            if not got then
                local slot = DHAnim.ClassifyName(names[aid])
                if slot then
                    addAnim(direct, slot, names[aid], aid)
                    viaName = viaName + 1
                end
            end
            pending = pending - 1
        end)
    end
    local t0 = tick()
    while pending > 0 and tick() - t0 < 6 do
        task.wait(0.05)
    end

    -- real animation ids (like the Emote tab) are used as they are; the part id
    -- is only a fallback for a slot that got nothing, and only that one is checked
    local total, checked, bad = 0, 0, 0
    for slot, list in pairs(direct) do
        if not found[slot] then
            for _, e in ipairs(list) do
                total = total + 1
                task.spawn(function()
                    e.ok = DHAnim.Valid(e.id)
                    if not e.ok then bad = bad + 1 end
                    checked = checked + 1
                end)
            end
            found[slot] = list
        end
    end
    local t1 = tick()
    while checked < total and tick() - t1 < 4 do
        task.wait(0.05)
    end

    local data = {slots = {}}
    local any = false
    for slot, list in pairs(found) do
        table.sort(list, function(x, y) return tostring(x.name) < tostring(y.name) end)
        local arr = {}
        for _, e in ipairs(list) do
            if e.ok == nil or e.ok == true then arr[#arr + 1] = e.id end
        end
        if #arr > 0 then
            data.slots[slot] = arr
            any = true
        end
    end
    if not any then
        DHAnim.Dbg = "(parts: " .. #ids .. ", by object: " .. viaObj .. ", by name: " .. viaName .. ", invalid: " .. bad .. ")"
        return nil
    end
    DHAnim.Cache[bundleId] = data
    DHAnim.DiskSave(bundleId, data)
    return data
end

-- ---------- applying ----------
function DHAnim.Reload(char, fn)
    local animate = char and char:FindFirstChild("Animate")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (animate and hum) then return false end
    animate.Disabled = true
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
            if not DHAnim.IsMapAction(t) then t:Stop(0) end
        end
    end
    fn(animate)
    animate.Disabled = false
    return true
end

function DHAnim.Restore()
    DHAnim.Tok = (DHAnim.Tok or 0) + 1
    DHAnim.CtlStop()
    DHAnim.Healthy = nil
    DHAnim.Applied = nil
    DHAnim.Mode = nil
    DHAnim.Fixes = 0
    if DHAnim.Badge then DHAnim.Badge() end
    DHAnim.Sel = nil
    local orig = DHAnim.Orig
    DHAnim.Orig = nil
    DHAnim.Char = nil
    if not orig then return end
    DHAnim.Reload(Player.Character, function()
        for inst, id in pairs(orig) do
            if inst.Parent then inst.AnimationId = id end
        end
    end)
end

function DHAnim.Apply()
    DHAnim.Tok = (DHAnim.Tok or 0) + 1
    local my = DHAnim.Tok
    local sel = DHAnim.Sel
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not sel then return false, "nothing selected" end
    if not hum then return false, "no humanoid" end
    if not char:FindFirstChild("Animate") then return false, "this game has no Animate script on your character" end
    if hum.RigType ~= Enum.HumanoidRigType.R15 then return false, "character is not R15" end

    if DHAnim.Char ~= char then
        DHAnim.Orig = {}
        DHAnim.Char = char
    end
    DHAnim.Orig = DHAnim.Orig or {}
    DHAnim.Applied = DHAnim.Applied or {}
    local changed = 0
    local okr = DHAnim.Reload(char, function(an)
        for slot, targets in pairs(DHAnim.SlotMap) do
            local e = sel[slot]
            local folder = an:FindFirstChild(targets[1][1])
            if folder then
                local list = {}
                for _, c in ipairs(folder:GetChildren()) do
                    if c:IsA("Animation") then list[#list + 1] = c end
                end
                table.sort(list, function(a, b) return a.Name < b.Name end)
                for i, inst in ipairs(list) do
                    local id = e and (e.ids[i] or e.ids[1])
                    if id then
                        if DHAnim.Orig[inst] == nil then DHAnim.Orig[inst] = inst.AnimationId end
                        inst.AnimationId = "rbxassetid://" .. id
                        DHAnim.Applied[inst] = "rbxassetid://" .. id
                        changed = changed + 1
                    elseif DHAnim.Orig[inst] ~= nil then
                        inst.AnimationId = DHAnim.Orig[inst]
                        if DHAnim.Applied then DHAnim.Applied[inst] = nil end
                        DHAnim.Orig[inst] = nil
                    end
                end
            end
        end
    end)
    if not okr then return false, "Animate script not ready" end
    if changed == 0 then return false, "this game's Animate script has a different layout" end
    return true
end

function DHAnim.CtlStop()
    if DHAnim.CtlConn then
        DHAnim.CtlConn:Disconnect()
        DHAnim.CtlConn = nil
    end
    if DHAnim.CtlTracks then
        for _, t in pairs(DHAnim.CtlTracks) do
            pcall(function() t:Stop(0.1) end)
            pcall(function() t:Destroy() end)
        end
    end
    DHAnim.CtlTracks = nil
    DHAnim.CtlCur = nil
end

-- the map ignores the Animate script (custom animation system): play our own tracks
function DHAnim.CtlStart()
    DHAnim.CtlStop()
    DHAnim.CtlClean = nil
    DHAnim.FreeT = nil
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local an = hum and hum:FindFirstChildOfClass("Animator")
    local sel = DHAnim.Sel
    if not (an and sel) then return false end
    if hum.RigType ~= Enum.HumanoidRigType.R15 then return false end

    local tracks = {}
    for slot, e in pairs(sel) do
        local id = e.ids and e.ids[1]
        if id then
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://" .. id
            local ok, tr = pcall(function() return an:LoadAnimation(a) end)
            if ok and tr then
                tr.Priority = Enum.AnimationPriority.Action3
                tr.Looped = (slot ~= "jump")
                tracks[slot] = tr
            end
        end
    end
    if not next(tracks) then return false end
    DHAnim.CtlTracks = tracks
    DHAnim.CtlChar = char

    DHAnim.CtlConn = game:GetService("RunService").Heartbeat:Connect(function()
        if not hum.Parent then return end
        -- a map action (crawl, vent) must stay visible: pause our tracks while it plays.
        -- Only when the map is "clean" (no action tracks for 1.5 s), so maps that play their
        -- everyday idle/walk on an Action priority keep working in override mode.
        local mapAct = false
        if DHAnim.MapBusy() then
            DHAnim.FreeT = nil
            mapAct = DHAnim.CtlClean == true
        else
            DHAnim.FreeT = DHAnim.FreeT or tick()
            if tick() - DHAnim.FreeT > 1.5 then DHAnim.CtlClean = true end
        end
        local st = hum:GetState()
        local root = hum.RootPart
        local vel = root and root.AssemblyLinearVelocity or Vector3.zero
        local spd = Vector3.new(vel.X, 0, vel.Z).Magnitude
        local want = nil
        if DHAnim.IsSeated(hum) or (ECurrentAnim and ECurrentAnim.IsPlaying) or mapAct then
            want = nil -- sitting, emoting or a map action (crawl, vent): let the map / the Emote tab play
        elseif st == Enum.HumanoidStateType.Climbing then
            want = "climb"
        elseif st == Enum.HumanoidStateType.Swimming then
            want = (spd > 1) and "swim" or "swimidle"
        elseif st == Enum.HumanoidStateType.Jumping then
            want = "jump"
        elseif st == Enum.HumanoidStateType.Freefall then
            want = "fall"
        elseif st == Enum.HumanoidStateType.Running or st == Enum.HumanoidStateType.RunningNoPhysics
            or st == Enum.HumanoidStateType.Landed then
            if spd > 1 then
                if hum.WalkSpeed <= 10 and tracks.walk then want = "walk" else want = "run" end
                if not tracks[want] then want = tracks.run and "run" or "walk" end
            else
                want = "idle"
            end
        end
        if want and not tracks[want] then want = nil end

        if DHAnim.CtlCur ~= want then
            local old = DHAnim.CtlCur and tracks[DHAnim.CtlCur]
            if old then old:Stop(0.15) end
            DHAnim.CtlCur = want
            if want then tracks[want]:Play(0.15) end
        end
        if want == "climb" and tracks.climb then
            tracks.climb:AdjustSpeed(math.abs(vel.Y) > 0.5 and 1 or 0)
        end
    end)
    return true
end

-- sitting: a Seat, the Seated state, or the body welded to something that is not part of us
-- (maps with their own seats or vehicles)
function DHAnim.IsSeated(hum)
    if not hum then return false end
    if hum.Sit or hum.SeatPart or hum:GetState() == Enum.HumanoidStateType.Seated then return true end
    local root, char = hum.RootPart, hum.Parent
    if not (root and char) then return false end
    local ok, joints = pcall(function() return root:GetJoints() end)
    if not ok or not joints then return false end
    for _, j in ipairs(joints) do
        local a, b
        pcall(function() a, b = j.Part0, j.Part1 end)
        local other = (a == root) and b or a
        if other and other ~= root and not other:IsDescendantOf(char) then return true end
    end
    return false
end
-- tracks the map plays on purpose (crawl, vent, emote) use the Action priorities
function DHAnim.IsMapAction(t)
    local p = t.Priority
    if not (p == Enum.AnimationPriority.Action or p == Enum.AnimationPriority.Action2
        or p == Enum.AnimationPriority.Action3 or p == Enum.AnimationPriority.Action4) then
        return false
    end
    if DHAnim.CtlTracks then
        for _, mine in pairs(DHAnim.CtlTracks) do
            if mine == t then return false end
        end
    end
    return true
end

function DHAnim.MapBusy()
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local an = hum and hum:FindFirstChildOfClass("Animator")
    if not an then return false end
    for _, t in ipairs(an:GetPlayingAnimationTracks()) do
        if t.IsPlaying and DHAnim.IsMapAction(t) then return true end
    end
    return false
end

-- true when the map plays its own animations instead of the ones we set
function DHAnim.NeedCtl()
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local an = hum and hum:FindFirstChildOfClass("Animator")
    local sel = DHAnim.Sel
    if not (an and sel) then return false end
    local st = hum:GetState()
    if DHAnim.IsSeated(hum) then return false end
    -- an emote is playing: that is not the map replacing our animations
    if ECurrentAnim and ECurrentAnim.IsPlaying then return false end
    if st ~= Enum.HumanoidStateType.Running and st ~= Enum.HumanoidStateType.RunningNoPhysics then
        return false
    end
    local ok, any = {}, false
    local function add(e)
        if e then
            for _, id in ipairs(e.ids) do ok[tostring(id)] = true; any = true end
        end
    end
    if hum.MoveDirection.Magnitude > 0.1 then
        add(sel.run); add(sel.walk)
    else
        add(sel.idle)
    end
    if not any then return false end
    for _, t in ipairs(an:GetPlayingAnimationTracks()) do
        local n = t.Animation and tostring(t.Animation.AnimationId):match("%d+")
        if n and ok[n] then DHAnim.Healthy = true return false end
    end
    -- the animations worked before and now the map plays an action (crawl, vent): not a replacement
    if DHAnim.Healthy and DHAnim.MapBusy() then return false end
    return true
end

function DHAnim.Commit()
    if DHAnim.Sel and next(DHAnim.Sel) then
        DHAnim.CTok = (DHAnim.CTok or 0) + 1
        local my = DHAnim.CTok
        DHAnim.BusyT = tick()
        task.spawn(function()
            DHAnim.CtlStop()
            local ok, why = DHAnim.Apply()
            local over = false
            if ok then
                DHAnim.Mode = "Animate"
                task.wait(1.2)
                if DHAnim.CTok ~= my then return end
                if DHAnim.NeedCtl() and DHAnim.CtlStart() then over = true end
            elseif why ~= "nothing selected" and why ~= "character is not R15" then
                if DHAnim.CtlStart() then
                    ok = true
                    over = true
                end
            end
            if DHAnim.CTok ~= my then return end
            if over then
                DHAnim.Mode = "Override"
            elseif ok then
                DHAnim.Mode = "Animate"
            else
                DHAnim.Mode = nil
            end
            DHAnim.BusyT = 0
            DHAnim.Badge()
            if ok then
                DHAnim.Say("Applied" .. (over and " (override mode)" or "") .. ": " .. DHAnim.Summary())
            else
                DHAnim.Say("Could not apply: " .. tostring(why or "unknown"))
            end
        end)
    else
        DHAnim.Restore()
    end
end

function DHAnim.Summary()
    local parts = {}
    for _, slot in ipairs(DHAnim.SlotOrder) do
        local e = DHAnim.Sel and DHAnim.Sel[slot]
        if e then parts[#parts + 1] = DHAnim.SlotLabel[slot] .. ": " .. e.name end
    end
    if #parts == 0 then return "Nothing selected (your normal animations)" end
    return table.concat(parts, "  |  ")
end

function DHAnim.Say(t)
    if DHAnim.SetInfo then DHAnim.SetInfo(t) end
    if DHAnim.Status then DHAnim.Status.Text = t end
end

-- one tap: use the whole pack (like the Emote tab). Tap again to remove it.
function DHAnim.QuickUse(item, btn)
    if DHAnim.QBusy then return end
    local mine = false
    if DHAnim.Sel then
        for slot, e in pairs(DHAnim.Sel) do
            if e.bundle == item.Id then
                DHAnim.Sel[slot] = nil
                mine = true
            end
        end
    end
    if mine then
        DHAnim.QConf = nil
        DHAnim.MarkUsing()
        DHAnim.Commit()
        return
    end
    DHAnim.QBusy = true
    btn.Text = "Loading..."
    task.spawn(function()
        local d = DHAnim.Resolve(item.Id)
        DHAnim.QBusy = false
        if not d then
            btn.Text = "Failed"
            DHAnim.Say("Could not read this pack. " .. (DHAnim.Dbg or ""))
            task.delay(2, function() DHAnim.MarkUsing() end)
            return
        end
        local conflict = false
        for slot in pairs(d.slots) do
            local e = DHAnim.Sel and DHAnim.Sel[slot]
            if e and e.bundle ~= item.Id then conflict = true end
        end
        if conflict and DHAnim.QConf ~= item.Id then
            DHAnim.QConf = item.Id
            btn.Text = "Replace?"
            btn.BackgroundColor3 = Color3.fromRGB(30, 120, 200)
            task.delay(4, function()
                if DHAnim.QConf == item.Id then
                    DHAnim.QConf = nil
                    DHAnim.MarkUsing()
                end
            end)
            return
        end
        DHAnim.QConf = nil
        DHAnim.Sel = DHAnim.Sel or {}
        for slot, ids in pairs(d.slots) do
            DHAnim.Sel[slot] = {bundle = item.Id, name = item.Name or "Pack", ids = ids}
        end
        DHAnim.MarkUsing()
        DHAnim.Commit()
    end)
end

-- shows the state at the top right of the tab: ● Animate / ● Override, plus how many times it was fixed
function DHAnim.Badge()
    if not DHAnim.ModeLbl then return end
    if DHAnim.Mode then
        local t = "● " .. DHAnim.Mode
        if (DHAnim.Fixes or 0) > 0 then t = t .. "  ↻" .. DHAnim.Fixes end
        DHAnim.ModeLbl.Text = t
    else
        DHAnim.ModeLbl.Text = ""
    end
end

-- the map may reset or replace the animations after we set them: check and put them back
function DHAnim.Guard()
    if DHAnim.GuardOn then return end
    DHAnim.GuardOn = true
    task.spawn(function()
        local strikes = 0
        while ScreenGui and ScreenGui.Parent do
            task.wait(1.5)
            local sel = DHAnim.Sel
            local idle = tick() - (DHAnim.BusyT or 0) > 6 and not DHAnim.IsSeated(Player.Character and Player.Character:FindFirstChildOfClass("Humanoid"))
            if sel and next(sel) and DHAnim.Mode and idle then
                local lost = false
                local char = Player.Character
                if DHAnim.Mode == "Animate" then
                    if DHAnim.Char ~= char then
                        lost = true
                    elseif DHAnim.Applied then
                        for inst, id in pairs(DHAnim.Applied) do
                            if (not inst.Parent) or inst.AnimationId ~= id then
                                lost = true
                                break
                            end
                        end
                    end
                    if not lost then
                        if DHAnim.NeedCtl() then strikes = strikes + 1 else strikes = 0 end
                        if strikes >= 3 then
                            strikes = 0
                            if DHAnim.CtlStart() then
                                DHAnim.Mode = "Override"
                                DHAnim.Healthy = nil
                                DHAnim.Badge()
                                DHAnim.Say("The map plays its own animations: switched to override mode")
                            end
                        end
                    end
                else
                    if DHAnim.CtlChar ~= char or not DHAnim.CtlConn then lost = true end
                end
                if lost then
                    DHAnim.Fixes = (DHAnim.Fixes or 0) + 1
                    DHAnim.Commit()
                    task.wait(3)
                end
            else
                strikes = 0
            end
        end
    end)
end

-- after a respawn the game gives a fresh Animate script: apply the selection again
function DHAnim.Watch()
    if DHAnim.conn then return end
    DHAnim.conn = Player.CharacterAdded:Connect(function(char)
        if not (DHAnim.Sel and next(DHAnim.Sel)) then return end
        char:WaitForChild("Animate", 10)
        task.wait(1)
        if DHAnim.Sel and Player.Character == char then
            DHAnim.Commit()
        end
    end)
    ScreenGui.Destroying:Connect(function()
        DHAnim.Restore()
    end)
    DHAnim.Guard()
end

