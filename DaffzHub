-- ================================================
-- CROSSHAIR: drawn on screen in Lucide style (type the icon name or tap one), position, rotate, spin, color
-- ================================================
DHXh = {
    On = false, Shape = "crosshair", Size = 40, Thick = 2, X = 0, Y = 0, Rot = 0,
    Spin = false, SpinSpeed = 90, Angle = 0, Rgb = false, Hue = 0,
    Color = Color3.fromRGB(255, 60, 60), Parts = {}, CustomId = nil,
}

DHXh.Names = {"crosshair", "target", "locate", "locate-fixed", "circle-dot", "plus", "scan", "focus", "x", "minus", "dot", "square-dot"}

DHXh.Colors = {
    Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 60, 60), Color3.fromRGB(60, 255, 100), Color3.fromRGB(70, 140, 255),
    Color3.fromRGB(255, 230, 60), Color3.fromRGB(60, 240, 255), Color3.fromRGB(255, 80, 230), Color3.fromRGB(255, 150, 40),
}

function DHXh.Say(text)
    if DHXh.Msg then DHXh.Msg.Text = text end
end

function DHXh.Paint()
    local c = DHXh.Rgb and Color3.fromHSV(DHXh.Hue, 1, 1) or DHXh.Color
    for _, p in ipairs(DHXh.Parts) do
        local o, k = p[1], p[2]
        if k == "fill" then
            o.BackgroundColor3 = c
        elseif k == "stroke" then
            o.Color = c
        else
            o.ImageColor3 = c
        end
    end
end

function DHXh.Draw()
    local root = DHXh.Root
    if not root then return end
    for _, c in ipairs(root:GetChildren()) do c:Destroy() end
    DHXh.Parts = {}
    local S, T = DHXh.Size, DHXh.Thick
    local u = S / 24
    root.Size = UDim2.fromOffset(S, S)

    -- a filled rectangle: x, y from the top left of the crosshair, width, height, optional rotation
    local function fill(x, y, w, h, rot)
        local f = Instance.new("Frame", root)
        f.BorderSizePixel = 0
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.fromOffset(x + w / 2, y + h / 2)
        f.Size = UDim2.fromOffset(w, h)
        if rot then f.Rotation = rot end
        DHXh.Parts[#DHXh.Parts + 1] = {f, "fill"}
    end
    local function hbar(x1, x2) fill(x1 * u, S / 2 - T / 2, (x2 - x1) * u, T) end
    local function vbar(y1, y2) fill(S / 2 - T / 2, y1 * u, T, (y2 - y1) * u) end
    local function ring(d, corner)
        local f = Instance.new("Frame", root)
        f.BackgroundTransparency = 1
        f.BorderSizePixel = 0
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.fromScale(0.5, 0.5)
        f.Size = UDim2.fromOffset(d * u, d * u)
        Instance.new("UICorner", f).CornerRadius = corner or UDim.new(1, 0)
        local s = Instance.new("UIStroke", f)
        s.Thickness = T
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        DHXh.Parts[#DHXh.Parts + 1] = {s, "stroke"}
    end
    local function dot(d)
        local dd = math.max(d * u, T)
        local f = Instance.new("Frame", root)
        f.BorderSizePixel = 0
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.fromScale(0.5, 0.5)
        f.Size = UDim2.fromOffset(dd, dd)
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        DHXh.Parts[#DHXh.Parts + 1] = {f, "fill"}
    end
    -- scan corners (sx, sy = which corner)
    local function corner(sx, sy)
        local ox = (sx == 1) and 3 * u or 21 * u
        local oy = (sy == 1) and 3 * u or 21 * u
        local hx = (sx == 1) and (ox - T / 2) or (ox - 5 * u + T / 2)
        local vy = (sy == 1) and (oy - T / 2) or (oy - 5 * u + T / 2)
        fill(hx, oy - T / 2, 5 * u, T)
        fill(ox - T / 2, vy, T, 5 * u)
    end
    local function corners()
        corner(1, 1)
        corner(-1, 1)
        corner(1, -1)
        corner(-1, -1)
    end

    local shape = DHXh.Shape
    if shape == "crosshair" then
        ring(20) hbar(2, 6) hbar(18, 22) vbar(2, 6) vbar(18, 22)
    elseif shape == "target" then
        ring(20) ring(12) ring(4)
    elseif shape == "locate" then
        ring(14) hbar(2, 5) hbar(19, 22) vbar(2, 5) vbar(19, 22)
    elseif shape == "locate-fixed" then
        ring(14) hbar(2, 5) hbar(19, 22) vbar(2, 5) vbar(19, 22) dot(6)
    elseif shape == "circle-dot" then
        ring(20) dot(5)
    elseif shape == "plus" then
        hbar(5, 19) vbar(5, 19)
    elseif shape == "scan" then
        corners()
    elseif shape == "focus" then
        corners() dot(6)
    elseif shape == "x" then
        fill(S / 2 - 8.5 * u, S / 2 - T / 2, 17 * u, T, 45)
        fill(S / 2 - 8.5 * u, S / 2 - T / 2, 17 * u, T, -45)
    elseif shape == "minus" then
        hbar(5, 19)
    elseif shape == "dot" then
        dot(6)
    elseif shape == "square-dot" then
        ring(18, UDim.new(0, 2 * u))
        dot(4)
    elseif shape == "custom" and DHXh.CustomId then
        local img = Instance.new("ImageLabel", root)
        img.BackgroundTransparency = 1
        img.Size = UDim2.new(1, 0, 1, 0)
        img.Image = "rbxassetid://" .. tostring(DHXh.CustomId)
        DHXh.Parts[#DHXh.Parts + 1] = {img, "image"}
    end
    DHXh.Paint()
end

function DHXh.Refresh()
    local root = DHXh.Root
    if not root then return end
    root.Position = UDim2.new(0.5, DHXh.X, 0.5, DHXh.Y)
    root.Rotation = DHXh.Rot + DHXh.Angle
    DHXh.Draw()
end

function DHXh.Set(on)
    DHXh.On = on and true or false
    if DHXh.Conn then
        DHXh.Conn:Disconnect()
        DHXh.Conn = nil
    end
    if DHXh.Gui then
        DHXh.Gui:Destroy()
        DHXh.Gui, DHXh.Root = nil, nil
    end
    if not DHXh.On then return end
    local g = Instance.new("ScreenGui")
    g.Name = "DH_Crosshair"
    g.IgnoreGuiInset = true
    g.ResetOnSpawn = false
    g.DisplayOrder = 20
    g.Parent = ScreenGui.Parent
    local root = Instance.new("Frame", g)
    root.BackgroundTransparency = 1
    root.BorderSizePixel = 0
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    DHXh.Gui, DHXh.Root = g, root
    DHXh.Refresh()
    DHXh.Conn = RunService.RenderStepped:Connect(function(dt)
        if DHXh.Spin then DHXh.Angle = (DHXh.Angle + DHXh.SpinSpeed * dt) % 360 end
        root.Rotation = DHXh.Rot + DHXh.Angle
        if DHXh.Rgb then
            DHXh.Hue = (DHXh.Hue + dt * 0.25) % 1
            DHXh.Paint()
        end
    end)
end

function DHXh.MarkChips()
    if not DHXh.Chips then return end
    for n, b in pairs(DHXh.Chips) do
        b.BackgroundColor3 = (n == DHXh.Shape) and Color3.fromRGB(40, 140, 200) or Color3.fromRGB(55, 55, 55)
    end
end

-- text: a Lucide icon name, any capitals or spaces are fine
function DHXh.Pick(text)
    local name = (text or ""):lower():gsub("^%s+", ""):gsub("%s+$", ""):gsub("[%s_]+", "-")
    if name == "" then return end
    if table.find(DHXh.Names, name) then
        DHXh.Shape = name
        DHXh.Say("Shape: " .. name)
        DHXh.MarkChips()
        DHXh.Refresh()
    else
        DHXh.Say('"' .. name .. '" is not in the DaffzHub list. Use: ' .. table.concat(DHXh.Names, ", "))
    end
end

