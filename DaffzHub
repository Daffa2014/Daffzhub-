function DHMS.Search(q)
    q = (q or ""):match("^%s*(.-)%s*$")
    if q == "" or DHMS.Busy then return end
    DHMS.Busy = true
    DHMS.Status.Text = "Searching..."
    DHMS.Clear()
    task.spawn(function()
        local ok, res = pcall(function()
            local p = Instance.new("AudioSearchParams")
            p.SearchKeyword = q
            local pages = game:GetService("AssetService"):SearchAudioAsync(p)
            return pages:GetCurrentPage()
        end)
        DHMS.Busy = false
        if not DHMS.List.Parent then return end
        if not ok then
            DHMS.Status.Text = "Search is not available here: " .. string.sub(tostring(res), 1, 60)
            return
        end
        if type(res) ~= "table" or #res == 0 then
            DHMS.Status.Text = "No results."
            return
        end
        local n = math.min(#res, 25)
        for i = 1, n do
            pcall(DHMS.AddRow, res[i])
        end
        DHMS.Status.Text = n .. " results. ↑ puts the ID in the box, 💾 saves it."
    end)
end

