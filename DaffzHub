function DHVisual.AddSlider(box, titleText, min, max, default, decimals, callback)
    local UIS = game:GetService("UserInputService")
    local dec = decimals or 0

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 54)
    row.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    row.BorderSizePixel = 0
    row.LayoutOrder = DHVisual.Next(box)
    row.Parent = box
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -90, 0, 20)
    lbl.Position = UDim2.new(0, 10, 0, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = titleText
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextColor3 = Color3.new(1, 1, 1)
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local val = Instance.new("TextLabel", row)
    val.Size = UDim2.new(0, 70, 0, 20)
    val.Position = UDim2.new(1, -80, 0, 6)
    val.BackgroundTransparency = 1
    val.Font = Enum.Font.GothamBold
    val.TextSize = 13
    val.TextColor3 = Color3.fromRGB(100, 200, 255)
    val.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame", row)
    track.Size = UDim2.new(1, -20, 0, 8)
    track.Position = UDim2.new(0, 10, 0, 36)
    track.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(100, 200, 255)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local hit = Instance.new("TextButton", row)
    hit.Size = UDim2.new(1, -20, 0, 30)
    hit.Position = UDim2.new(0, 10, 0, 24)
    hit.BackgroundTransparency = 1
    hit.Text = ""

    local value = math.clamp(default, min, max)
    local function show()
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        val.Text = string.format("%." .. dec .. "f", value)
    end
    local function setFrom(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local m = 10 ^ dec
        local v = math.floor((min + (max - min) * a) * m + 0.5) / m
        if v ~= value then
            value = v
            show()
            if callback then callback(v) end
        end
    end

    local dragging = false
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFrom(i.Position.X)
        end
    end)
    local c1 = UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFrom(i.Position.X)
        end
    end)
    local c2 = UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    DHVisual.OnCleanup(function()
        c1:Disconnect()
        c2:Disconnect()
    end)
    show()

    return {
        Set = function(v, silent)
            value = math.clamp(v, min, max)
            show()
            if not silent and callback then callback(value) end
        end,
        Get = function() return value end,
    }
end

