-- ================================================
-- SHARED FPS / PING METRICS
-- One measurement used by BOTH the Info Tab and Other Settings,
-- so the numbers are always identical and stable (averaged over DHMetrics.interval).
--   FPS  = frames rendered / elapsed time (not the speed of a single frame)
--   Ping = Roblox "Data Ping" (round trip incl. replication delay, i.e. what you feel in game);
--          falls back to Player:GetNetworkPing() if it is unavailable
-- ================================================
DHMetrics = {fps = 0, ping = 0, interval = 0.5, listeners = {}}

function DHFpsColor(f)
    return f >= 55 and Color3.fromRGB(0, 255, 0) or f >= 30 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 70, 70)
end

function DHPingColor(p)
    return p <= 100 and Color3.fromRGB(0, 255, 0) or p <= 250 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 70, 70)
end

DHMetrics.serverStart = ServerStartTime

function DHMetricsStart()
    if DHMetrics.conn then return end
    local Stats = game:GetService("Stats")
    local acc, frames = 0, 0
    DHMetrics.conn = RunService.RenderStepped:Connect(function(dt)
        acc = acc + dt
        frames = frames + 1
        if acc < DHMetrics.interval then return end

        DHMetrics.fps = math.floor(frames / acc + 0.5)
        acc, frames = 0, 0

        local raw = nil
        pcall(function() raw = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        if not raw or raw <= 0 then
            pcall(function() raw = Player:GetNetworkPing() * 1000 end)
        end
        DHMetrics.ping = math.floor((raw or 0) + 0.5)

        for _, fn in ipairs(DHMetrics.listeners) do
            pcall(fn, DHMetrics)
        end
    end)
end

-- Info Tab: update from the shared metrics
table.insert(DHMetrics.listeners, function(m)

    FPSValue.Text = tostring(m.fps)
    FPSValue.TextColor3 = DHFpsColor(m.fps)

    PingValue.Text = m.ping .. " MS"
    PingValue.TextColor3 = DHPingColor(m.ping)

    local uptime = os.time() - ServerStartTime
    local h = math.floor(uptime / 3600)
    local mm = math.floor((uptime % 3600) / 60)
    local s = uptime % 60
    ServerTimeValue.Text = string.format("%d:%02d:%02d", h, mm, s)

    PlayersValue.Text = #Players:GetPlayers() .. "/" .. game.Players.MaxPlayers
end)

-- Statistics table: fed from the same shared metrics (the first 2 seconds are skipped)
table.insert(DHMetrics.listeners, function(m)
    local T = DHStatTable
    if not (T and T.Rows) then return end
    T.Warm = T.Warm + 1
    if T.Warm <= 4 then return end
    if m.fps > 0 then T.Push("fps", m.fps) end
    if m.ping > 0 then T.Push("ping", m.ping) end
    T.Push("players", #Players:GetPlayers())
    local vIn = T.ReadNet("in")
    local vOut = T.ReadNet("out")
    local okMem, vMem = pcall(function() return game:GetService("Stats"):GetTotalMemoryUsageMb() end)
    if okMem and type(vMem) == "number" then T.Push("netin", vMem) end
    if vOut then T.Push("netout", vOut) end
end)

DHMetricsStart()

