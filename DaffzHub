-- ================================================
-- THEME: change the look of the hub (border, background, accent, corners, size) in the Setting tab, and save it
-- ================================================
DHTheme = {
    Path = "Daffzhub_file/Setting/Theme.json",
    Def = {
        border = {255, 255, 255}, bdThick = 1, bdTrans = 0.2, rgb = false, rgbSpd = 1,
        bg = {15, 15, 15}, panel = {20, 20, 20}, card = {25, 25, 25}, accent = {35, 160, 90},
        text = {100, 200, 255},
        bgTrans = 0, round = 100, w = 500, h = 330,
    },
    Cur = {},
    RoleOf = setmetatable({}, {__mode = "k"}),   -- instance -> "bg" / "panel" / "card" / "accent" (background color)
    TRole = setmetatable({}, {__mode = "k"}),    -- instance -> accent (text color)
    R0 = setmetatable({}, {__mode = "k"}),       -- UICorner -> its original radius
    Hooked = setmetatable({}, {__mode = "k"}),
    Skip = setmetatable({}, {__mode = "k"}),
    T0 = setmetatable({}, {__mode = "k"}),       -- original background transparency
    On = false,
    Busy = false,
    Target = "border",
}

function DHTheme.Copy(t)
    local c = {}
    for k, v in pairs(t) do
        if type(v) == "table" then c[k] = {v[1], v[2], v[3]} else c[k] = v end
    end
    return c
end
DHTheme.Cur = DHTheme.Copy(DHTheme.Def)

function DHTheme.Key(c)
    return math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5)
end

-- the colors the hub uses by default; whatever has one of these colors follows the theme
DHTheme.Roles = {
    [15 * 65536 + 15 * 256 + 15] = "bg",
    [20 * 65536 + 20 * 256 + 20] = "panel",
    [25 * 65536 + 25 * 256 + 25] = "card",
    [35 * 65536 + 160 * 256 + 90] = "accent",
    [30 * 65536 + 180 * 256 + 30] = "accent",
}
DHTheme.TextRoles = {
    [100 * 65536 + 200 * 256 + 255] = "accent",
}

function DHTheme.Col(name)
    local v = DHTheme.Cur[name]
    return Color3.fromRGB(v[1], v[2], v[3])
end

function DHTheme.Trans(o, r)
    local t0 = DHTheme.T0[o] or 0
    if r == "accent" then return t0 end
    return 1 - (1 - t0) * (1 - DHTheme.Cur.bgTrans)
end

function DHTheme.Tag(o)
    if DHTheme.Skip[o] then return end
    if o:IsA("GuiObject") then
        if not DHTheme.RoleOf[o] and o.BackgroundTransparency < 1 then
            local r = DHTheme.Roles[DHTheme.Key(o.BackgroundColor3)]
            if r then
                DHTheme.RoleOf[o] = r
                DHTheme.T0[o] = o.BackgroundTransparency
            end
        end
        if (o:IsA("TextLabel") or o:IsA("TextButton")) and not DHTheme.TRole[o] then
            if DHTheme.TextRoles[DHTheme.Key(o.TextColor3)] then DHTheme.TRole[o] = true end
        end
        -- buttons change color when toggled: keep the new color in the theme too
        if o:IsA("TextButton") and not DHTheme.Hooked[o] then
            DHTheme.Hooked[o] = true
            o:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
                if DHTheme.Busy or not DHTheme.On then return end
                local r = DHTheme.Roles[DHTheme.Key(o.BackgroundColor3)]
                if r then
                    DHTheme.RoleOf[o] = r
                    DHTheme.Busy = true
                    o.BackgroundColor3 = DHTheme.Col(r)
                    o.BackgroundTransparency = DHTheme.Trans(o, r)
                    DHTheme.Busy = false
                                elseif DHTheme.RoleOf[o] then
                    -- the button left the theme colors (for example Touch Fling went back to red): forget it
                    DHTheme.RoleOf[o] = nil
                    o.BackgroundTransparency = DHTheme.T0[o] or 0
                end
            end)
        end
    elseif o:IsA("UICorner") then
        if not DHTheme.R0[o] and o.CornerRadius.Scale == 0 then
            DHTheme.R0[o] = o.CornerRadius.Offset
        end
    end
end

function DHTheme.Paint(o)
    local r = DHTheme.RoleOf[o]
    if r then
        o.BackgroundColor3 = DHTheme.Col(r)
        o.BackgroundTransparency = DHTheme.Trans(o, r)
    end
   if DHTheme.TRole[o] then o.TextColor3 = DHTheme.Col("text") end
    local r0 = DHTheme.R0[o]
    if r0 then
        o.CornerRadius = UDim.new(0, math.floor(r0 * DHTheme.Cur.round / 100 + 0.5))
    end
end

function DHTheme.Engage()
    if DHTheme.On then return end
    DHTheme.On = true
    DHTheme.AddConn = Main.DescendantAdded:Connect(function(o)
        task.defer(function()
            if not DHTheme.On then return end
            DHTheme.Busy = true
            pcall(DHTheme.Tag, o)
            pcall(DHTheme.Paint, o)
            DHTheme.Busy = false
        end)
    end)
    local n = 0
    pcall(DHTheme.Tag, Main)
    for _, o in ipairs(Main:GetDescendants()) do
        pcall(DHTheme.Tag, o)
        n = n + 1
        if n % 1500 == 0 then task.wait() end
    end
end

function DHTheme.Strokes()
    local list = {}
    local ms = Main:FindFirstChildOfClass("UIStroke")
    if ms then list[#list + 1] = ms end
    local ts = TabFrame:FindFirstChildOfClass("UIStroke")
    if ts then list[#list + 1] = ts end
    for _, c in ipairs(TabFrame:GetChildren()) do
        if c:IsA("TextButton") then
            local s = c:FindFirstChildOfClass("UIStroke")
            if s then list[#list + 1] = s end
        end
    end
    return list
end

function DHTheme.SetRgb(on)
    if DHTheme.RgbConn then
        DHTheme.RgbConn:Disconnect()
        DHTheme.RgbConn = nil
    end
    if on then
        local list = DHTheme.Strokes()
        local t = 0
        DHTheme.RgbConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
            t = t + dt * DHTheme.Cur.rgbSpd * 0.15
            local c = Color3.fromHSV(t % 1, 1, 1)
            for _, s in ipairs(list) do
                if s.Parent then s.Color = c end
            end
        end)
    end
end

function DHTheme.Apply()
    local C = DHTheme.Cur
    DHTheme.Engage()
    DHTheme.Busy = true

    for o in pairs(DHTheme.RoleOf) do pcall(DHTheme.Paint, o) end
    for o in pairs(DHTheme.TRole) do pcall(DHTheme.Paint, o) end
    for o in pairs(DHTheme.R0) do pcall(DHTheme.Paint, o) end

    local bc = DHTheme.Col("border")
    for _, s in ipairs(DHTheme.Strokes()) do
        s.Thickness = C.bdThick
        s.Transparency = C.bdTrans
        if not C.rgb then s.Color = bc end
    end
    DHTheme.SetRgb(C.rgb)

    -- window size, keeping the window centered where it is
    local cur = Main.Size
    local dw, dh = C.w - cur.X.Offset, C.h - cur.Y.Offset
    if dw ~= 0 or dh ~= 0 then
        Main.Size = UDim2.new(0, C.w, 0, C.h)
        local p = Main.Position
        Main.Position = UDim2.new(p.X.Scale, p.X.Offset - dw / 2, p.Y.Scale, p.Y.Offset - dh / 2)
    end

    DHTheme.Busy = false
end

-- many slider moves in a row only repaint a few times per second
function DHTheme.Queue()
    if DHTheme.Pending then return end
    DHTheme.Pending = true
    task.delay(0.05, function()
        DHTheme.Pending = false
        pcall(DHTheme.Apply)
    end)
end

function DHTheme.Say(text)
    if DHTheme.Status then
        DHTheme.Status.Text = text
        task.delay(3, function()
            if DHTheme.Status and DHTheme.Status.Text == text then DHTheme.Status.Text = "" end
        end)
    end
end

function DHTheme.Save()
    local ok = pcall(function()
        if not (writefile and makefolder and isfolder) then error("no file access") end
        if not isfolder("Daffzhub_file") then makefolder("Daffzhub_file") end
        if not isfolder("Daffzhub_file/Setting") then makefolder("Daffzhub_file/Setting") end
        writefile(DHTheme.Path, game:GetService("HttpService"):JSONEncode(DHTheme.Cur))
    end)
    DHTheme.Say(ok and "Theme saved" or "Could not save (no file access)")
end

function DHTheme.Load()
    local found = false
    pcall(function()
        if not (isfile and readfile and isfile(DHTheme.Path)) then return end
        local data = game:GetService("HttpService"):JSONDecode(readfile(DHTheme.Path))
        if type(data) ~= "table" then return end
        for k, d in pairs(DHTheme.Def) do
            local v = data[k]
            if type(d) == "table" then
                if type(v) == "table" and tonumber(v[1]) and tonumber(v[2]) and tonumber(v[3]) then
                    DHTheme.Cur[k] = {math.clamp(v[1], 0, 255), math.clamp(v[2], 0, 255), math.clamp(v[3], 0, 255)}
                end
            elseif type(v) == type(d) then
                DHTheme.Cur[k] = v
            end
        end
        found = true
    end)
    return found
end

-- a slider row; returns {Set = function(value)} (Set does not call the callback)
function DHTheme.Slider(parent, y, name, min, max, step, fmt, init, cb)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -20, 0, 36)
    row.Position = UDim2.new(0, 10, 0, y)
    row.BackgroundTransparency = 1
    DHTheme.Skip[row] = true

    local nm = Instance.new("TextLabel", row)
    nm.Size = UDim2.new(1, -70, 0, 16)
    nm.BackgroundTransparency = 1
    nm.Text = name
    nm.Font = Enum.Font.GothamBold
    nm.TextSize = 12
    nm.TextColor3 = Color3.new(1, 1, 1)
    nm.TextXAlignment = Enum.TextXAlignment.Left

    local val = Instance.new("TextLabel", row)
    val.Size = UDim2.new(0, 64, 0, 16)
    val.Position = UDim2.new(1, -64, 0, 0)
    val.BackgroundTransparency = 1
    val.Font = Enum.Font.GothamBold
    val.TextSize = 12
    val.TextColor3 = Color3.fromRGB(100, 200, 255)
    val.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame", row)
    bar.Size = UDim2.new(1, -8, 0, 6)
    bar.Position = UDim2.new(0, 4, 0, 26)
    bar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    bar.BorderSizePixel = 0
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 3)
    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(35, 160, 90)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)
    local knob = Instance.new("Frame", bar)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    DHTheme.Skip[knob] = true

    -- a wide invisible area so the bar is easy to hit with a thumb
    local hit = Instance.new("TextButton", row)
    hit.Size = UDim2.new(1, 0, 0, 26)
    hit.Position = UDim2.new(0, 0, 0, 14)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    DHTheme.Skip[hit] = true

    local api = {}
    local function Show(v)
        v = math.clamp(v, min, max)
        local r = (v - min) / (max - min)
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, 0, 0.5, 0)
        local shown = v
        if string.find(fmt, "%d", 1, true) then shown = math.floor(v + 0.5) end
        val.Text = string.format(fmt, shown)
    end
    function api.Set(v) Show(v) end

    local dragging = false
    local function FromInput(input)
        local r = math.clamp((input.Position.X - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
        local v = min + (max - min) * r
        v = math.floor(v / step + 0.5) * step
        Show(v)
        pcall(cb, v)
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            SettingScroll.ScrollingEnabled = false
            FromInput(input)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            FromInput(input)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            SettingScroll.ScrollingEnabled = true
        end
    end)
    Show(init)
    return api
end

function DHTheme.Build()
    if not (SettingScroll and SettingsContainer) then return end
    local C = DHTheme.Cur

    local box = Instance.new("Frame", SettingScroll)
    box.Name = "DH_Theme"
    box.Size = UDim2.new(1, 0, 0, 640)
    box.Position = UDim2.new(0, 0, 0, 0)
    box.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    box.ClipsDescendants = true
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
    -- the old Setting container moves below the theme box
    SettingsContainer.Position = UDim2.new(0, 0, 0, 650)
    
    -- other containers of the Setting tab (e.g. Other Settings) sit at fixed heights: move them down too
    for _, o in ipairs(SettingScroll:GetChildren()) do
        if o:IsA("Frame") and o ~= box and o ~= SettingsContainer and o.Position.Y.Offset >= 1000 then
            o.Position = UDim2.new(0, 0, 0, o.Position.Y.Offset + 650)
        end
    end
    SettingScroll.ChildAdded:Connect(function(o)
        task.defer(function()
            if o:IsA("Frame") and o ~= box and o ~= SettingsContainer and o.Position.Y.Offset >= 1000 and o.Position.Y.Offset < 1650 then
                o.Position = UDim2.new(0, 0, 0, o.Position.Y.Offset + 650)
            end
        end)
    end)

    local function Label(text, y, size, color)
        local l = Instance.new("TextLabel", box)
        l.Size = UDim2.new(1, -20, 0, 20)
        l.Position = UDim2.new(0, 10, 0, y)
        l.BackgroundTransparency = 1
        l.Text = text
        l.Font = Enum.Font.GothamBold
        l.TextSize = size
        l.TextColor3 = color
        l.TextXAlignment = Enum.TextXAlignment.Left
        return l
    end
    local function Btn(text, x0, w0, y, h, color, parent)
        local b = Instance.new("TextButton", parent or box)
        b.Position = UDim2.new(x0, 0, 0, y)
        b.Size = UDim2.new(w0, -4, 0, h)
        b.Text = text
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.TextColor3 = Color3.new(1, 1, 1)
        b.BackgroundColor3 = color
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        return b
    end

    Label("THEME", 6, 16, Color3.fromRGB(100, 200, 255))

    -- color editor: pick what to color, then slide R / G / B
    Label("Color of:", 34, 12, Color3.fromRGB(200, 200, 200))
    local targets = {{"border", "Border"}, {"bg", "Back"}, {"panel", "Panel"}, {"card", "Card"}, {"accent", "Accent"}, {"text", "Title"}}
    local tbtns = {}
    local sw = Instance.new("Frame", box)
    DHTheme.Skip[sw] = true
    local hex = Instance.new("TextLabel", box)
    local sl = {}

    local function Refresh()
        for key, b in pairs(tbtns) do
            b.BackgroundColor3 = (key == DHTheme.Target) and Color3.fromRGB(70, 110, 200) or Color3.fromRGB(45, 45, 45)
        end
        local v = C[DHTheme.Target]
        sw.BackgroundColor3 = Color3.fromRGB(v[1], v[2], v[3])
        hex.Text = string.format("R %d   G %d   B %d", v[1], v[2], v[3])
        for i = 1, 3 do sl[i].Set(v[i]) end
    end

    local trow = Instance.new("Frame", box)
    trow.Size = UDim2.new(1, -20, 0, 28)
    trow.Position = UDim2.new(0, 10, 0, 56)
    trow.BackgroundTransparency = 1
    for i, t in ipairs(targets) do
        local b = Btn(t[2], (i - 1) / 6, 1 / 6, 0, 28, Color3.fromRGB(45, 45, 45), trow)
        DHTheme.Skip[b] = true
        tbtns[t[1]] = b
        b.MouseButton1Click:Connect(function()
            DHTheme.Target = t[1]
            Refresh()
        end)
    end

    sw.Size = UDim2.new(0, 36, 0, 22)
    sw.Position = UDim2.new(0, 10, 0, 92)
    sw.BorderSizePixel = 0
    Instance.new("UICorner", sw).CornerRadius = UDim.new(0, 5)
    local sws = Instance.new("UIStroke", sw)
    sws.Color = Color3.new(1, 1, 1)
    sws.Transparency = 0.5
    hex.Size = UDim2.new(1, -60, 0, 22)
    hex.Position = UDim2.new(0, 54, 0, 92)
    hex.BackgroundTransparency = 1
    hex.Font = Enum.Font.GothamBold
    hex.TextSize = 12
    hex.TextColor3 = Color3.new(1, 1, 1)
    hex.TextXAlignment = Enum.TextXAlignment.Left

    local names = {"Red", "Green", "Blue"}
    for i = 1, 3 do
        sl[i] = DHTheme.Slider(box, 118 + (i - 1) * 38, names[i], 0, 255, 1, "%d", C[DHTheme.Target][i], function(v)
            C[DHTheme.Target][i] = v
            local c = C[DHTheme.Target]
            sw.BackgroundColor3 = Color3.fromRGB(c[1], c[2], c[3])
            hex.Text = string.format("R %d   G %d   B %d", c[1], c[2], c[3])
            DHTheme.Queue()
        end)
    end

    Label("Border", 236, 13, Color3.fromRGB(100, 200, 255))
    local sThick = DHTheme.Slider(box, 258, "Thickness", 0, 4, 0.5, "%.1f", C.bdThick, function(v)
        C.bdThick = v
        DHTheme.Queue()
    end)
    local sBdT = DHTheme.Slider(box, 296, "Border Transparency", 0, 100, 5, "%d%%", C.bdTrans * 100, function(v)
        C.bdTrans = v / 100
        DHTheme.Queue()
    end)
    local rgbBtn = Btn("RGB Border | OFF", 0, 1, 336, 30, Color3.fromRGB(45, 45, 45))
    rgbBtn.Position = UDim2.new(0, 10, 0, 336)
    rgbBtn.Size = UDim2.new(1, -20, 0, 30)
    DHTheme.Skip[rgbBtn] = true
    local function RgbLook()
        rgbBtn.Text = C.rgb and "RGB Border | ON" or "RGB Border | OFF"
        rgbBtn.BackgroundColor3 = C.rgb and Color3.fromRGB(120, 80, 255) or Color3.fromRGB(45, 45, 45)
    end
    rgbBtn.MouseButton1Click:Connect(function()
        C.rgb = not C.rgb
        RgbLook()
        DHTheme.Queue()
    end)
    local sSpd = DHTheme.Slider(box, 372, "RGB Speed", 0.2, 5, 0.2, "%.1f", C.rgbSpd, function(v)
        C.rgbSpd = v
    end)

    Label("Shape", 414, 13, Color3.fromRGB(100, 200, 255))
    local sBg = DHTheme.Slider(box, 436, "Background Transparency", 0, 100, 5, "%d%%", C.bgTrans * 100, function(v)
        C.bgTrans = v / 100
        DHTheme.Queue()
    end)
    local sRound = DHTheme.Slider(box, 474, "Roundness", 0, 200, 10, "%d%%", C.round, function(v)
        C.round = v
        DHTheme.Queue()
    end)
    local sW = DHTheme.Slider(box, 512, "Window Width", 440, 640, 10, "%d", C.w, function(v)
        C.w = v
        DHTheme.Queue()
    end)
    local sH = DHTheme.Slider(box, 550, "Window Height", 300, 440, 10, "%d", C.h, function(v)
        C.h = v
        DHTheme.Queue()
    end)

    local save = Btn("Save Theme", 0, 0.5, 594, 32, Color3.fromRGB(35, 160, 90))
    save.Position = UDim2.new(0, 10, 0, 594)
    save.Size = UDim2.new(0.5, -14, 0, 32)
    local reset = Btn("Reset to Default", 0.5, 0.5, 594, 32, Color3.fromRGB(170, 55, 55))
    reset.Position = UDim2.new(0.5, 4, 0, 594)
    reset.Size = UDim2.new(0.5, -14, 0, 32)
    DHTheme.Status = Label("", 624, 11, Color3.fromRGB(180, 180, 180))
    DHTheme.Status.Font = Enum.Font.Gotham
    DHTheme.Status.Size = UDim2.new(1, -20, 0, 14)

    local function Sync()
        sThick.Set(C.bdThick)
        sBdT.Set(C.bdTrans * 100)
        sSpd.Set(C.rgbSpd)
        sBg.Set(C.bgTrans * 100)
        sRound.Set(C.round)
        sW.Set(C.w)
        sH.Set(C.h)
        RgbLook()
        Refresh()
    end

    save.MouseButton1Click:Connect(DHTheme.Save)
    reset.MouseButton1Click:Connect(function()
        local d = DHTheme.Copy(DHTheme.Def)
        for k, v in pairs(d) do C[k] = v end
        Sync()
        DHTheme.Apply()
        DHTheme.Say("Back to default (tap Save Theme to keep it)")
    end)

    Sync()
    -- a saved theme is applied when the hub starts
    if DHTheme.Load() then
        Sync()
        task.spawn(function()
            task.wait(1)
            pcall(DHTheme.Apply)
        end)
    end
    ScreenGui.Destroying:Connect(function()
        if DHTheme.RgbConn then DHTheme.RgbConn:Disconnect() end
        if DHTheme.AddConn then DHTheme.AddConn:Disconnect() end
    end)
end
