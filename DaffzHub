-- ---------- Fast Respawn (beta): tries to skip the wait after you die ----------
function DHMods.FastRespawnSet(on)
    if DHMods.FrConn then
        DHMods.FrConn:Disconnect()
        DHMods.FrConn = nil
    end
    if DHMods.FrDied then
        DHMods.FrDied:Disconnect()
        DHMods.FrDied = nil
    end
    if not on then return end

    local function Hook(char)
        if DHMods.FrDied then
            DHMods.FrDied:Disconnect()
            DHMods.FrDied = nil
        end
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        if not hum then return end
        DHMods.FrDied = hum.Died:Connect(function()
            if tick() - (DHMods.FrLast or 0) < 2 then return end
            DHMods.FrLast = tick()
            task.defer(function()
                -- the same character swap the "respawn" command of popular admin scripts uses
                pcall(function()
                    char:ClearAllChildren()
                    local tmp = Instance.new("Model")
                    tmp.Parent = workspace
                    Player.Character = tmp
                    task.wait()
                    Player.Character = char
                    tmp:Destroy()
                end)
            end)
        end)
    end

    if Player.Character then Hook(Player.Character) end
    DHMods.FrConn = Player.CharacterAdded:Connect(Hook)
end

