-- ---------- CALCULATOR ----------
DHCalc = {Expr = "", Hist = "", Fresh = false}

-- small safe parser: numbers, + - * / % (remainder), ^, ( ), sqrt( )
function DHCalc.Eval(src)
    local s = src:gsub("%s", "")
    local pos = 1
    local expr, unary
    local function peek() return s:sub(pos, pos) end
    local function primary()
        if peek() == "(" then
            pos = pos + 1
            local v = expr()
            if peek() ~= ")" then error("paren") end
            pos = pos + 1
            return v
        end
        if s:sub(pos, pos + 4) == "sqrt(" then
            pos = pos + 5
            local v = expr()
            if peek() ~= ")" then error("paren") end
            pos = pos + 1
            if v < 0 then error("neg") end
            return math.sqrt(v)
        end
        local num = s:match("^%d+%.?%d*", pos) or s:match("^%.%d+", pos)
        if not num then error("num") end
        pos = pos + #num
        return tonumber(num)
    end
    local function power()
        local base = primary()
        if peek() == "^" then
            pos = pos + 1
            return base ^ unary()
        end
        return base
    end
    unary = function()
        if peek() == "-" then
            pos = pos + 1
            return -unary()
        end
        return power()
    end
    local function term()
        local v = unary()
        while true do
            local c = peek()
            if c == "*" then
                pos = pos + 1
                v = v * unary()
            elseif c == "/" or c == "%" then
                pos = pos + 1
                local d = unary()
                if d == 0 then error("div0") end
                if c == "/" then v = v / d else v = v % d end
            else
                break
            end
        end
        return v
    end
    expr = function()
        local v = term()
        while true do
            local c = peek()
            if c == "+" then
                pos = pos + 1
                v = v + term()
            elseif c == "-" then
                pos = pos + 1
                v = v - term()
            else
                break
            end
        end
        return v
    end
    local ok, v = pcall(function()
        local r = expr()
        if pos <= #s then error("junk") end
        return r
    end)
    if ok and type(v) == "number" and v == v and math.abs(v) ~= math.huge then return v end
    return nil
end

function DHCalc.Fmt(v)
    if v == math.floor(v) and math.abs(v) < 1e15 then return string.format("%.0f", v) end
    return string.format("%.10g", v)
end

function DHCalc.Shown(e)
    local t = e:gsub("%*", "×")
    t = t:gsub("/", "÷")
    return t
end

function DHCalc.Refresh()
    if DHCalc.Main then DHCalc.Main.Text = (DHCalc.Expr == "") and "0" or DHCalc.Shown(DHCalc.Expr) end
    if DHCalc.Top then DHCalc.Top.Text = DHCalc.Hist end
end

function DHCalc.Press(k)
    local e = DHCalc.Expr
    if k == "C" then
        DHCalc.Expr = ""
        DHCalc.Hist = ""
        DHCalc.Fresh = false
    elseif k == "DEL" then
        if e:sub(-5) == "sqrt(" then DHCalc.Expr = e:sub(1, -6) else DHCalc.Expr = e:sub(1, -2) end
        DHCalc.Fresh = false
    elseif k == "=" then
        if e == "" then return end
        local v = DHCalc.Eval(e)
        if v then
            DHCalc.Hist = DHCalc.Shown(e) .. " ="
            DHCalc.Expr = DHCalc.Fmt(v)
            DHCalc.Fresh = true
        else
            DHCalc.Hist = "Error"
            DHCalc.Expr = ""
            DHCalc.Fresh = false
        end
    elseif k == "Copy" then
        if setclipboard and e ~= "" then pcall(setclipboard, e) end
        return
    else
        -- after "=", a number starts a new calculation, an operator continues with the result
        if DHCalc.Fresh and (k:match("^[%d%.%(]") or k == "sqrt(") then e = "" end
        DHCalc.Fresh = false
        if #e < 60 then DHCalc.Expr = e .. k end
    end
    DHCalc.Refresh()
end

