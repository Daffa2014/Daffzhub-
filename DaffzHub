BlackCfg = {Disable3D = true, WarmUp = 4} -- Disable3D: turn off 3D rendering while it is on (saves battery and heat). WarmUp: seconds the black cover stays after switching off, so the world reloads behind it

function BuildBlackScreen()
    local Section = CreatePlayerSection("🌑 Black Screen", 60)

    local Btn = Instance.new("TextButton", Section)
    Btn.Size = UDim2.new(1, -20, 0, 30)
