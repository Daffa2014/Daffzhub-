-- ================================================
-- EXPLOITER WATCH (Info tab): flags suspicious players from what this client can see
-- Speed / Fly / Teleport / Noclip. Only a hint: a vehicle, a teleporter or lag can look like a cheat.
-- Turned on from the Setting tab ("Exploiter Detector").
-- ================================================
DHExp = {On = false, S = {}, Flagged = {}, Tok = 0}
DHExp.Cfg = {
    Interval = 0.25,     -- seconds between checks
    Hold = 30,           -- seconds a suspect stays marked after the last confirmed hit
    Range = 450,         -- players farther than this (studs) from the camera are not judged
    Grace = 4,           -- seconds after a spawn before a player is judged
    SpeedMul = 1.35,     -- allowed speed = WalkSpeed * SpeedMul + SpeedAdd
    SpeedAdd = 4,
    SpeedChecks = 4,     -- this many checks in a row (about 1 second) must be over the limit
    TeleportDist = 80,   -- studs moved between two checks
    TeleportCount = 2,   -- teleports inside TeleportWindow seconds to confirm (landing next to you counts double)
    TeleportWindow = 20,
    HoverTime = 2.5,     -- seconds in the air with almost no vertical movement
    RiseTime = 1.5,      -- seconds in the air while still rising
    NoclipCount = 3,     -- wall crossings inside NoclipWindow seconds
    NoclipWindow = 8,
    MaxRows = 8,
    AdaptMin = 2,        -- this many players tripping the same check at once means it is a map feature
    AdaptShare = 0.34,   -- ... and at least this share of the players being watched
    AdaptWindow = 10,    -- seconds
    SpeedCap = 2.4,      -- the speed limit never goes above WalkSpeed * this
    FlyCap = 4,          -- the fly times never grow more than this many times
    FlingVel = 300,      -- reported velocity (studs/s) that is far beyond anything normal
    FlingSpin = 60,      -- rad/s of spin that no normal character reaches
    FlingCount = 3,      -- reports inside FlingWindow seconds to confirm
    FlingWindow = 3,
    LaunchVy = 70,       -- vertical studs/s that means "thrown", not walking or jumping
    LaunchSkip = 4,      -- seconds a thrown player is not judged
}
DHExp.Label = {fling = "Fling", speed = "Speed", fly = "Fly", tp = "Teleport", noclip = "Noclip"}
-- limits that grow on their own when a map allows more (sprint, jetpacks, high jumps)
DHExp.Base = {ratio = DHExp.Cfg.SpeedMul, fly = 1}

function DHExp.Name(plr)
    if plr.DisplayName ~= "" and plr.DisplayName ~= plr.Name then
        return plr.DisplayName .. " (@" .. plr.Name .. ")"
    end
    return plr.Name
end

function DHExp.Toast(text)
    if DHAlertToast then pcall(DHAlertToast, text, Color3.fromRGB(255, 160, 40), 20) end
end

function DHExp.InWater(pos)
    local ok, m = pcall(function()
        local r = Region3.new(pos - Vector3.new(2, 2, 2), pos + Vector3.new(2, 2, 2)):ExpandToGrid(4)
        return workspace.Terrain:ReadVoxels(r, 4)[1][1][1]
    end)
    return ok and m == Enum.Material.Water
end

-- text for the list: what was confirmed, with the numbers behind it
function DHExp.Reasons(S, now)
    local list = {}
    for _, k in ipairs({"fling", "tp", "speed", "fly", "noclip"}) do
        if S.hits[k] and now - S.hits[k] <= DHExp.Cfg.Hold and S.info[k] then list[#list + 1] = S.info[k] end
    end
    return #list > 0 and table.concat(list, ", ") or "suspicious"
end

-- one player, one check: returns the table of things CONFIRMED this round (or nil)
function DHExp.Check(plr, S, now, rp, camPos, myPos)
    local C = DHExp.Cfg
    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (root and hum) or hum.Health <= 0 then
        S.char = nil
        return nil
    end
    local pos = root.Position
    if S.char ~= char then
        -- new character (spawn / respawn): wait before judging
        S.char, S.last, S.lastT = char, pos, now
        S.grace = now + C.Grace
        S.airT, S.spd, S.floor, S.tp, S.nc = 0, {}, nil, {}, {}
        return nil
    end
    local dt = now - S.lastT
    local last = S.last
    S.last, S.lastT = pos, now

    local function Reset()
        S.airT, S.spd, S.floor = 0, {}, nil
    end

    if now < S.grace or dt < 0.15 or dt > 0.6 then Reset() return nil end
    -- too far away: another player's movement is not reliable at that distance
    if camPos and (pos - camPos).Magnitude > C.Range then Reset() return nil end

    -- vehicles, ragdolls and similar: not judged
    local state = nil
    pcall(function() state = hum:GetState() end)
    if hum.SeatPart or hum.Sit or hum.PlatformStand
        or state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.PlatformStanding
        or state == Enum.HumanoidStateType.Physics then
        Reset()
        S.skip = now + 1.5
        return nil
    end
    if S.skip and now < S.skip then Reset() return nil end

    local hit = {}
    S.obs = (S.obs or 0) + 1
    local move = pos - last
    
    -- FLING: the owner reports a huge velocity but the player hardly moves, or the body spins wildly
    S.fl = S.fl or {}
    local reported = root.AssemblyLinearVelocity.Magnitude
    local spin = root.AssemblyAngularVelocity.Magnitude
    if (reported > C.FlingVel and move.Magnitude / dt < reported * 0.35) or spin > C.FlingSpin then
        S.fl[#S.fl + 1] = now
        local fresh = {}
        for _, t in ipairs(S.fl) do
            if now - t <= C.FlingWindow then fresh[#fresh + 1] = t end
        end
        S.fl = fresh
        if #fresh >= C.FlingCount then
            hit.fling = "Fling " .. math.floor(math.max(reported, spin))
            S.fl = {}
        end
    end

    -- thrown into the air (knockback, explosion, somebody else's fling): not their doing, skip a few seconds
    if math.abs(move.Y / dt) > C.LaunchVy then
        S.skip = now + C.LaunchSkip
        Reset()
        return next(hit) and hit or nil
    end

    -- what the player stands on; movement is measured against it, so platforms, boats and conveyors do not count
    local ground = workspace:Raycast(pos, Vector3.new(0, -12, 0), rp)
    local floor = ground and ground.Instance
    local rel = move
    if floor and S.floor == floor and S.floorCF then
        rel = floor.CFrame:PointToObjectSpace(pos) - S.floorCF:PointToObjectSpace(last)
    end
    S.floor = floor
    S.floorCF = floor and floor.CFrame or nil

    -- TELEPORT: a big jump between two checks; two of them (or one landing next to you) confirm
    if rel.Magnitude > C.TeleportDist then
        S.spd = {}
        local w = 1
        if myPos and (pos - myPos).Magnitude < 25 then w = 2 end
        S.tp[#S.tp + 1] = {t = now, w = w}
        local total = 0
        local fresh = {}
        for _, e in ipairs(S.tp) do
            if now - e.t <= C.TeleportWindow then
                fresh[#fresh + 1] = e
                total = total + e.w
            end
        end
        S.tp = fresh
        if total >= C.TeleportCount then
            hit.tp = string.format("TP %d", math.floor(rel.Magnitude))
            S.tp = {}
        end
    else
        -- SPEED: every one of the last checks must be over the limit (about 1 second in a row)
        local ws = math.max(hum.WalkSpeed, 16)
        if ws >= (S.wsPeak or 0) or now > (S.wsUntil or 0) then
            S.wsPeak, S.wsUntil = ws, now + 3
        end
        local limit = S.wsPeak * DHExp.Base.ratio + C.SpeedAdd
        local flat = Vector3.new(rel.X, 0, rel.Z).Magnitude / dt
        local spd = S.spd
        spd[#spd + 1] = flat
        if #spd > C.SpeedChecks then table.remove(spd, 1) end
        if #spd >= C.SpeedChecks then
            local over, sum = true, 0
            for _, v in ipairs(spd) do
                sum = sum + v
                if v <= limit then over = false end
            end
            if over then hit.speed = string.format("Speed %d/%d", math.floor(sum / #spd), math.floor(S.wsPeak)) end
        end
    end

    -- FLY: hovering without a floor, or still rising long after any jump would have ended
    if ground or state == Enum.HumanoidStateType.Climbing then
        S.airT = 0
    else
        if S.airT == 0 then
            S.airY, S.airMin, S.airMax = pos.Y, pos.Y, pos.Y
        end
        S.airT = S.airT + dt
        S.airMin = math.min(S.airMin, pos.Y)
        S.airMax = math.max(S.airMax, pos.Y)
        local vy = move.Y / dt
        local avg = (pos.Y - S.airY) / S.airT
        -- what a normal jump looks like on this map (JumpPower / JumpHeight and Gravity differ between maps)
        local g = math.max(workspace.Gravity, 1)
        local jv = 50
        pcall(function()
            if hum.UseJumpPower then jv = hum.JumpPower else jv = math.sqrt(2 * g * hum.JumpHeight) end
        end)
        local jumpAir = 2 * jv / g
        local hoverT = math.max(C.HoverTime, jumpAir + 1.5) * DHExp.Base.fly
        local riseT = math.max(C.RiseTime, jumpAir / 2 + 0.8) * DHExp.Base.fly
        if not DHExp.InWater(pos) then
            if S.airT > hoverT and (S.airMax - S.airMin) < 6 then
                hit.fly = string.format("Fly %ds", math.floor(S.airT))
            elseif S.airT > riseT and avg > 8 and vy > 6 then
                hit.fly = string.format("Fly up %ds", math.floor(S.airT))
            end
        end
    end

    -- NOCLIP: the same solid wall is hit from both sides of the path between two checks
    local mag = move.Magnitude
    if not hit.tp and rel.Magnitude <= C.TeleportDist and mag > 1.5 then
        local fwd = workspace:Raycast(last, move, rp)
        local inst = fwd and fwd.Instance
        if inst and not inst:IsA("Terrain") and inst.CanCollide and inst.Anchored and math.abs(fwd.Normal.Y) < 0.5 then
            local back = workspace:Raycast(pos, -move, rp)
            if back and back.Instance == inst then
                S.nc[#S.nc + 1] = now
                local fresh = {}
                for _, t in ipairs(S.nc) do
                    if now - t <= C.NoclipWindow then fresh[#fresh + 1] = t end
                end
                S.nc = fresh
                if #fresh >= C.NoclipCount then
                    hit.noclip = "Noclip x" .. #fresh
                    S.nc = {}
                end
            end
        end
    end

    -- a fling explains the rest (it throws the player around): report only that
    if hit.fling then hit = {fling = hit.fling} end
    return next(hit) and hit or nil
end

-- different maps allow different things (sprint, jetpacks, boosted jumps): when several players trip the same
-- check at the same time it is a map feature, not cheating, so the limit is raised and those hits are dropped
function DHExp.Adapt(results, now)
    local C, B = DHExp.Cfg, DHExp.Base
    local total = 0
    for _, S in pairs(DHExp.S) do
        if S.obs and S.obs >= 8 then total = total + 1 end
    end
    if total < 3 then return end
    for _, kind in ipairs({"speed", "fly"}) do
        local who = {}
        for plr, S in pairs(DHExp.S) do
            local cur = results[plr] and results[plr][kind]
            if cur or (S.hits[kind] and now - S.hits[kind] <= C.AdaptWindow) then who[#who + 1] = plr end
        end
        if #who >= C.AdaptMin and #who / total >= C.AdaptShare then
            if kind == "speed" then
                B.ratio = math.min(B.ratio * 1.2, C.SpeedCap)
            else
                B.fly = math.min(B.fly * 1.5, C.FlyCap)
            end
            for _, plr in ipairs(who) do
                if results[plr] then results[plr][kind] = nil end
                local S = DHExp.S[plr]
                S.hits[kind], S.info[kind], S.first[kind] = nil, nil, nil
                S.spd, S.airT = {}, 0
            end
        end
    end
end

function DHExp.Tick()
    local C = DHExp.Cfg
    local now = tick()
    local chars = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then chars[#chars + 1] = p.Character end
    end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = chars
    rp.IgnoreWater = true
    rp.RespectCanCollide = true

    local cam = workspace.CurrentCamera
    local camPos = cam and cam.CFrame.Position
    local myRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position

    -- 1) check everybody
    local results = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            local S = DHExp.S[plr]
            if not S then
                S = {score = 0, airT = 0, hits = {}, info = {}, first = {}, notified = {}, spd = {}, tp = {}, nc = {},
                     flagged = false, hold = 0, grace = 0}
                DHExp.S[plr] = S
            end
            local ok, hit = pcall(DHExp.Check, plr, S, now, rp, camPos, myPos)
            if ok and hit then results[plr] = hit end
        end
    end

    -- 2) learn what this map allows
    pcall(DHExp.Adapt, results, now)

    -- 3) mark and announce
    for plr, hit in pairs(results) do
        local S = DHExp.S[plr]
        if S then
            for k, text in pairs(hit) do
                if now - (S.hits[k] or -1000) > 3 then S.first[k] = now end
                S.hits[k] = now
                S.info[k] = text
                S.score = S.score + 1
                S.hold = now + C.Hold
                S.flagged = true
                DHExp.Flagged[plr] = true
                -- speed and fly must keep going for 3 seconds before the notice (a map feature may still be learned)
                local wait = (k == "speed" or k == "fly") and 3 or 0
                if now - (S.first[k] or now) >= wait and now - (S.notified[k] or -1000) > 60 then
                    S.notified[k] = now
                    DHExp.Toast("! " .. DHExp.Name(plr) .. ": " .. text)
                end
            end
        end
    end

    -- 4) forget suspects with nothing left to show
    for plr, S in pairs(DHExp.S) do
        if S.flagged then
            local live = false
            for _, t in pairs(S.hits) do
                if now - t <= C.Hold then live = true end
            end
            if not live then
                S.flagged = false
                DHExp.Flagged[plr] = nil
            end
        end
    end
end

