-- when the hub is deleted, WalkSpeed and JumpPower go back to normal and stay normal after respawn
ScreenGui.Destroying:Connect(function()
    local wasWalk, wasJump = WalkEnabled, JumpEnabled
    WalkEnabled = false
    JumpEnabled = false
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        if wasWalk then pcall(function() hum.WalkSpeed = OriginalWalkSpeed end) end
        if wasJump then
            pcall(function()
                hum.JumpPower = OriginalJumpPower
                hum.JumpHeight = OriginalJumpPower * 0.144
            end)
        end
    end
end)

