    if name ~= "" and ScriptBox.Text ~= "" then
        local file = SCRIPTS_FOLDER .. "/" .. name .. ".txt"
        local function doSave()
            local ok = pcall(function() writefile(file, ScriptBox.Text) end)
            ScriptNameBox.Text = ""
            refreshScriptList(ScriptSearch.Text)

            SaveScriptBtn.Text = ok and "Saved!" or "Failed"
            SaveScriptBtn.BackgroundColor3 = ok and Color3.fromRGB(0,120,0) or Color3.fromRGB(120,0,0)
            task.wait(1)
            SaveScriptBtn.Text = "Save"
            SaveScriptBtn.BackgroundColor3 = Color3.fromRGB(30,180,30)
        end
        local exists = false
        pcall(function() exists = isfile(file) end)
        if exists then
            ShowConfirmPopup("Replace the saved script \"" .. name .. "\"?", Color3.fromRGB(200, 180, 30), doSave)
        else
            doSave()
        end
    end
end)

