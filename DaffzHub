-- onSelect(item, on) is called with on = true when picked, on = false when picked again (deselect)
-- returns {Select = fn(key, silent), Clear = fn()}
function DHVisual.AddSearchList(box, items, onSelect)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 0)
    holder.AutomaticSize = Enum.AutomaticSize.Y
    holder.BackgroundTransparency = 1
    holder.LayoutOrder = DHVisual.Next(box)
    holder.Parent = box

    local hl = Instance.new("UIListLayout", holder)
    hl.Padding = UDim.new(0, 6)
    hl.SortOrder = Enum.SortOrder.LayoutOrder

    local search = Instance.new("TextBox")
    search.Size = UDim2.new(1, 0, 0, 30)
    search.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    search.BorderSizePixel = 0
    search.PlaceholderText = "Search..."
    search.Text = ""
    search.ClearTextOnFocus = false
    search.Font = Enum.Font.Gotham
    search.TextSize = 13
    search.TextColor3 = Color3.fromRGB(255, 255, 255)
    search.PlaceholderColor3 = Color3.fromRGB(130, 130, 130)
    search.LayoutOrder = 0
    search.Parent = holder
    Instance.new("UICorner", search).CornerRadius = UDim.new(0, 6)

    local rows = {}
    local api = {}
    local current = nil

    local function Mark(key)
        for k, r in pairs(rows) do
            local sel = (k == key)
            r.check.Visible = sel
            r.stroke.Enabled = sel
        end
    end

    function api.Clear()
        current = nil
        Mark(nil)
    end

    function api.Select(key, silent)
        local r = rows[key]
        if not r then return end
        if current == key then
            current = nil
            Mark(nil)
            if not silent then onSelect(r.item, false) end
            return
        end
        -- only one list can be active at a time
        for _, other in ipairs(DHVisual.Lists) do
            if other ~= api then other.Clear() end
        end
        current = key
        Mark(key)
        if not silent then onSelect(r.item, true) end
    end

    for i, it in ipairs(items) do
        local btn = Instance.new("TextButton")
        btn.Name = "Item_" .. tostring(it.key)
        btn.Size = UDim2.new(1, 0, 0, 62)
