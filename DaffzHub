function DHPv.Show(model)
    local vp = DHPv.View
    if not vp then return end
    if DHPv.Model then pcall(function() DHPv.Model:Destroy() end) DHPv.Model = nil end
    if DHPv.World then pcall(function() DHPv.World:Destroy() end) DHPv.World = nil end
    -- the world model keeps the joints working, so the body stays in one piece
    local world = Instance.new("WorldModel")
    world.Parent = vp
    DHPv.World = world
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BaseScript") or d:IsA("Sound") then pcall(function() d:Destroy() end) end
    end
    -- layered clothing makes Roblox print "WrapDeformer" errors inside a viewport, so it is left out
    for _, c in ipairs(model:GetChildren()) do
        if c:IsA("Accessory") and c:FindFirstChildWhichIsA("WrapLayer", true) then pcall(function() c:Destroy() end) end
    end
    pcall(function()
        local h = model:FindFirstChildOfClass("Humanoid")
        if h then h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
    end)
    model.Parent = world
    local root = model:FindFirstChild("HumanoidRootPart")
    if root then
        root.Anchored = true
        root.CFrame = CFrame.new(0, 0, 0)
    else
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then d.Anchored = true end
        end
    end
    DHPv.Model = model
    if DHPv.Camera then DHPv.Camera.FieldOfView = 40 end
    DHPv.Fit()
end

