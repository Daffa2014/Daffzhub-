function DHJump.PresetsLoad()
    DHJump.Presets = {}
    pcall(function()
        if not (isfile and readfile and isfile(DHJump.PresetPath)) then return end
        local data = game:GetService("HttpService"):JSONDecode(readfile(DHJump.PresetPath))
        for _, p in ipairs(data) do
            if type(p) == "table" and type(p.name) == "string" then
                DHJump.Presets[#DHJump.Presets + 1] = {
                    name = p.name,
                    size = tonumber(p.size) or 75,
                    x = tonumber(p.x) or 28,
                    y = tonumber(p.y) or 22,
                }
            end
        end
    end)
end

function DHJump.PresetsSave()
    pcall(function()
        if not (writefile and makefolder and isfolder) then return end
        if not isfolder("Daffzhub_file") then makefolder("Daffzhub_file") end
        if not isfolder("Daffzhub_file/Setting") then makefolder("Daffzhub_file/Setting") end
        writefile(DHJump.PresetPath, game:GetService("HttpService"):JSONEncode(DHJump.Presets))
    end)
end

