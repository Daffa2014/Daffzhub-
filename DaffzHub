    DescText = Instance.new("TextLabel", DescFrame)
    DescText.Size = UDim2.new(1, -8, 1, -8)
    DescText.Position = UDim2.new(0, 4, 0, 4)
    DescText.BackgroundTransparency = 1
        DescText.Text = DHRep.Compose(report.text, false)
    DHRep.Cards[#DHRep.Cards + 1] = {DescText, report.text}
    DescText.TextColor3 = Color3.fromRGB(200,200,200)
    DescText.TextSize = 12
    DescText.Font = Enum.Font.Gotham
    DescText.TextWrapped = true
    DescText.TextXAlignment = Enum.TextXAlignment.Left
    DescText.TextYAlignment = Enum.TextYAlignment.Top
    
    CopyButton = Instance.new("TextButton", Card)
    CopyButton.Size = UDim2.new(0, 100, 0, 28)
    CopyButton.Position = UDim2.new(1, -110, 1, -33)
    CopyButton.BackgroundColor3 = Color3.fromRGB(255,200,0)
    CopyButton.Text = "📋"
    CopyButton.TextColor3 = Color3.new(1,1,1)
    CopyButton.Font = Enum.Font.GothamBold
    CopyButton.TextSize = 12
    Instance.new("UICorner", CopyButton).CornerRadius = UDim.new(0,6)
    
    table.insert(AllReportFrames, {
        card = Card,
        category = sectionData.category:lower(),
        name = report.name:lower(),
        text = report.text:lower(),
        sectionIndex = sectionIndex,
        reportIndex = cardIndex
    })
    
    CopyButton.MouseButton1Click:Connect(function()
        success = pcall(function()
            if setclipboard then
                setclipboard(DHRep.Compose(report.text, true))
            else
                DescText.Text = "Text ready to copy! (Ctrl+A then Ctrl+C)"
                task.wait(1.5)
                DescText.Text = DHRep.Compose(report.text, false)
            end
        end)
        
        if success then
            CopyButton.Text = "✓"
            CopyButton.BackgroundColor3 = Color3.fromRGB(60,180,80)
            
            TweenService:Create(CardStroke, TweenInfo.new(0.2), {
                Transparency = 0,
                Color = Color3.fromRGB(60,180,80)
            }):Play()
            
            task.wait(1.5)
            
            CopyButton.Text = "📋"
            CopyButton.BackgroundColor3 = Color3.fromRGB(40,120,200)
            
            TweenService:Create(CardStroke, TweenInfo.new(0.2), {
                Transparency = 0.3,
                Color = report.severityColor
            }):Play()
        else
            CopyButton.Text = "⚠ ERROR"
            CopyButton.BackgroundColor3 = Color3.fromRGB(200,60,60)
            task.wait(1)
            CopyButton.Text = "📋"
            CopyButton.BackgroundColor3 = Color3.fromRGB(40,120,200)
        end
    end)
    
    CopyButton.MouseEnter:Connect(function()
        if CopyButton.Text == "📋" then
            TweenService:Create(CopyButton, TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(50,140,220),
                Size = UDim2.new(0, 104, 0, 30)
            }):Play()
        end
    end)
    
    CopyButton.MouseLeave:Connect(function()
        if CopyButton.Text == "📋" then
            TweenService:Create(CopyButton, TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(40,120,200),
                Size = UDim2.new(0, 100, 0, 28)
            }):Play()
        end
    end)
    
    return Card
end

