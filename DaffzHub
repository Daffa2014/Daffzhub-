    alertHolder.Active = false
    pcall(function() alertHolder.Interactable = false end) -- touches go straight through to the game

    -- ordinary notices: one at a time in the same spot, the next one waits its turn
    local alertQueue = {}
    local alertBusy = false

    local function AlertNext()
        if alertBusy then return end
        local item = table.remove(alertQueue, 1)
        if not item then return end
        alertBusy = true

        -- split the old "+ name joined" style text into icon, title and a small second line
        local raw = tostring(item.text)
        local icon = string.sub(raw, 1, 1)
        local title, sub = raw, ""
        if string.sub(raw, 2, 2) == " " and (icon == "+" or icon == "-" or icon == "!") then
            title = string.sub(raw, 3)
            if icon == "+" and string.sub(title, -7) == " joined" then
                title = string.sub(title, 1, -8); sub = "Joined the server"
            elseif icon == "-" and string.sub(title, -5) == " left" then
                title = string.sub(title, 1, -6); sub = "Left the server"
            elseif icon == "!" then
                local a, b = string.find(title, ": ", 1, true)
                if a then sub = string.sub(title, b + 1); title = string.sub(title, 1, a - 1) end
            end
        else
            icon = "i"
        end
        if icon == "-" then icon = "×" end

        local Tween = game:GetService("TweenService")
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 1, 0)
        card.Position = UDim2.new(1.2, 0, 0, 0)
        card.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
        card.BackgroundTransparency = 0.08
        card.BorderSizePixel = 0
        card.ClipsDescendants = true
        card.Active = false
        pcall(function() card.Interactable = false end)
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
        local st = Instance.new("UIStroke", card)
        st.Color = item.color
        st.Thickness = 1.2
        st.Transparency = 0.35

        local badge = Instance.new("TextLabel", card)
        badge.Size = UDim2.new(0, 28, 0, 28)
        badge.Position = UDim2.new(0, 8, 0.5, -14)
        badge.BackgroundColor3 = item.color
        badge.BackgroundTransparency = 0.75
        badge.Font = Enum.Font.GothamBold
        badge.TextSize = 16
        badge.TextColor3 = item.color
        badge.Text = icon
        Instance.new("UICorner", badge).CornerRadius = UDim.new(1, 0)

        local nameLb = Instance.new("TextLabel", card)
        nameLb.BackgroundTransparency = 1
        nameLb.Position = UDim2.new(0, 44, 0, sub ~= "" and 6 or 0)
        nameLb.Size = UDim2.new(1, -52, 0, sub ~= "" and 18 or 44)
        nameLb.Font = Enum.Font.GothamBold
        nameLb.TextSize = 12
        nameLb.TextColor3 = Color3.new(1, 1, 1)
        nameLb.TextXAlignment = Enum.TextXAlignment.Left
        nameLb.TextTruncate = Enum.TextTruncate.AtEnd
        nameLb.Text = title

        if sub ~= "" then
            local subLb = Instance.new("TextLabel", card)
            subLb.BackgroundTransparency = 1
            subLb.Position = UDim2.new(0, 44, 0, 23)
            subLb.Size = UDim2.new(1, -52, 0, 14)
            subLb.Font = Enum.Font.Gotham
            subLb.TextSize = 10
            subLb.TextColor3 = Color3.fromRGB(170, 170, 180)
            subLb.TextXAlignment = Enum.TextXAlignment.Left
            subLb.TextTruncate = Enum.TextTruncate.AtEnd
            subLb.Text = sub
        end

        -- thin bar at the bottom that drains while the notice is visible
        local bar = Instance.new("Frame", card)
        bar.Size = UDim2.new(1, 0, 0, 2)
        bar.Position = UDim2.new(0, 0, 1, -2)
        bar.BackgroundColor3 = item.color
        bar.BackgroundTransparency = 0.2
        bar.BorderSizePixel = 0

        card.Parent = alertHolder
        Tween:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
        Tween:Create(bar, TweenInfo.new(item.life, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)}):Play()

        task.delay(item.life, function()
            Tween:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1.2, 0, 0, 0)}):Play()
            task.wait(0.25)
            card:Destroy()
            alertBusy = false
            AlertNext()
        end)
    end

    -- life above 5 means an important notice (exploiter): it goes to the front and stays 5 seconds
    local function AlertToast(text, color, life)
        local important = life ~= nil and life > 5
        local item = {text = text, color = color, life = important and 5 or (life or 2.5)}
        if important then
            table.insert(alertQueue, 1, item)
        else
            alertQueue[#alertQueue + 1] = item
        end
        while #alertQueue > 8 do table.remove(alertQueue, #alertQueue) end
        AlertNext()
    end

