function DHCam.SetFov(on)
    local RS = game:GetService("RunService")
    pcall(function() RS:UnbindFromRenderStep("DH_FOV") end)
    if on then
        local c = workspace.CurrentCamera
        if DHCam.orig == nil and c then
            DHCam.orig = c.FieldOfView
        end
        -- runs right after the game's own camera update, so the game cannot overwrite it
        RS:BindToRenderStep("DH_FOV", Enum.RenderPriority.Camera.Value + 1, function()
            local cam = workspace.CurrentCamera
            if cam and cam.FieldOfView ~= DHCam.Fov then
