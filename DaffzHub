-- MAP SCRIPTS: search for scripts of the current map, using the map's original name
-- ================================================
local SBMapNameCache = nil

-- removes tags like [UPDATE] or (Beta) and emoji, so the search matches the real title
local function SBCleanMapName(n)
    n = tostring(n or "")
    n = n:gsub("%b[]", " ")
    n = n:gsub("%b()", " ")
    n = n:gsub("[\240-\244][\128-\191]*", "")
    n = n:gsub("%s+", " ")
    n = n:match("^%s*(.-)%s*$") or n
    return n
end

-- Roblox returns the experience name translated to the language of the request,
-- so ask for the creator's source language first, then read the name in that language
local function SBHttp(url, lang)
    if request then
        local r = request({Url = url, Method = "GET", Headers = lang and {["Accept-Language"] = lang} or nil})
        return r and r.Body
    end
    return game:HttpGet(url)
end

local function SBGetMapName()
    if SBMapNameCache then return SBMapNameCache end
    local name, lang
    pcall(function()
        local body = SBHttp("https://gamelocalization.roblox.com/v1/source-language/games/" .. tostring(game.GameId))
        local d = HttpService:JSONDecode(body)
        lang = d and d.languageCode
    end)
    pcall(function()
        local body = SBHttp("https://games.roblox.com/v1/games?universeIds=" .. tostring(game.GameId), lang)
        local d = HttpService:JSONDecode(body)
        name = d and d.data and d.data[1] and d.data[1].name
    end)
    if not name or name == "" then
        pcall(function()
            name = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
        end)
    end
    if not name or name == "" then name = DHMapName end
    if not name or name == "" or name == "Unknown" then return nil end
    local cleaned = SBCleanMapName(name)
    if cleaned == "" then cleaned = name end
    SBMapNameCache = cleaned
    return cleaned
end

