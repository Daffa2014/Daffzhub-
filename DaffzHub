function DHStatTable.GraphPush(key, v)
    local g = DHStatTable.Graphs[key]
    if not g then return end
    local N = DHStatTable.GraphN
    local data = g.data
    data[#data + 1] = v
    if #data > N then table.remove(data, 1) end

    local d = DHStatTable.Defs[key]
    g.val.Text = DHStatTable.Fmt(key, v)
    if d.color then g.val.TextColor3 = d.color(v) end

    local w, h = g.area.AbsoluteSize.X, g.area.AbsoluteSize.Y
    if w < 10 or h < 10 then return end

    local lo, hi = math.huge, -math.huge
    for _, x in ipairs(data) do
        if x < lo then lo = x end
        if x > hi then hi = x end
    end
    local span = math.max(hi - lo, DHStatTable.GraphSpan[key] or 1)
    local center = (hi + lo) / 2
    lo = center - span / 2

    -- newest sample at the right edge, older ones to the left
    local pts = {}
    local off = N - #data
    for i, x in ipairs(data) do
        pts[i] = Vector2.new((i - 1 + off) / (N - 1) * w, h - 3 - (x - lo) / span * (h - 6))
    end
    for i, s in ipairs(g.segs) do
        local a, b = pts[i], pts[i + 1]
        if a and b then
            local dx, dy = b.X - a.X, b.Y - a.Y
            s.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 1, 2)
            s.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
            s.Rotation = math.deg(math.atan2(dy, dx))
            s.Visible = true
        else
            s.Visible = false
        end
    end
    local last = pts[#pts]
    if last then
        g.head.Position = UDim2.fromOffset(last.X, last.Y)
        g.head.Visible = true
    end
end

