-- ---------- Freeze: locks your character in place ----------
function DHMods.FreezeSet(on)
    local saved = DHMods.FreezeSaved
    DHMods.FreezeSaved = nil
    if DHMods.FreezeConn then
        DHMods.FreezeConn:Disconnect()
        DHMods.FreezeConn = nil
    end
    if saved then
        local hum, root = saved.hum, saved.root
        if root and root.Parent then root.Anchored = saved.anchored end
        if hum and hum.Parent then
            hum.WalkSpeed = saved.ws
            if saved.useJP then hum.JumpPower = saved.jp else hum.JumpHeight = saved.jh end
        end
    end
    if not on then return end

    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = hum and hum.RootPart
    if not (hum and root) then return end
    DHMods.FreezeSaved = {
        hum = hum, root = root, anchored = root.Anchored,
        ws = hum.WalkSpeed, jp = hum.JumpPower, jh = hum.JumpHeight, useJP = hum.UseJumpPower,
    }
    hum.WalkSpeed = 0
    if hum.UseJumpPower then hum.JumpPower = 0 else hum.JumpHeight = 0 end
    root.Anchored = true

    -- turns itself off if you die or respawn
    DHMods.FreezeConn = RunService.Heartbeat:Connect(function()
        if not hum.Parent or hum.Health <= 0 or Player.Character ~= char then
            if DHMods.FreezeApi then DHMods.FreezeApi.Set(false) end
        end
    end)
end

-- ---------- Time Stop (v2): nothing is anchored or changed. Moving objects, other players and NPCs
-- are held in place on your screen for 10 seconds, then released. ----------
DHMods.TsHold = {}    -- assembly root part -> the CFrame it is held at
DHMods.TsSnap = {}    -- assembly root part -> where it was when Time Stop started
DHMods.TsAnims = {}   -- animation track -> its original speed

function DHMods.TsScan()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local myHum = char and char:FindFirstChildOfClass("Humanoid")
    if not root then return end

    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {char}
    local seat = myHum and myHum.SeatPart
    local seatRoot = seat and seat.AssemblyRootPart

    local parts = workspace:GetPartBoundsInRadius(root.Position, 200, op)
    local seen = {}
    for i, p in ipairs(parts) do
        if i > 1200 then break end
        local m = p:FindFirstAncestorOfClass("Model")
        local h = m and m:FindFirstChildOfClass("Humanoid")
        if h then
            -- another player or an NPC: hold the body and pause its animations
            if not seen[m] then
                seen[m] = true
                local hr = h.RootPart
                if hr and not DHMods.TsHold[hr] then DHMods.TsHold[hr] = hr.CFrame end
                local an = h:FindFirstChildOfClass("Animator")
                if an then
                    for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                        if DHMods.TsAnims[tr] == nil then
                            DHMods.TsAnims[tr] = tr.Speed
                            tr:AdjustSpeed(0)
                        end
                    end
                end
            end
        else
            -- a normal object: hold it only if it moves
            local r = p.AssemblyRootPart or p
            if r ~= seatRoot and not DHMods.TsHold[r] then
                local s = DHMods.TsSnap[r]
                if s == nil then
                    DHMods.TsSnap[r] = r.CFrame
                elseif (r.Position - s.Position).Magnitude > 0.05 then
                    DHMods.TsHold[r] = r.CFrame
                end
            end
        end
    end
end

function DHMods.TimeStopSet(on)
    DHMods.TsTok = (DHMods.TsTok or 0) + 1
    local tok = DHMods.TsTok
    if DHMods.TsConn then
        DHMods.TsConn:Disconnect()
        DHMods.TsConn = nil
    end
    -- release: only animation speeds need to be put back
    for tr, sp in pairs(DHMods.TsAnims) do
        pcall(function() tr:AdjustSpeed(sp) end)
    end
    DHMods.TsAnims = {}
    DHMods.TsHold = {}
    DHMods.TsSnap = {}
    if DHMods.TsCC then
        DHMods.TsCC:Destroy()
        DHMods.TsCC = nil
    end
    if not on then return end

    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "DH_TimeStop"
    cc.Saturation = -0.7
    cc.Contrast = 0.15
    cc.Parent = game:GetService("Lighting")
    DHMods.TsCC = cc

    -- hold everything every frame (after physics, right before the frame is drawn)
    DHMods.TsConn = RunService.Heartbeat:Connect(function()
        for r, cf in pairs(DHMods.TsHold) do
            if r.Parent then
                r.CFrame = cf
                r.AssemblyLinearVelocity = Vector3.zero
            else
                DHMods.TsHold[r] = nil
            end
        end
    end)

    task.spawn(function()
        local t0 = tick()
        while DHMods.TsTok == tok and tick() - t0 < 10 do
            pcall(DHMods.TsScan)
            task.wait(0.25)
        end
        if DHMods.TsTok == tok and DHMods.TsApi then
            DHMods.TsApi.Set(false)
        end
    end)
end

-- ---------- Reverse: records your movement, hold the button to rewind ----------
DHMods.RevFrames = {}
DHMods.RevHold = false

function DHMods.ReverseSet(on)
    if DHMods.RevConn then
        DHMods.RevConn:Disconnect()
        DHMods.RevConn = nil
    end
    DHMods.RevFrames = {}
    DHMods.RevHold = false
    if not on then return end

    DHMods.RevConn = RunService.Heartbeat:Connect(function()
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if not (hum and root) or hum.Health <= 0 then
            DHMods.RevFrames = {}
            return
        end
        if DHMods.RevChar ~= char then
            -- new character: start a new history
            DHMods.RevChar = char
            DHMods.RevFrames = {}
        end
        local fr = DHMods.RevFrames
        if DHMods.RevHold then
            for _ = 1, math.min(2, #fr) do
                local f = table.remove(fr)
                root.CFrame = f.cf
                root.AssemblyLinearVelocity = f.vel
            end
        else
            fr[#fr + 1] = {cf = root.CFrame, vel = root.AssemblyLinearVelocity, t = tick()}
            if #fr > 1200 then table.remove(fr, 1) end
        end
    end)
end

