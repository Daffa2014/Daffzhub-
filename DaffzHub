                    if o:IsA("TextButton") then o.BackgroundColor3 = Color3.fromRGB(45,45,45) end
                end
                b.BackgroundColor3 = Color3.fromRGB(40,100,180)
            end)
        end
    end
    DHFP.Filter()
end

function DHFP.Restore()
    if DHFP.Orig then
        for part, v in pairs(DHFP.Orig) do
            if part.Parent then part.CanCollide = v end
        end
    end
    DHFP.Orig = nil
    DHFP.Parts = nil
    DHFP.PartsChar = nil
end

function DHFP.SetBtn()
    if not DHFP.Btn then return end
    DHFP.Btn.Text = DHFP.Following and "Unfollow" or "Follow"
    DHFP.Btn.BackgroundColor3 = DHFP.Following and Color3.fromRGB(180,40,40) or Color3.fromRGB(40,170,80)
end

function DHFP.Step()
    local tp = DHFP.Target
    if not tp or not tp.Parent then
        DHFP.Set(false)
        DHFP.Hint("Target left the server")
        return
    end
    if DHMods and DHMods.WwActive then return end

    local tchar = tp.Character
    local troot = tchar and (tchar:FindFirstChild("HumanoidRootPart") or tchar.PrimaryPart)
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (troot and root) then return end

    -- our own parts must not collide with theirs
    if DHFP.PartsChar ~= char then
        DHFP.PartsChar = char
        DHFP.Parts = {}
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then DHFP.Parts[#DHFP.Parts + 1] = d end
        end
    end
    DHFP.Orig = DHFP.Orig or {}
    for _, p in ipairs(DHFP.Parts) do
        if p.Parent then
            if DHFP.Orig[p] == nil then DHFP.Orig[p] = p.CanCollide end
            p.CanCollide = false
        end
    end

    root.CFrame = troot.CFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

function DHFP.Set(on)
    if DHFP.Conn then
        DHFP.Conn:Disconnect()
        DHFP.Conn = nil
    end
    DHFP.Restore()
    DHFP.Following = on and true or false
    DHFP.SetBtn()
    if not on then return end

    local ok, ev = pcall(function() return RunService.PreSimulation end)
    if not (ok and ev) then ev = RunService.Stepped end
    DHFP.Conn = ev:Connect(function()
        pcall(DHFP.Step)
    end)
end

