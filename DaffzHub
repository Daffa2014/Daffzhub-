    -- Undo: remembers the rule of each touched button before it changes
    local UndoStack = {}
    local function CopyRule(r)
        if not r then return nil end
        return {Name = r.Name, IsDeleted = r.IsDeleted, Position = r.Position, Size = r.Size, SizeModified = r.SizeModified}
    end

    function PushUndo(list)
        local snap = {}
        for _, el in ipairs(list) do
            local key = GetKey(el)
            snap[#snap + 1] = {El = el, Key = key, Rule = CopyRule(RuleMap[key])}
        end
        if #snap > 0 then
            UndoStack[#UndoStack + 1] = snap
            if #UndoStack > 30 then table.remove(UndoStack, 1) end
        end
    end

    local function DoUndo()
        local snap = table.remove(UndoStack)
        if not snap then return end
        for _, s in ipairs(snap) do
            local el = s.El
            RuleMap[s.Key] = s.Rule
            if el and el.Parent then
                local o = OrigState[el]
                local r = s.Rule
                if r then
                    KnownTrackedObjects[el] = s.Key
                    el.Position = r.Position
                    if r.SizeModified then el.Size = r.Size elseif o then el.Size = o.Size end
                    el.Visible = not r.IsDeleted
                else
                    KnownTrackedObjects[el] = nil
                    if o then el.Position = o.Pos; el.Size = o.Size end
                    el.Visible = true
                    OrigState[el] = nil
                end
            end
        end
        ClearSelection()
        if UpdateTrashUI then UpdateTrashUI() end
    end
    UndoBtn.MouseButton1Click:Connect(DoUndo)
    
    -- Reset All: puts every touched button back to its original place (Undo can bring it back)
    local function DoResetAll()
        local list = {}
        for obj in pairs(KnownTrackedObjects) do
            if obj.Parent then list[#list + 1] = obj end
        end
        if #list == 0 and not next(RuleMap) then return end
        PushUndo(list)
        for _, obj in ipairs(list) do
            local k = KnownTrackedObjects[obj]
            local st = OrigState[obj]
            obj.Position = (k and OriginalPositions[k]) or (st and st.Pos) or obj.Position
            obj.Size = (k and OriginalSizes[k]) or (st and st.Size) or obj.Size
            obj.Visible = true
            OrigState[obj] = nil
        end
        for k in pairs(RuleMap) do RuleMap[k] = nil end
        for obj in pairs(KnownTrackedObjects) do KnownTrackedObjects[obj] = nil end
        ClearSelection()
        if UpdateTrashUI then UpdateTrashUI() end
    end
