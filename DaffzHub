            holder.Position = UDim2.new(1, -(total + 10), 0.5, -15)
            holder.BackgroundTransparency = 1

            local buttons = {}
            local current = default

            local function paint()
                for name, b in pairs(buttons) do
                    local sel = (name == current)
                    b.BackgroundColor3 = sel and Color3.fromRGB(30,180,30) or Color3.fromRGB(60,60,60)
                end
            end

            for i, name in ipairs(options) do
                local b = Instance.new("TextButton", holder)
                b.Size = UDim2.new(0, btnW, 1, 0)
                b.Position = UDim2.new(0, (i - 1) * (btnW + gap), 0, 0)
                b.Text = name
                b.Font = Enum.Font.GothamBold
                b.TextSize = 12
                b.TextColor3 = Color3.new(1,1,1)
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
                buttons[name] = b
                b.MouseButton1Click:Connect(function()
                    current = name
                    paint()
                    if callback then callback(name) end
                end)
            end
            paint()

            return {
                Set = function(name, silent)
                    current = name
                    paint()
                    if not silent and callback then callback(name) end
                end,
                Get = function() return current end,
            }
        end
    end

    ------------------------------------------------
    -- SETTINGS (edit here)
    ------------------------------------------------
    local cfg = {
        MaxHighlights = 31,                          -- Roblox draws about 31 Highlights at once; extra visible players get a small dot instead
        DefaultColor = Color3.fromRGB(255, 70, 70),  -- used when the game has no teams
        LineOrigin = "Bottom",                       -- "Bottom", "Center" or "Top"
        Interval = 0.25,                             -- how often players are re-checked (seconds)
        NpcColor = Color3.fromRGB(255, 170, 40),     -- NPCs and monsters
        NpcRange = 500,                              -- NPCs farther than this (studs) are ignored
        MaxNpc = 40,                                 -- at most this many NPCs are shown (nearest first)
    }

    local on = {player = false, line = false, tag = false, dist = false, npc = false,
        npcHL = false, npcLine = false, npcTag = false, npcDist = false}
    local style = "Filled"
    local npcStyle = "Filled"
    local state = {}          -- [Player] = {hl, tag, nameLabel, distLabel, line, root, hum}
    local conns = {}
    local token = 0
    local running = false
    local lineBound = false
    local tagFolder = nil
    local lineGui = nil

    local function ColorOf(plr)
        if typeof(plr) == "Instance" and not plr:IsA("Player") then return cfg.NpcColor end
        if DHExp and DHExp.Flagged and DHExp.Flagged[plr] then return Color3.fromRGB(255, 0, 255) end
        if plr.Team then return plr.TeamColor.Color end
        return cfg.DefaultColor
    end

    local function EnsureGuis()
        if not tagFolder or not tagFolder.Parent then
            tagFolder = Instance.new("Folder")
            tagFolder.Name = "DH_ESP_Tags"
            tagFolder.Parent = ScreenGui.Parent
        end
        if not lineGui or not lineGui.Parent then
            lineGui = Instance.new("ScreenGui")
            lineGui.Name = "DH_ESP_Lines"
            lineGui.ResetOnSpawn = false
            lineGui.IgnoreGuiInset = true
            lineGui.DisplayOrder = -1 -- below the hub and below the Black Screen cover
            lineGui.Parent = ScreenGui.Parent
        end
    end

    local function DropPlayer(plr)
        local st = state[plr]
        if not st then return end
        if st.hl then st.hl:Destroy() end
        if st.tag then st.tag:Destroy() end
        if st.line then st.line:Destroy() end
                if st.dot then st.dot:Destroy() end
        state[plr] = nil
    end

    local function DropAll()
        for plr in pairs(state) do
            DropPlayer(plr)
        end
    end

    ------------------------------------------------
    -- ONE ADORNMENT PER FEATURE
    ------------------------------------------------
    local function ApplyHighlight(st, char, color)
        local target = (DHMods and DHMods.HitTarget and DHMods.HitTarget(char)) or char
        local hl = st.hl
        if not hl or hl.Parent ~= char then
            if hl then hl:Destroy() end
            hl = Instance.new("Highlight")
            hl.Name = "DH_ESP_HL"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = char
            hl.Parent = char
            st.hl = hl
        end
        hl.Enabled = true
        hl.Adornee = target
        hl.FillColor = color
        hl.OutlineColor = color
        hl.OutlineTransparency = 0
        -- players use the Player style, NPCs use the NPC style
        local useStyle = Players:GetPlayerFromCharacter(char) and style or npcStyle
        hl.FillTransparency = (useStyle == "Filled") and 0.5 or 1
    end

    local function HideHighlight(st)
        if st.hl then st.hl.Enabled = false end
    end

    local function DropDot(st)
        if st.dot then
            st.dot:Destroy()
            st.dot = nil
            st.dotFrame = nil
        end
    end

    -- cheap marker for players beyond the highlight limit (one tiny GUI instead of a Highlight)
    local function ApplyDot(st, char, color)
        local adornee = char:FindFirstChild("Head") or st.root
        if not adornee then return end
        local d = st.dot
        if not d or not d.Parent then
            d = Instance.new("BillboardGui")
            d.Name = "DH_ESP_Dot"
            d.AlwaysOnTop = true
            d.Size = UDim2.new(0, 10, 0, 10)
            d.LightInfluence = 0
            d.ResetOnSpawn = false
            local f = Instance.new("Frame", d)
            f.Size = UDim2.new(1, 0, 1, 0)
            f.BorderSizePixel = 0
            Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
            d.Parent = tagFolder
            st.dot = d
            st.dotFrame = f
        end
        d.Adornee = adornee
        st.dotFrame.BackgroundColor3 = color
    end

    local function ApplyTag(st, plr, char, color, distance, showDist)
        local adornee = char:FindFirstChild("Head") or st.root
        if not adornee then return end

        local tag = st.tag
        if not tag or not tag.Parent then
            tag = Instance.new("BillboardGui")
            tag.Name = "DH_ESP_Tag"
            tag.AlwaysOnTop = true
            tag.Size = UDim2.new(0, 140, 0, 36)
            tag.StudsOffset = Vector3.new(0, 2.6, 0)
            tag.LightInfluence = 0
            tag.ResetOnSpawn = false

            local nameLabel = Instance.new("TextLabel", tag)
            nameLabel.Size = UDim2.new(1, 0, 0, 18)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 14
            nameLabel.TextStrokeTransparency = 0.3

            local distLabel = Instance.new("TextLabel", tag)
            distLabel.Size = UDim2.new(1, 0, 0, 14)
            distLabel.Position = UDim2.new(0, 0, 0, 18)
            distLabel.BackgroundTransparency = 1
            distLabel.Font = Enum.Font.Gotham
            distLabel.TextSize = 12
            distLabel.TextColor3 = Color3.new(1, 1, 1)
            distLabel.TextStrokeTransparency = 0.3

            tag.Parent = tagFolder
            st.tag = tag
            st.nameLabel = nameLabel
            st.distLabel = distLabel
        end

        tag.Adornee = adornee
        st.nameLabel.Text = (typeof(plr) == "Instance" and plr:IsA("Player")) and plr.DisplayName or plr.Name
        st.nameLabel.TextColor3 = color
        st.distLabel.Visible = showDist == true
        if showDist then
            st.distLabel.Text = string.format("%dm", math.floor(distance + 0.5))
        end
    end

    local function ApplyLine(st, color)
        if not st.line or not st.line.Parent then
            local f = Instance.new("Frame")
            f.Name = "L"
            f.AnchorPoint = Vector2.new(0.5, 0.5)
            f.BorderSizePixel = 0
            f.BackgroundTransparency = 0.15
            f.Size = UDim2.new(0, 0, 0, 2)
            f.Visible = false
            f.Parent = lineGui
            st.line = f
        end
        st.line.BackgroundColor3 = color
    end

    ------------------------------------------------
    -- NPC LIST: found once, then kept up to date by events (no scanning every tick)
    ------------------------------------------------
    local npcs = {}
    local npcConns = {}
    local npcToken = 0

    local function NpcAdd(hum)
        local m = hum.Parent
        if not (m and m:IsA("Model")) then return end
        if Players:GetPlayerFromCharacter(m) then return end
        if m == Player.Character then return end
        npcs[m] = true
    end

    local function NpcSync()
        for _, c in ipairs(npcConns) do pcall(function() c:Disconnect() end) end
        npcConns = {}
        npcs = {}
        npcToken = npcToken + 1
        local myToken = npcToken
        if not on.npc then return end
        npcConns[#npcConns + 1] = workspace.DescendantAdded:Connect(function(o)
            if o:IsA("Humanoid") then task.defer(NpcAdd, o) end
        end)
        task.spawn(function()
            local n = 0
            for _, o in ipairs(workspace:GetDescendants()) do
                if npcToken ~= myToken or not on.npc then return end
                if o:IsA("Humanoid") then NpcAdd(o) end
                n = n + 1
                if n % 2000 == 0 then task.wait() end
            end
        end)
    end

    ------------------------------------------------
    -- RECONCILE: makes reality match the toggles. Runs every few moments and after join/respawn events,
    -- so new players, leavers, respawns, deaths and streaming all fix themselves.
    ------------------------------------------------
    local function Reconcile()
        if not (on.player or on.line or on.tag or on.npc) then return end
        EnsureGuis()

        local cam = workspace.CurrentCamera
        local me = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        local from = (me and me.Position) or (cam and cam.CFrame.Position) or Vector3.new(0, 0, 0)

        local list = {}
        local present = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player then
                present[plr] = true
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if char and hum and root and root.Parent and hum.Health > 0 then
                    local inView = false
                    if cam then
                        local sp = cam:WorldToViewportPoint(root.Position)
                        local vs = cam.ViewportSize
                        inView = sp.Z > 0 and sp.X > -150 and sp.X < vs.X + 150 and sp.Y > -150 and sp.Y < vs.Y + 150
                    end
                    list[#list + 1] = {plr = plr, char = char, hum = hum, root = root, dist = (root.Position - from).Magnitude, inView = inView}
                else
                    DropPlayer(plr) -- dead, respawning, or not streamed in yet
                end
            end
        end
        -- NPCs and monsters: any Humanoid model that is not a player (nearest ones first, capped)
        if on.npc then
            local npcList = {}
            for m in pairs(npcs) do
                local nh = m.Parent and m:FindFirstChildOfClass("Humanoid")
                local nr = nh and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart"))
                if nh and nr and nr.Parent and nh.Health > 0 then
                    local nd = (nr.Position - from).Magnitude
                    if nd <= cfg.NpcRange then
                        local nView = false
                        if cam then
                            local sp = cam:WorldToViewportPoint(nr.Position)
                            local vs = cam.ViewportSize
                            nView = sp.Z > 0 and sp.X > -150 and sp.X < vs.X + 150 and sp.Y > -150 and sp.Y < vs.Y + 150
                        end
                        npcList[#npcList + 1] = {plr = m, char = m, hum = nh, root = nr, dist = nd, inView = nView}
                    end
                elseif not m.Parent then
                    npcs[m] = nil
                end
            end
            table.sort(npcList, function(a, b) return a.dist < b.dist end)
            for i = 1, math.min(#npcList, cfg.MaxNpc) do
                list[#list + 1] = npcList[i]
                present[npcList[i].plr] = true
            end
        end
        for plr in pairs(state) do
            if not present[plr] then DropPlayer(plr) end -- left the game
        end

        table.sort(list, function(a, b) return a.dist < b.dist end)

        local slots = 0
        for i, e in ipairs(list) do
            local st = state[e.plr]
            if not st then
                st = {}
                state[e.plr] = st
            end
            st.root = e.root
            st.hum = e.hum
            local color = ColorOf(e.plr)

            -- players use the Player switches, NPCs use their own NPC switches
            local wHL, wTag, wLine, wDist
            if typeof(e.plr) == "Instance" and not e.plr:IsA("Player") then
                wHL, wTag, wLine, wDist = on.npcHL, on.npcTag, on.npcLine, on.npcDist
            else
                wHL, wTag, wLine, wDist = on.player, on.tag, on.line, on.dist
            end

            if wHL then
                if e.inView then
                    slots = slots + 1
                    if slots <= cfg.MaxHighlights then
                        ApplyHighlight(st, e.char, color)
                        DropDot(st)
                    else
                        HideHighlight(st)
                        ApplyDot(st, e.char, color)
                    end
                else
                    HideHighlight(st)
                    DropDot(st)
                end
            else
                if st.hl then
                    st.hl:Destroy()
                    st.hl = nil
                end
                DropDot(st)
            end

            if wTag then
                ApplyTag(st, e.plr, e.char, color, e.dist, wDist)
            elseif st.tag then
                st.tag:Destroy()
                st.tag = nil
                st.nameLabel = nil
                st.distLabel = nil
            end

            if wLine then
                ApplyLine(st, color)
            elseif st.line then
                st.line:Destroy()
                st.line = nil
            end
        end
    end

    ------------------------------------------------
    -- LINES: updated every frame, after the camera has moved
    ------------------------------------------------
    local function RenderLines()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local center = vp / 2
        local origin
        if cfg.LineOrigin == "Center" then
            origin = center
        elseif cfg.LineOrigin == "Top" then
            origin = Vector2.new(vp.X / 2, 0)
        else
            origin = Vector2.new(vp.X / 2, vp.Y)
        end

        for _, st in pairs(state) do
            local line = st.line
            if line then
                local root, hum = st.root, st.hum
                if root and root.Parent and hum and hum.Health > 0 then
                                        local p, onScreen = cam:WorldToViewportPoint(root.Position)
                    local v = Vector2.new(p.X, p.Y)
                    if not onScreen then
                        v = origin -- not inside the camera view: no line (not a 360 degree ESP)
                    end
                    v = Vector2.new(math.clamp(v.X, 0, vp.X), math.clamp(v.Y, 0, vp.Y))
                    local d = v - origin
                    local len = d.Magnitude
                    if len < 1 then
                        line.Visible = false
                    else
                        line.Size = UDim2.new(0, len, 0, 2)
                        line.Position = UDim2.new(0, (origin.X + v.X) / 2, 0, (origin.Y + v.Y) / 2)
                        line.Rotation = math.deg(math.atan2(d.Y, d.X))
                        line.Visible = true
                    end
                else
                    line.Visible = false
                end
            end
        end
    end

    local function RenderLinesSafe()
        pcall(RenderLines)
    end

    local function SyncLineLoop()
        if (on.line or on.npcLine) and not lineBound then
            lineBound = true
            RunService:BindToRenderStep("DH_ESP_Lines", Enum.RenderPriority.Camera.Value + 1, RenderLinesSafe)
        elseif not (on.line or on.npcLine) and lineBound then
            lineBound = false
            pcall(function() RunService:UnbindFromRenderStep("DH_ESP_Lines") end)
        end
    end

    ------------------------------------------------
    -- START / STOP
    ------------------------------------------------
    local function Kick()
        task.defer(function()
            pcall(Reconcile)
        end)
    end

    local function HookPlayer(plr)
        if plr == Player then return end
        table.insert(conns, plr.CharacterAdded:Connect(Kick))
        table.insert(conns, plr.CharacterRemoving:Connect(function()
            DropPlayer(plr)
        end))
    end

    local function Start()
        if running then return end
        running = true
        token = token + 1
        local myToken = token

        for _, plr in ipairs(Players:GetPlayers()) do
            HookPlayer(plr)
        end
        table.insert(conns, Players.PlayerAdded:Connect(function(plr)
            HookPlayer(plr)
            Kick()
        end))
        table.insert(conns, Players.PlayerRemoving:Connect(function(plr)
            DropPlayer(plr)
        end))

        task.spawn(function()
            while running and token == myToken do
                pcall(Reconcile)
                task.wait(cfg.Interval)
            end
        end)
    end

    local function Stop()
        running = false
        token = token + 1
        for _, c in ipairs(conns) do c:Disconnect() end
        conns = {}
        DropAll()
    end

    local function Refresh()
        SyncLineLoop()
        if on.player or on.line or on.tag or on.npc then
            Start()
            Kick()
        else
            Stop()
        end
    end

    -- give everything back when the hub is closed
    DHVisual.OnCleanup(function()
        on.player, on.line, on.tag, on.npc = false, false, false, false
        on.npcHL, on.npcLine, on.npcTag, on.npcDist = false, false, false, false
        NpcSync()
        SyncLineLoop()
