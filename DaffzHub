    end

------------------------------------------------
    -- 1. LOW GRAPHICS (v3: also affects parts that appear later - spawned, or streamed in by the camera)
    -- Original values live as attributes on the objects themselves, so turning it OFF always restores them.
    ------------------------------------------------
    local lowOn = false
    local lowToken = 0
    local lowConns = {}
    local lowQueue, lowQi = {}, 1
    local lowSA = {}
    local lowSaved = {lighting = {}, quality = nil, terrain = {}}
    local LOW_PER_FRAME = 600 -- how many objects are processed per frame (lower = smoother, but slower)

    local function LowRelevant(o)
        return o:IsA("BasePart") or o:IsA("Decal") or o:IsA("Texture") or o:IsA("SurfaceAppearance")
            or o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Fire")
            or o:IsA("Smoke") or o:IsA("Sparkles") or o:IsA("PostEffect")
    end

    local function LowApply(o)
        if o:IsA("BasePart") then
            if o:IsA("Terrain") then return end
            if o:GetAttribute("DH_Mat") == nil then
                o:SetAttribute("DH_Mat", o.Material.Value)
                o:SetAttribute("DH_CS", o.CastShadow and 1 or 0)
                o.Material = Enum.Material.SmoothPlastic
                o.CastShadow = false
                if o:IsA("MeshPart") then
                    o:SetAttribute("DH_RF", o.RenderFidelity.Value)
                    o.RenderFidelity = Enum.RenderFidelity.Performance
                end
            end
        elseif o:IsA("Decal") or o:IsA("Texture") then
            if o:GetAttribute("DH_Tr") == nil then
                o:SetAttribute("DH_Tr", o.Transparency)
                o.Transparency = 1
            end
        elseif o:IsA("SurfaceAppearance") then
            lowSA[#lowSA + 1] = {o, o.Parent}
            o.Parent = nil
        else
            if o:GetAttribute("DH_En") == nil then
                o:SetAttribute("DH_En", o.Enabled and 1 or 0)
                o.Enabled = false
            end
        end
    end

    local function LowRestore(o)
        local m = o:GetAttribute("DH_Mat")
        if m ~= nil then
            pcall(function()
                o.Material = Enum.Material:FromValue(m)
                o.CastShadow = (o:GetAttribute("DH_CS") == 1)
                local rf = o:GetAttribute("DH_RF")
                if rf ~= nil then
                    o.RenderFidelity = Enum.RenderFidelity:FromValue(rf)
                end
            end)
            o:SetAttribute("DH_Mat", nil)
            o:SetAttribute("DH_CS", nil)
            o:SetAttribute("DH_RF", nil)
            return
        end
        local t = o:GetAttribute("DH_Tr")
        if t ~= nil then
            o.Transparency = t
            o:SetAttribute("DH_Tr", nil)
            return
        end
        local e = o:GetAttribute("DH_En")
        if e ~= nil then
            o.Enabled = (e == 1)
            o:SetAttribute("DH_En", nil)
        end
    end

    -- processes the queue a little every frame, so a burst of new parts never freezes the phone
    local function LowPump()
        local n = 0
        local total = #lowQueue
        while lowQi <= total and n < LOW_PER_FRAME do
            local o = lowQueue[lowQi]
            lowQueue[lowQi] = false
            lowQi = lowQi + 1
            if o and o.Parent then pcall(LowApply, o) end
            n = n + 1
        end
        if lowQi > total then
            lowQueue = {}
            lowQi = 1
        end
    end

    local function SetLowGraphics(on)
        lowOn = on
        lowToken = lowToken + 1
        local myToken = lowToken
        for _, c in ipairs(lowConns) do c:Disconnect() end
        lowConns = {}
        lowQueue, lowQi = {}, 1

        if on then
            lowSaved = {lighting = {}, quality = nil, terrain = {}}
            lowSaved.lighting = {
                GlobalShadows = Lighting.GlobalShadows,
                EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
                EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
            }
            pcall(function() lowSaved.quality = settings().Rendering.QualityLevel end)
            pcall(function() Lighting.GlobalShadows = false end)
            pcall(function() Lighting.EnvironmentDiffuseScale = 0 end)
            pcall(function() Lighting.EnvironmentSpecularScale = 0 end)
            pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

            local terrain = workspace:FindFirstChildOfClass("Terrain")
            if terrain then
                for _, p in ipairs({"WaterWaveSize", "WaterWaveSpeed", "WaterReflectance"}) do
                    lowSaved.terrain[p] = terrain[p]
                    pcall(function() terrain[p] = 0 end)
                end
            end

            local function push(o)
                if lowOn and LowRelevant(o) then
                    lowQueue[#lowQueue + 1] = o
                end
            end

            -- anything that appears later (spawned parts, or parts streamed in when the camera gets near)
            table.insert(lowConns, workspace.DescendantAdded:Connect(push))
            table.insert(lowConns, Lighting.DescendantAdded:Connect(push))
            table.insert(lowConns, RunService.Heartbeat:Connect(LowPump))

            -- everything that already exists
            for _, o in ipairs(Lighting:GetDescendants()) do push(o) end
            task.spawn(function()
                local all = workspace:GetDescendants()
                for i = 1, #all do
                    if not lowOn or lowToken ~= myToken then return end
                    push(all[i])
                    if i % 4000 == 0 then task.wait() end
                end
            end)
        else
            for k, v in pairs(lowSaved.lighting) do
                pcall(function() Lighting[k] = v end)
            end
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            if terrain then
                for p, v in pairs(lowSaved.terrain) do
                    pcall(function() terrain[p] = v end)
                end
            end
            pcall(function()
                settings().Rendering.QualityLevel = lowSaved.quality or Enum.QualityLevel.Automatic
            end)
            for _, rec in ipairs(lowSA) do
                local sa, parent = rec[1], rec[2]
                if sa and parent and parent.Parent then
                    pcall(function() sa.Parent = parent end)
                end
            end
            lowSA = {}

            task.spawn(function()
                local all = workspace:GetDescendants()
                for i = 1, #all do
                    if lowToken ~= myToken then return end
                    if LowRelevant(all[i]) then pcall(LowRestore, all[i]) end
                    if i % 1500 == 0 then task.wait() end
                end
                for _, o in ipairs(Lighting:GetDescendants()) do
                    if LowRelevant(o) then pcall(LowRestore, o) end
                end
            end)
        end
    end

    ------------------------------------------------
    -- 2. NO AUDIO (mutes every Sound except the hub's own music)
    -- The original volume is stored as an attribute on the Sound itself.
    -- If a game script raises the volume again, it is muted again (and the new value is remembered).
    ------------------------------------------------
    local muteOn = false
    local muteConn = nil
    local muteWatch = setmetatable({}, {__mode = "k"})

    local function MuteSound(s)
        if not s:IsA("Sound") then return end
        if s:GetAttribute("DH_Music") == true or s:IsDescendantOf(ScreenGui) then return end
        if s:GetAttribute("DH_Vol") == nil then
            s:SetAttribute("DH_Vol", s.Volume)
            s.Volume = 0
            muteWatch[s] = s:GetPropertyChangedSignal("Volume"):Connect(function()
                if muteOn and s.Volume ~= 0 then
                    s:SetAttribute("DH_Vol", s.Volume)
                    s.Volume = 0
                end
            end)
        end
    end

    local function SetNoAudio(on)
        muteOn = on
        if muteConn then
            muteConn:Disconnect()
            muteConn = nil
        end
        if on then
            for _, s in ipairs(game:GetDescendants()) do
                MuteSound(s)
            end
            muteConn = game.DescendantAdded:Connect(MuteSound)
        else
            for s, c in pairs(muteWatch) do
                c:Disconnect()
                muteWatch[s] = nil
            end
            for _, s in ipairs(game:GetDescendants()) do
                if s:IsA("Sound") then
                    local v = s:GetAttribute("DH_Vol")
                    if v ~= nil then
                        s.Volume = v
                        s:SetAttribute("DH_Vol", nil)
                    end
                end
            end
        end
    end

    ------------------------------------------------
    -- 3 + 4. FPS COUNTER and PING DISPLAY (one shared label)
    ------------------------------------------------
    local statLabel = Instance.new("TextLabel", ScreenGui)
    statLabel.Name = "DH_StatLabel"
    statLabel.AnchorPoint = Vector2.new(0.5, 0)
    statLabel.Position = UDim2.new(0.5, 0, 0, 6)
    statLabel.Size = UDim2.new(0, 170, 0, 22)
    statLabel.BackgroundColor3 = Color3.fromRGB(25,25,25)
    statLabel.BackgroundTransparency = 0.3
    statLabel.Font = Enum.Font.GothamBold
    statLabel.TextSize = 12
    statLabel.TextColor3 = Color3.new(1,1,1)
    statLabel.Text = ""
    statLabel.Visible = false
    Instance.new("UICorner", statLabel).CornerRadius = UDim.new(0, 8)

    statLabel.RichText = true
    statLabel.Size = UDim2.new(0, 200, 0, 22)

    local showFps, showPing = false, false

    local function RenderStats(m)
        local parts = {}
        if showFps then
            parts[#parts + 1] = '<font color="#' .. DHFpsColor(m.fps):ToHex() .. '">FPS: ' .. m.fps .. '</font>'
        end
        if showPing then
            parts[#parts + 1] = '<font color="#' .. DHPingColor(m.ping):ToHex() .. '">Ping: ' .. m.ping .. ' ms</font>'
        end
        statLabel.Text = table.concat(parts, "  |  ")
    end

    -- same numbers as the Info Tab (one shared source: DHMetrics)
    table.insert(DHMetrics.listeners, function(m)
        if statLabel.Visible then RenderStats(m) end
    end)

    local function RefreshStats()
